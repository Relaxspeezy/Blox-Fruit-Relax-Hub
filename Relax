function Diag.Run()
    local function chk(label, ok, extra)
        Log((ok and "✔ " or "✖ ") .. label .. (extra ~= nil and (" : " .. tostring(extra)) or ""), ok and "INFO" or "WARN")
    end
    local wo = Workspace:FindFirstChild("_WorldOrigin")
    local enemies = Workspace:FindFirstChild("Enemies")
    local npcs = Workspace:FindFirstChild("NPCs")
    local locs = wo and wo:FindFirstChild("Locations")
    local spawns = wo and wo:FindFirstChild("EnemySpawns")
    chk("PlaceId / Sea", PLACE_TO_SEA[game.PlaceId] ~= nil, game.PlaceId .. " / Sea " .. State.Sea .. " (via " .. tostring(State.SeaSource) .. ")")
    chk("Level", pcall(function() return LocalPlayer.Data.Level.Value end), Farm.Level())
    chk("Workspace.Enemies", enemies ~= nil, enemies and #enemies:GetChildren() or nil)
    chk("EnemySpawns", spawns ~= nil, spawns and #spawns:GetChildren() or nil)
    chk("Locations", locs ~= nil, locs and #locs:GetChildren() or nil)
    chk("NPCs", npcs ~= nil, npcs and #npcs:GetChildren() or nil)
    chk("CommF_ remote", Utils.CommF() ~= nil)
    chk("Quests module", Quest.Module() ~= nil)
    chk("isnetworkowner", isnetworkowner ~= nil)
    local okStream, hasStream = pcall(function() return LocalPlayer.RequestStreamAroundAsync ~= nil end)
    chk("RequestStreamAroundAsync", okStream and hasStream == true)
    local cands = Quest.Candidates()
    chk("Parsed quest count", #cands > 0, #cands)
    local pick = Quest.Pick()
    chk("Picked quest", pick ~= nil, pick and (pick.name .. " #" .. pick.idx .. " -> " .. pick.mob) or nil)
    if pick then
        chk("Known NPC position", Quest.HintFor(pick) ~= nil)
        chk("Mob spawn loaded", Quest.SpawnExists(pick.mob))
        local nc = Quest.NpcCandidates(pick)
        chk("Quest NPC candidates", #nc > 0, #nc)
        for i = 1, math.min(4, #nc) do
            Log(string.format("   NPC candidate %d: %s (%d studs)", i, nc[i].name, math.floor(nc[i].d)))
        end
    end
    local nq = 0
    for _ in pairs(State.QuestNPCs) do nq = nq + 1 end
    chk("Saved quest NPC count", true, nq)
    chk("Quest UI (Main.Quest)", Quest.Panel() ~= nil, Quest.GuiActive())
    chk("Quest title", Quest.GuiText() ~= nil, Quest.GuiText())
    chk("Quest panel read", Quest.EverRead, "relaxed=" .. tostring(Quest.Relaxed) .. " blind=" .. tostring(Quest.Blind))
    chk("Quest panel trusted", Quest.PanelTrusted(), "stalls=" .. Quest.StallCount)
    local chestN = 0
    for _ in pairs(Registry.Chests) do chestN = chestN + 1 end
    chk("Recognized chests", true, chestN)
    chk("Attack: Net remote", Combat.FindNet() ~= nil)
    chk("Attack: CombatFramework", Combat.Framework() ~= nil)
    chk("Active attack mode", true, Combat.Mode())
    chk("sethiddenproperty", sethiddenproperty ~= nil)
    chk("firetouchinterest", firetouchinterest ~= nil)
    chk("writefile (config)", writefile ~= nil)
    Utils.Notify("Diagnostics done: see the log in System", 4, "success")
end


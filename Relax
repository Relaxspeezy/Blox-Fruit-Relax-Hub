-- Damage tracking: last damage time (dmgAt) per mob
function Combat.Track(targets)
    local now = os.clock()
    local seen = {}
    for _, t in ipairs(targets) do
        seen[t.model] = true
        local rec = Combat.HP[t.model]
        local cur = t.hum.Health
        if not rec then
            Combat.HP[t.model] = {hp = cur, hum = t.hum, since = now, dmgAt = 0}
        else
            if cur < rec.hp - 0.01 then
                rec.dmgAt = now
                Combat.LastDamage = now
            end
            rec.hp = cur
        end
    end
    for model, rec in pairs(Combat.HP) do
        if not seen[model] then
            if not model.Parent or not rec.hum.Parent or rec.hum.Health <= 0 then
                Combat.LastDamage = now
            end
            Combat.HP[model] = nil
        end
    end
end


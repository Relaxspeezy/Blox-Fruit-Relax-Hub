end

function Combat.Attack(targets)
    local mode = State.AttackMode
    local cfg = speedCfg()
    local fast = false
    if State.FastAttack and #targets > 0 then
        if mode == "All" or mode == "Net" then
            for b = 1, cfg.burst do
                if Combat.NetAttack(targets, b == 1) then fast = true end
            end
        end
        if mode == "All" or mode == "CF" then
            if Combat.FrameworkAttack() then fast = true end
        end
    end
    local needClick = mode == "Click" or not State.FastAttack or not fast or Combat.IsClose()
        or os.clock() - lastClick > cfg.click
    if needClick then
        lastClick = os.clock()
        Combat.Click()
    end
end

function Combat.Loop()
    task.spawn(function()
        while State.Running do
            if State.InCombat and not State.Traveling and not Paused() and not Combat.Testing
                and (State.AutoFarm or State.AutoBoss or Raid.Active or Utils.EventBusy()) then
                pcall(function()
                    Combat.Equip(Utils.EventBusy())
                    local boss = (State.AutoBoss and not State.AutoFarm and not Raid.Active) or Utils.EventBusy()
                    local want = State.TargetMob
                    if want == "-" or want == "" or (State.HitAll and not boss) then want = nil end
                    local targets = Farm.Nearby(State.AttackRange, want, boss)
                    Combat.Track(targets)
                    -- Remember which mobs WE are hitting: only their deaths count as our kills
                    local hitNow = os.clock()
                    for _, t in ipairs(targets) do Farm.HitAt[t.model] = hitNow end
                    Combat.Adapt(#targets)
                    Combat.Attack(targets)
                end)
                local d = speedCfg().delay
                if d <= 0.02 then
                    RunService.Heartbeat:Wait()
                else
                    task.wait(Utils.RandomDelay(d, 0.008))
                end
            else
                Combat.LastDamage = os.clock()
                for k in pairs(Combat.HP) do Combat.HP[k] = nil end
                task.wait(0.15)
            end
        end
    end)
end

-- Tries each method for 3 s and picks the one that deals damage
function Combat.Test()
    if Combat.Testing then return end
    Combat.Testing = true
    task.spawn(function()
        local ok, err = pcall(function()
            Combat.Equip()
            task.wait(0.4)
            local list = Farm.Nearby(80)
            if #list == 0 then
                Utils.Notify("Test needs a mob within 80 studs", 4, "warn")
                return
            end
            local function total()
                local s = 0
                for _, t in ipairs(list) do
                    if t.model.Parent and t.hum.Parent then s = s + math.max(0, t.hum.Health) end
                end
                return s
            end
            local methods = {
                {"Net", function(tg) return Combat.NetAttack(tg) end, Combat.FindNet() ~= nil},
                {"CF", function() return Combat.FrameworkAttack() end, Combat.Framework() ~= nil},
                {"Click", function() Combat.Click() return true end, true},
            }
            local best, bestD = nil, 0
            for _, m in ipairs(methods) do
                if not State.Running then break end
                if not m[3] then
                    Log("Test " .. m[1] .. ": method not found", "WARN")
                else
                    local before = total()
                    local t0 = os.clock()
                    while os.clock() - t0 < 3 do
                        pcall(m[2], Farm.Nearby(State.AttackRange))
                        task.wait(0.1)
                    end
                    local dmg = before - total()
                    Log(string.format("Test %s: %d damage", m[1], math.floor(dmg)), dmg > 0 and "INFO" or "WARN")
                    if dmg > bestD then best, bestD = m[1], dmg end
                end
            end
            if best then
                State.AttackMode = best
                Combat.CloseUntil = 0
                Utils.Notify("Best method: " .. best .. " (selected)", 5, "success")
            else
                Utils.Notify("No method dealt damage. Stand next to a mob with a weapon equipped", 5, "danger")
            end
        end)
        if not ok then Log("Test error: " .. tostring(err), "WARN") end
        Combat.Testing = false
        if UI.RefreshAll then pcall(UI.RefreshAll) end
    end)
end


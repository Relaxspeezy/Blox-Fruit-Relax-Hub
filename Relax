-- ============================================================
local AntiCheat = {}
local KICK_KW = {"kick", "banned", "detected", "cheat", "exploit", "suspicious"}
local RATE_KW = {"too fast", "flood", "spam", "rate limit"}
local lastSignal = 0

function AntiCheat.Init()
    if LogService then
        table.insert(State.Connections, LogService.MessageOut:Connect(function(msg)
            if not State.SignalMonitor or os.clock() - lastSignal < 30 then return end
            local low = msg:lower()
            for _, kw in ipairs(KICK_KW) do
                if low:find(kw, 1, true) then
                    lastSignal = os.clock()
                    Log("DETECTION SIGNAL: " .. msg, "WARN")
                    State.HumanizeLevel = 3
                    Pause(Utils.RandomDelay(10, 3))
                    return
                end
            end
            for _, kw in ipairs(RATE_KW) do
                if low:find(kw, 1, true) then
                    lastSignal = os.clock()
                    Log("RATE LIMIT SIGNAL", "WARN")
                    State.RateLimit = true
                    task.delay(Utils.RandomDelay(10, 3), function() State.RateLimit = false end)
                    return
                end
            end
        end))
    end
    local GuiService = getService("GuiService")
    if GuiService then
        pcall(function()
            table.insert(State.Connections, GuiService.ErrorMessageChanged:Connect(function(msg)
                if not State.AutoRejoin or not msg or msg == "" then return end
                Log("Connection error, rejoining: " .. tostring(msg), "WARN")
                ConfigManager.Save(true)
                task.wait(4)
                pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)
            end))
        end)
    end
    table.insert(State.Connections, LocalPlayer.Idled:Connect(function()
        if not VirtualUser then return end
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new(0, 0))
        end)
    end))
end


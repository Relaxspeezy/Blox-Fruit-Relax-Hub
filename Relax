    Off     = Color3.fromRGB(58, 60, 84),
    Border  = Color3.fromRGB(46, 48, 74),
}
local WHITE = Color3.new(1, 1, 1)

local function mk(class, props, parent)
    local o = Instance.new(class)
    if props then
        for k, v in pairs(props) do o[k] = v end
    end
    if parent then o.Parent = parent end
    return o
end

local function corner(p, r) return mk("UICorner", {CornerRadius = UDim.new(0, r or 8)}, p) end
local function stroke(p, color, th, tr)
    return mk("UIStroke", {Color = color or T.Border, Thickness = th or 1, Transparency = tr or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, p)
end
local function gradient(p, c1, c2, rot)
    return mk("UIGradient", {Color = ColorSequence.new(c1, c2), Rotation = rot or 0}, p)
end

local function tween(o, t, props)
    local ok = pcall(function()
        TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
    end)
    if not ok then
        for k, v in pairs(props) do pcall(function() o[k] = v end) end
    end
end

local function isPointer(i)
    return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

local function viewport()
    if UI.Gui and UI.Gui.AbsoluteSize.X > 0 then return UI.Gui.AbsoluteSize end
    local cam = Workspace.CurrentCamera
    return cam and cam.ViewportSize or Vector2.new(800, 450)
end

-- Dragging: stays on screen, touch + mouse
local function makeDraggable(handle, target, clampFn)
    local dragging, track, startPointer, startPos = false, nil, nil, nil
    local moved = false
    handle.InputBegan:Connect(function(i)
        if isPointer(i) and not dragging then
            dragging, moved, track = true, false, i
            startPointer = Vector2.new(i.Position.X, i.Position.Y)
            startPos = target.AbsolutePosition
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    UI.DragActive = false
                end
            end)
        end
    end)
    table.insert(State.Connections, UserInputService.InputChanged:Connect(function(i)
        if not dragging or not track then return end
        local isTrack = (i == track)
            or (track.UserInputType == Enum.UserInputType.MouseButton1 and i.UserInputType == Enum.UserInputType.MouseMovement)
        if not isTrack then return end
        local d = Vector2.new(i.Position.X, i.Position.Y) - startPointer
        if d.Magnitude > 6 then moved = true end
        if moved then
            UI.DragActive = true
            local nx, ny = startPos.X + d.X, startPos.Y + d.Y
            if clampFn then nx, ny = clampFn(nx, ny) end
            target.Position = UDim2.fromOffset(nx, ny)
        end
    end))
    table.insert(State.Connections, UserInputService.InputEnded:Connect(function(i)
        if dragging and (i == track or isPointer(i)) then
            dragging = false
            UI.DragActive = false
        end
    end))
    return function() return moved end
end

function UI.ClampMain()
    local mf = UI.Main
    if not mf or UI.DragActive then return end
    local vp = viewport()
    local sz = mf.AbsoluteSize
    local pos = mf.AbsolutePosition
    local nx = math.clamp(pos.X, 48 - sz.X, vp.X - 48)
    local ny = math.clamp(pos.Y, 0, math.max(0, vp.Y - UI.HEADER))
    if math.abs(nx - pos.X) > 0.5 or math.abs(ny - pos.Y) > 0.5 then
        mf.Position = UDim2.fromOffset(nx, ny)
    end
end

function UI.CenterMain()
    local mf = UI.Main
    if not mf then return end
    local vp = viewport()
    mf.Position = UDim2.fromOffset(math.max(0, (vp.X - mf.AbsoluteSize.X) / 2), math.max(0, (vp.Y - mf.AbsoluteSize.Y) / 2))
end

function UI.SetMinimized(v)
    UI.Minimized = v and true or false
    local show = not UI.Minimized
    for _, o in ipairs({UI.Sidebar, UI.Divider, UI.Content, UI.Foot, UI.HdFill, UI.HdLine}) do
        if o then o.Visible = show end
    end
    if UI.Main then
        UI.Main.Size = UDim2.fromOffset(UI.W or UI.Main.AbsoluteSize.X, UI.Minimized and UI.HEADER or (UI.H or 300))
    end
    if UI.MinBtn then UI.MinBtn.Text = UI.Minimized and "▢" or "—" end
    UI.ClampMain()
end

function UI.ApplySize()
    local mf = UI.Main
    if not mf then return end
    local f = math.clamp(State.WinScale / 100, 0.6, 1)
    UI.W, UI.H = math.floor(UI.BaseW * f), math.floor(UI.BaseH * f)
    mf.Size = UDim2.fromOffset(UI.W, UI.Minimized and UI.HEADER or UI.H)
    UI.ClampMain()
end


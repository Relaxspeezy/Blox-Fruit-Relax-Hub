-- Current amount of the currency an item is paid with (nil when unknown)
function Shop.Funds(cur)
    if cur == "Beli" or not cur then return Utils.Beli() end
    local ok, v = pcall(function() return LocalPlayer.Data[cur].Value end)
    if ok and type(v) == "number" then return v end
    return nil
end
function Shop.PriceText(it)
    if it.price <= 0 then return "—" end
    if it.cur == "Beli" then return "$" .. Utils.Num(it.price) end
    return Utils.Num(it.price) .. " " .. (it.cur == "Fragments" and "F" or it.cur)
end

function Shop.NearestNPC(keys)
    local npcs = Workspace:FindFirstChild("NPCs")
    if not npcs then return nil end
    local my = Utils.GetPos()
    local best, bestD
    for _, n in ipairs(npcs:GetDescendants()) do
        if n:IsA("Model") then
            for _, k in ipairs(keys) do
                if Utils.Has(n.Name, k) then
                    local r = Utils.ModelRoot(n)
                    if r then
                        local d = Utils.Distance(my, r.Position)
                        if not bestD or d < bestD then best, bestD = r.Position, d end
                    end
                    break
                end
            end
        end
    end
    return best
end

function Shop.FindLocation(keys)
    local wo = Workspace:FindFirstChild("_WorldOrigin")
    local locs = wo and wo:FindFirstChild("Locations")
    if not locs then return nil end
    for _, k in ipairs(keys) do
        for _, c in ipairs(locs:GetChildren()) do
            if Utils.Has(c.Name, k) then
                if c:IsA("BasePart") then return c.Position end
                if c:IsA("Model") then
                    local r = Utils.ModelRoot(c)
                    if r then return r.Position end
                end
            end
        end
    end
    return nil
end

local function stopFarmForTrip()
    if State.AutoFarm or State.AutoBoss then
        State.AutoFarm, State.AutoBoss = false, false
        State.HoldCF, State.GatherPoint, State.InCombat = nil, nil, false
        Utils.Notify("Farm paused for this trip", 3, "warn")
        if UI.RefreshAll then pcall(UI.RefreshAll) end
    end
end

Shop.Busy = false
function Shop.Go(it)
    if Shop.Busy then Utils.Notify("Already travelling, wait a moment", 3, "warn"); return end
    if it.sea ~= State.Sea then Utils.Notify("This item is sold in Sea " .. it.sea .. " (you are in Sea " .. State.Sea .. ")", 4, "warn"); return end
    stopFarmForTrip()
    Shop.Busy = true
    task.spawn(function()
        local ok, err = pcall(function()
            local pos = Shop.NearestNPC(it.find)
            if not pos then
                local loc = (#it.loc > 0) and Shop.FindLocation(it.loc) or nil
                if not loc then
                    Utils.Notify(it.npc .. " not loaded. Fly to " .. it.where .. " with the World tab first.", 5, "warn")
                    return
                end
                Utils.Notify("NPC not loaded yet: flying to the island first", 4)
                Flight.Go(loc, true)
                pcall(function() LocalPlayer:RequestStreamAroundAsync(loc, 250) end)
                task.wait(1.5)
                pos = Shop.NearestNPC(it.find)
                if not pos then
                    Utils.Notify(it.npc .. " still not found here. Look around " .. it.where .. ".", 5, "warn")
                    return
                end
            end
            Flight.Go(pos + Vector3.new(0, 2, 5), false)
        end)
        if not ok then Log("Shop go: " .. tostring(err), "WARN") end
        Shop.Busy = false
    end)
end

function Shop.Buy(it)
    if it.sea ~= State.Sea then Utils.Notify("This item is sold in Sea " .. it.sea .. " (you are in Sea " .. State.Sea .. ")", 4, "warn"); return end
    if not it.buy then Utils.Notify("Buy this one by talking to the NPC", 4, "warn"); return end
    local have = Shop.Funds(it.cur)
    if have and have < it.price then
        Utils.Notify("Not enough " .. it.cur .. ": need " .. Utils.Num(it.price) .. ", you have " .. Utils.Num(have), 4, "warn")
        return
    end
    task.spawn(function()
        local before = Shop.Funds(it.cur)
        local lastRes
        for _, args in ipairs(it.buy) do
            local _, res = Utils.InvokeEx(table.unpack(args))
            lastRes = res
            Log("Buy " .. it.name .. " -> " .. args[1] .. " reply: " .. tostring(res))
            task.wait(0.9)
            local now = Shop.Funds(it.cur)
            if before and now and now < before then
                Utils.Notify("Purchased: " .. it.name .. " ✔", 5, "success")
                return
            end
        end
        Utils.Notify("No purchase happened (reply: " .. tostring(lastRes) .. "). Walk to the NPC and buy it by hand.", 6, "warn")
    end)
end

function Shop.TravelSea(s)
    if s.sea == State.Sea then Utils.Notify("You are already in Sea " .. s.sea, 3, "info"); return end
    local lvl = Farm.Level()
    if lvl < s.level then
        Utils.Notify("Sea " .. s.sea .. " needs level " .. s.level .. " (you are " .. lvl .. ")", 5, "warn")
        return
    end
    stopFarmForTrip()
    ConfigManager.Save(true)
    Pause(20)
    Utils.Notify("Travelling to Sea " .. s.sea .. "... (" .. s.req .. ")", 6, "info")
    task.spawn(function()
        local ok, res = Utils.InvokeEx(s.remote)
        Log("Sea travel " .. s.remote .. " reply: " .. tostring(res) .. (ok and "" or " (call failed)"))
        task.wait(4)
        if State.Sea ~= s.sea and PLACE_TO_SEA[game.PlaceId] == State.Sea then
            Utils.Notify("Travel did not start. Requirement: " .. s.req, 6, "warn")
        end
    end)
end

-- ============================================================
-- AUTO SEA  (Sea 1 -> Sea 2 with Auto Sea 2, Sea 2 -> Sea 3 with Auto Sea 3)
-- ============================================================
AutoSea.Last = 0
AutoSea.Interval = 45
AutoSea.Told = {}

-- Best effort: ask the server about the unlock quests before the travel call (replies are only logged)
function AutoSea.Prepare(sea)
    if sea == 2 then
        local r = Utils.Invoke("DressrosaQuestProgress", "Detective")
        Log("Sea 2 unlock check reply: " .. tostring(r))
    elseif sea == 3 then
        local r = Utils.Invoke("ZQuestProgress", "Check")
        Log("Sea 3 unlock check reply: " .. tostring(r))
    end
end

-- Which sea would be travelled to right now (nil = nothing to do)
function AutoSea.Target()
    if State.Sea == 1 and State.AutoSea2 then return Shop.Seas[2] end
    if State.Sea == 2 and State.AutoSea3 then return Shop.Seas[3] end
    return nil
end

function AutoSea.Describe()
    if not State.AutoSea2 and not State.AutoSea3 then return "Off" end
    local t = AutoSea.Target()
    if t then
        local lvl = Farm.Level()
        if lvl < t.level then
            return "Sea " .. t.sea .. " needs level " .. t.level .. " (you are " .. lvl .. ")"
        end
        return "Travelling to Sea " .. t.sea .. " (retry every " .. AutoSea.Interval .. " s)"
    end
    if State.Sea == 1 then return "Waiting: Auto Sea 3 only works in Sea 2" end
    if State.Sea == 2 then return "Waiting: Auto Sea 2 only works in Sea 1" end
    return "You are in Sea 3 (last sea), nothing to do"
end

function AutoSea.Loop()
    task.spawn(function()
        while State.Running do
            task.wait(3)
            pcall(function()
                State.SeaStatus = AutoSea.Describe()
                if not (State.AutoSea2 or State.AutoSea3) then return end
                -- Sea 3 reached: nothing more to do, switch the toggles off once
                if State.Sea == 3 and (State.AutoSea2 or State.AutoSea3) then
                    State.AutoSea2, State.AutoSea3 = false, false
                    ConfigManager.Save(true)
                    Utils.Notify("You are in Sea 3: Auto Sea turned off", 5, "success")
                    if UI.RefreshAll then pcall(UI.RefreshAll) end
                    return
                end
                if Paused() or State.Hopping then return end
                local t = AutoSea.Target()
                if not t then return end
                if Farm.Level() < t.level then return end
                if os.clock() - AutoSea.Last < AutoSea.Interval then return end
                AutoSea.Last = os.clock()
                Log("Auto Sea: trying to travel to Sea " .. t.sea)
                AutoSea.Prepare(t.sea)
                Shop.TravelSea(t)
            end)
        end
    end)
end


-- ============================================================
-- AUTO SEA v2 (FULL AUTOMATION)
-- (overrides AutoSea.Loop / AutoSea.Describe above)
--
-- Auto Sea 2 (in Sea 1):  farm quests to level 700
--   -> Military Detective (Prison)  -> kill Ice Admiral (Frozen Village)
--   -> Military Detective again     -> Experienced Captain (Middle Town) -> TravelDressrosa
-- Auto Sea 3 (in Sea 2):  farm quests to level 1500
--   -> Trevor (Don Swan mansion) with a 1M+ fruit -> kill Don Swan
--   -> King Red Head (Colosseum)  -> kill rip_indra
--   -> Mr. Captain (Green Zone)   -> TravelZou
-- Steps follow the Blox Fruits fandom / guide pages. Remote argument names are best effort
-- and are logged (System > log) so you can see what the server answered.
-- ============================================================

AutoSea.Step = "Off"
AutoSea.Flags = {}
AutoSea.Running = false
AutoSea.Interval = 45
AutoSea.NotifyAt = 0

local PREMIUM_FRUITS = {"quake","buddha","love","spider","sound","phoenix","portal","rumble","pain","blizzard",
    "gravity","mammoth","t-rex","dough","shadow","venom","control","spirit","dragon","leopard","kitsune"}

local function seaOn()
    return (State.Sea == 1 and State.AutoSea2) or (State.Sea == 2 and State.AutoSea3)
end
local function seaCancel() return (not State.Running) or (not seaOn()) end

local function setStep(t)
    AutoSea.Step = t
    State.SeaStatus = t
    State.Status = "Auto Sea: " .. t
end

local function nag(msg)
    if os.clock() - AutoSea.NotifyAt > 60 then
        AutoSea.NotifyAt = os.clock()
        Utils.Notify(msg, 6, "warn")
    end
end

function AutoSea.Describe()
    if not State.AutoSea2 and not State.AutoSea3 then return "Off" end
    if State.Sea == 3 then return "You are in Sea 3 (last sea), nothing to do" end
    if not seaOn() then
        if State.Sea == 1 then return "Waiting: Auto Sea 3 only works in Sea 2" end
        return "Waiting: Auto Sea 2 only works in Sea 1"
    end
    return AutoSea.Step
end

-- Fly next to an NPC (streams the area first if the NPC is not loaded). Returns stand position or nil.
function AutoSea.Reach(keys, fallback, label)
    local pos = Shop.NearestNPC(keys)
    if not pos and fallback then
        setStep("Flying to " .. label .. " area")
        pcall(function() LocalPlayer:RequestStreamAroundAsync(fallback, 250) end)
        local hover = fallback + Vector3.new(0, 40, 0)
        if not Flight.To(hover, 8, seaCancel) then return nil end
        State.HoldCF = CFrame.new(hover)
        task.wait(2)
        State.HoldCF = nil
        pos = Shop.NearestNPC(keys)
    end
    if not pos then
        Log("Auto Sea: NPC not found: " .. label, "WARN")
        return nil
    end
    setStep("Flying to " .. label)
    local stand = pos + Vector3.new(0, 3, 4)
    if not Flight.To(stand, 4, seaCancel) then return nil end
    return stand
end

-- Fires every ProximityPrompt / ClickDetector of the NPC next to us
function AutoSea.Interact(stand, keys)
    State.HoldCF = CFrame.new(stand)
    local fired = 0
    local npcs = Workspace:FindFirstChild("NPCs")
    if npcs then
        for _, n in ipairs(npcs:GetDescendants()) do
            if n:IsA("Model") then
                for _, k in ipairs(keys) do
                    if Utils.Has(n.Name, k) then
                        for _, d in ipairs(n:GetDescendants()) do
                            if d:IsA("ProximityPrompt") then
                                Utils.FireProximity(d)
                                fired = fired + 1
                            elseif d:IsA("ClickDetector") and fireclickdetector then
                                pcall(fireclickdetector, d)
                                fired = fired + 1
                            end
                        end
                        break
                    end
                end
            end
        end
    end
    task.wait(1)
    return fired
end

function AutoSea.Remote(...)
    local ok, res = Utils.InvokeEx(...)
    local args = table.pack(...)
    local parts = {}
    for i = 1, args.n do parts[i] = tostring(args[i]) end
    Log("Auto Sea remote " .. table.concat(parts, ",") .. " -> " .. tostring(res) .. (ok and "" or " (call failed)"))
    task.wait(0.7)
    return res
end

-- Talks to an NPC: fly there, fire prompts, call the remote variants. Returns true if we got there.
function AutoSea.Talk(keys, fallback, label, remotes)
    local stand = AutoSea.Reach(keys, fallback, label)
    if not stand then return false end
    setStep("Talking to " .. label)
    local n = AutoSea.Interact(stand, keys)
    Log("Auto Sea: " .. label .. " prompts fired: " .. n)
    for _, a in ipairs(remotes or {}) do
        if seaCancel() then break end
        AutoSea.Remote(table.unpack(a))
    end
    State.HoldCF = nil
    return true
end

-- Kills a boss with the normal boss loop. Hops servers if it never spawns. Returns true when killed.
function AutoSea.KillBoss(boss, streamKeys, locKeys)
    local waitStart, seen, goneSince = os.clock(), false, nil
    State.AutoFarm = false
    State.SelectedBoss = boss
    State.AutoBoss = true
    while not seaCancel() do
        if #Farm.Alive(boss, math.huge, true) > 0 then
            seen, goneSince = true, nil
            waitStart = os.clock()
            setStep("Fighting " .. boss)
        elseif seen then
            goneSince = goneSince or os.clock()
            if os.clock() - goneSince > 4 then
                State.AutoBoss = false
                Log("Auto Sea: boss defeated: " .. boss)
                return true
            end
        else
            setStep("Looking for " .. boss)
            local pos = Shop.FindLocation(locKeys or {}) or (streamKeys and Shop.NearestNPC(streamKeys))
            if pos and not Farm.BossBusy and Utils.Distance(Utils.GetPos(), pos) > 120 then
                Flight.To(pos + Vector3.new(0, 40, 0), 10, function()
                    return seaCancel() or #Farm.Alive(boss, math.huge, true) > 0
                end)
                pcall(function() LocalPlayer:RequestStreamAroundAsync(pos, 300) end)
                State.HoldCF = CFrame.new(pos + Vector3.new(0, 40, 0))
                task.wait(2)
                State.HoldCF = nil
            end
            if os.clock() - waitStart > 100 then
                Log("Auto Sea: " .. boss .. " not spawned -> server hop", "WARN")
                State.AutoBoss = false
                ServerHop.Hop()
                task.wait(20)
                waitStart = os.clock()
                State.AutoBoss = true
            end
        end
        task.wait(1)
    end
    State.AutoBoss = false
    return false
end

local function findPremiumFruit()
    for _, holder in ipairs({LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character}) do
        if holder then
            for _, t in ipairs(holder:GetChildren()) do
                if t:IsA("Tool") and FruitSniper.IsFruit(t) then
                    local n = t.Name:lower()
                    for _, p in ipairs(PREMIUM_FRUITS) do
                        if n:find(p, 1, true) then return t end
                    end
                end
            end
        end
    end
    return nil
end

-- ---------------- SEA 1 -> SEA 2 ----------------
function AutoSea.RunSea2()
    local F = AutoSea.Flags
    local prison = Quest.Hints["PrisonerQuest"]

    if not F.talked then
        if not AutoSea.Talk({"detective"}, prison, "Military Detective", {{"DressrosaQuestProgress", "Detective"}}) then return end
        F.talked = true
    end
    if seaCancel() then return end

    if not F.iceDead then
        if not AutoSea.KillBoss("Ice Admiral", {"ability teacher"}, {"frozen"}) then return end
        F.iceDead = true
    end
    if seaCancel() then return end

    if not F.reported then
        if not AutoSea.Talk({"detective"}, prison, "Military Detective", {{"DressrosaQuestProgress", "Detective"}}) then return end
        F.reported = true
    end
    if seaCancel() then return end

    -- Experienced Captain (Middle Town) then travel
    local mid = Shop.FindLocation({"middle"})
    AutoSea.Talk({"experienced captain", "captain"}, mid, "Experienced Captain", nil)
    if seaCancel() then return end
    setStep("Travelling to Sea 2")
    AutoSea.Remote("DressrosaQuestProgress", "Detective")
    Shop.TravelSea(Shop.Seas[2])
    task.wait(8)
end

-- ---------------- SEA 2 -> SEA 3 ----------------
function AutoSea.RunSea3()
    local F = AutoSea.Flags
    local mansion = Shop.FindLocation({"kingdom", "rose", "mansion"})

    if not F.swanDoor then
        local fruit = findPremiumFruit()
        if not fruit then
            setStep("Need a fruit worth 1M+ in your inventory (e.g. Quake)")
            nag("Auto Sea 3: take a 1M+ fruit (Quake, Buddha, Love...) into your backpack. Waiting...")
            task.wait(5)
            return
        end
        local hum = Utils.GetHumanoid()
        if hum then pcall(function() hum:EquipTool(fruit) end) end
        if not AutoSea.Talk({"trevor"}, mansion, "Trevor", {{"TalkTrevor"}}) then return end
        F.swanDoor = true
    end
    if seaCancel() then return end

    if not F.swanDead then
        if not AutoSea.KillBoss("Don Swan", {"trevor"}, {"kingdom", "rose"}) then return end
        F.swanDead = true
    end
    if seaCancel() then return end

    if not F.kingTalked then
        local colo = Shop.FindLocation({"colosseum"}) or mansion
        if not AutoSea.Talk({"king red head", "red head"}, colo, "King Red Head", nil) then return end
        F.kingTalked = true
    end
    if seaCancel() then return end

    if not F.indraDead then
        if not AutoSea.KillBoss("rip_indra", {"king red head"}, {"colosseum", "green zone"}) then return end
        F.indraDead = true
    end
    if seaCancel() then return end

    local green = Shop.FindLocation({"green"})
    AutoSea.Talk({"mr. captain", "mr captain", "captain"}, green, "Mr. Captain", nil)
    if seaCancel() then return end
    setStep("Travelling to Sea 3")
    AutoSea.Remote("ZQuestProgress", "Check")
    Shop.TravelSea(Shop.Seas[3])
    task.wait(8)
end

function AutoSea.Loop()
    task.spawn(function()
        local wasOn = false
        while State.Running do
            task.wait(3)
            pcall(function()
                if not AutoSea.Running then State.SeaStatus = AutoSea.Describe() end

                -- Sea 3 reached: switch toggles off once
                if State.Sea == 3 and (State.AutoSea2 or State.AutoSea3) then
                    State.AutoSea2, State.AutoSea3 = false, false
                    AutoSea.Flags = {}
                    ConfigManager.Save(true)
                    Utils.Notify("You are in Sea 3: Auto Sea turned off", 5, "success")
                    if UI.RefreshAll then pcall(UI.RefreshAll) end
                    return
                end

                if not seaOn() then
                    if wasOn then AutoSea.Flags = {}; State.AutoBoss = false end
                    wasOn = false
                    return
                end
                wasOn = true
                if Paused() or State.Hopping or AutoSea.Running then return end

                local need = (State.Sea == 1) and 700 or 1500
                local lvl = Farm.Level()
                if lvl < need then
                    setStep("Farming quests: level " .. lvl .. " / " .. need)
                    State.AutoBoss = false
                    if not State.AutoFarm then Farm.SetAuto(true) end
                    return
                end

                -- level reached: stop farming, run the unlock chain
                if State.AutoFarm then
                    State.AutoFarm = false
                    State.HoldCF, State.GatherPoint, State.InCombat = nil, nil, false
                    Utils.Notify("Level " .. need .. " reached: starting the Sea " .. (State.Sea + 1) .. " unlock steps", 5, "success")
                    if UI.RefreshAll then pcall(UI.RefreshAll) end
                    task.wait(1)
                end
                AutoSea.Running = true
                ConfigManager.Save(true)
                local ok, err = pcall(State.Sea == 1 and AutoSea.RunSea2 or AutoSea.RunSea3)
                AutoSea.Running = false
                State.HoldCF, State.Traveling = nil, false
                if not ok then Log("Auto Sea error: " .. tostring(err), "WARN") end
            end)
        end
    end)
end

-- ============================================================
-- AUTO RAID  (Sea 2 + Sea 3 only)
--
-- Steps (from the Blox Fruits fandom wiki "Raids" / "Microchip" pages):
--   * Raids exist only in Sea 2 (Hot and Cold) and Sea 3 (Castle on the Sea). Sea 1 has NO raids -> warning.
--   * Chips are sold by the Mysterious Scientist (level 1100+). A chip costs $100,000 or ANY fruit.
--     This script only pays with a FRUIT, so it refuses to start unless you own a fruit
--     (stored in your inventory or in your backpack). Every raid uses up one fruit.
--     Advanced chips (Phoenix / Dough) need a fruit worth more than $1,000,000.
--   * The raid button is in the raid lab (Hot and Cold / Castle on the Sea). A raid has 5 islands;
--     the next island only appears after every enemy on the current one is dead.
--   * Flow: check sea + level + fruit -> buy chip -> fly to the raid button -> press it ->
--           kill every enemy -> fly to the next island -> ... -> island 5 + boss -> raid ends -> repeat.
-- Remote names / argument formats are best effort and every reply is written to the log (System tab).
-- ============================================================

local RAID_ADVANCED = {Phoenix = true, Dough = true}
local RAID_MIN_LEVEL = 1100
local RAID_SPOTS = {
    [2] = {name = "Hot and Cold", loc = {"hot and cold"}, fallback = Vector3.new(-6438.7, 250.6, -4501.5),
           path = {"CircleIsland", "RaidSummon"}, scientist = {"hot and cold"}},
    [3] = {name = "Castle on the Sea", loc = {"castle on the sea"}, fallback = Vector3.new(-5017.4, 314.8, -2823.0),
           path = {"Boat Castle", "RaidSummon2"}, scientist = {"castle on the sea"}},
}

Raid.Active = false      -- true while Auto Raid controls the character (farm / boss / chest / fruit loops pause)
Raid.Status = "Off"
Raid.Done = 0            -- raids finished in total
Raid.Run = 0             -- raids finished since the toggle was turned on
Raid.Fails = 0
Raid.WarnAt = 0
Raid.Msg = {
    Sea1 = "No raids in Sea 1 yet! Raids exist only in Sea 2 (Hot and Cold) and Sea 3 (Castle on the Sea).",
}

Raid.Manual = false
local function raidCancel() return (not State.Running) or (not State.AutoRaid and not Raid.Manual) end

function Raid.Say(t)
    Raid.Status = t
    State.Status = "Auto Raid: " .. t
end

local function raidNag(msg, kind, every)
    if os.clock() - Raid.WarnAt > (every or 60) then
        Raid.WarnAt = os.clock()
        Utils.Notify(msg, 7, kind or "warn")
    end
end

local function raidStop(reason)
    State.AutoRaid = false
    Raid.Active = false
    State.HoldCF, State.InCombat, State.Traveling = nil, false, false
    Raid.Status = "Stopped: " .. reason
    Utils.Notify("Auto Raid stopped: " .. reason, 8, "warn")
    if UI.RefreshAll then pcall(UI.RefreshAll) end
end

-- ---------- chip / fruit ----------
function Raid.ChipTool()
    for _, holder in ipairs({LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character}) do
        if holder then
            for _, t in ipairs(holder:GetChildren()) do
                if t:IsA("Tool") and Utils.Has(t.Name, "microchip") then return t end
            end
        end
    end
    return nil
end

-- Fruits the player owns: stored inventory (server) + fruits in the backpack.
-- Returns list {name, price}, known (false when the inventory could not be read)
function Raid.Fruits()
    local list, known = {}, false
    local ok, inv = Utils.InvokeEx("getInventoryFruits")
    if ok and type(inv) == "table" then
        known = true
        for k, v in pairs(inv) do
            if type(v) == "table" then
                local n = v.Name or v.name
                if type(n) ~= "string" then n = type(k) == "string" and k or "fruit" end
                local p = tonumber(v.Price or v.price or v.Value)
                table.insert(list, {name = n, price = p})
            elseif type(v) == "string" then
                table.insert(list, {name = v})
            end
        end
    end
    for _, holder in ipairs({LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character}) do
        if holder then
            for _, t in ipairs(holder:GetChildren()) do
                if FruitSniper.IsFruit(t) then
                    known = true
                    table.insert(list, {name = t.Name, bag = true})
                end
            end
        end
    end
    return list, known
end

-- Returns ok, reason, payWith ("fruit" / "beli").
-- A fruit is used when you own one; with no fruit the chip is paid with 100,000 Beli.
function Raid.FruitOk(chip)
    local list, known = Raid.Fruits()
    if #list == 0 then
        if Utils.Beli() >= 100000 then
            return true, nil, "beli"
        end
        if known then
            return false, "No fruit in your inventory and less than $100,000 Beli: cannot buy a raid chip."
        end
        Log("Raid: could not read the fruit inventory and Beli is low, trying anyway (the server checks it)", "WARN")
        return true, nil, "beli"
    end
    if RAID_ADVANCED[chip] then
        local priced, rich = false, false
        for _, f in ipairs(list) do
            if f.price then priced = true; if f.price > 1000000 then rich = true end end
        end
        if priced and not rich then
            if Utils.Beli() >= 100000 then return true, nil, "beli" end
            return false, chip .. " is an advanced chip: it needs a fruit worth more than $1,000,000."
        end
    end
    return true, nil, "fruit"
end

-- ---------- empty hands / chip in backpack ----------
-- The server looks for the chip in the BACKPACK and wants an EMPTY hand: unequip everything first.
function Raid.EmptyHands()
    local hum = Utils.GetHumanoid()
    if not hum then return false end
    for _ = 1, 6 do
        local char = Utils.GetCharacter()
        if not char or not char:FindFirstChildOfClass("Tool") then return true end
        pcall(function() hum:UnequipTools() end)
        task.wait(0.25)
    end
    local char = Utils.GetCharacter()
    return char ~= nil and char:FindFirstChildOfClass("Tool") == nil
end

function Raid.EquipChip()
    local hum = Utils.GetHumanoid()
    if not hum then return false end
    for _ = 1, 4 do
        local char = Utils.GetCharacter()
        if char then
            for _, t in ipairs(char:GetChildren()) do
                if t:IsA("Tool") and Utils.Has(t.Name, "microchip") then return true end
            end
        end
        local tool = Raid.ChipInBag()
        if not tool then return false end
        pcall(function() hum:EquipTool(tool) end)
        task.wait(0.35)
    end
    local char = Utils.GetCharacter()
    if char then
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") and Utils.Has(t.Name, "microchip") then return true end
        end
    end
    return false
end

-- Game warnings about the chip ("Microchip not found" ...) are remembered so the script can react to them
Raid.LastWarn, Raid.LastWarnT, Raid.Watching = "", 0, false
function Raid.WatchWarn()
    if Raid.Watching then return end
    Raid.Watching = true
    pcall(function()
        local pg = LocalPlayer:WaitForChild("PlayerGui", 10)
        if not pg then return end
        local function hook(d)
            if not d:IsA("TextLabel") then return end
            local function chk()
                local t = d.Text
                if type(t) == "string" and t ~= "" then
                    local l = t:lower()
                    if l:find("microchip", 1, true) or (l:find("chip", 1, true) and l:find("not found", 1, true)) then
                        Raid.LastWarn, Raid.LastWarnT = t, os.clock()
                        Log("Game warning: " .. t, "WARN")
                    end
                end
            end
            chk()
            d:GetPropertyChangedSignal("Text"):Connect(chk)
        end
        table.insert(State.Connections, pg.DescendantAdded:Connect(hook))
        for _, d in ipairs(pg:GetDescendants()) do hook(d) end
    end)
end

function Raid.ChipInBag()
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and Utils.Has(t.Name, "microchip") then return t end
        end
    end
    return nil
end

local function partOf(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst end
    return inst:FindFirstChildWhichIsA("BasePart", true)
end

function Raid.BuyChip()
    local chip = RAID_CHIP_ARG[State.RaidChip] or State.RaidChip
    local keys = {"mysterious scientist", "scientist"}
    local spot = RAID_SPOTS[State.Sea]

    local pos = Shop.NearestNPC(keys)
    if not pos then
        -- known lab / castle spot first, island marker second; flies LOW (+15) so the NPC streams in
        local tries = {spot.fallback}
        local loc = Shop.FindLocation(spot.scientist)
        if loc then table.insert(tries, loc) end
        for _, base in ipairs(tries) do
            if raidCancel() then return false end
            Raid.Say("Flying to the Mysterious Scientist area")
            pcall(function() LocalPlayer:RequestStreamAroundAsync(base, 4) end)
            local hover = base + Vector3.new(0, 15, 0)
            if not Flight.To(hover, 8, raidCancel) then return false end
            State.HoldCF = CFrame.new(hover)
            pcall(function() LocalPlayer:RequestStreamAroundAsync(hover, 4) end)
            task.wait(2)
            State.HoldCF = nil
            pos = Shop.NearestNPC(keys)
            if pos then break end
        end
    end
    if not pos then
        Log("Raid: Mysterious Scientist NPC not loaded (fly to the Hot and Cold lab / Castle on the Sea once so it streams in)", "WARN")
        return false
    end
    Raid.SciPos = pos   -- the raid button we want is in the same room as the Scientist
    Log(string.format("Raid: Mysterious Scientist at %.0f, %.0f, %.0f", pos.X, pos.Y, pos.Z))

    Raid.Say("Flying to the Mysterious Scientist")
    local stand = pos + Vector3.new(0, 3, 4)
    if not Flight.To(stand, 4, raidCancel) then return false end
    State.HoldCF = CFrame.new(stand)

    local _, _, payWith = Raid.FruitOk(State.RaidChip)
    Raid.Say((payWith == "beli") and ("Paying $100,000 for the " .. chip .. " chip") or ("Trading a fruit for the " .. chip .. " chip"))
    Log("Raid: paying with " .. tostring(payWith or "fruit") .. " (Beli " .. Utils.Num(Utils.Beli()) .. ")")
    Raid.EmptyHands()
    pcall(AutoSea.Interact, stand, keys)
    if not raidCancel() and not Raid.ChipTool() then
        local okc, res = Utils.InvokeEx("RaidsNpc", "Select", chip)
        Log("Raid chip remote RaidsNpc,Select," .. chip .. " -> " .. tostring(res) .. (okc and "" or " (call failed)"))
        local t0 = os.clock()
        while os.clock() - t0 < 6 and not Raid.ChipTool() do task.wait(0.3) end
    end
    State.HoldCF = nil
    Raid.EmptyHands()
    local got = Raid.ChipInBag() ~= nil
    if got then Utils.Notify("Raid chip received: " .. chip, 4, "success") end
    return got
end

-- ---------- raid state ----------
-- "Island N" markers that exist OUTSIDE a raid (map markers) must not be taken for raid islands
Raid.Base = setmetatable({}, {__mode = "k"})
-- Markers left behind by a FINISHED raid: ignored from then on (a new raid creates new markers)
Raid.Stale = setmetatable({}, {__mode = "k"})
Raid.DoneAt = -1e9
function Raid.MarkStale()
    local wo = Workspace:FindFirstChild("_WorldOrigin")
    local locs = wo and wo:FindFirstChild("Locations")
    if not locs then return 0 end
    local n = 0
    for _, c in ipairs(locs:GetChildren()) do
        if c.Name:match("^Island (%d+)$") and not Raid.Base[c] and not Raid.Stale[c] then
            Raid.Stale[c] = true
            n = n + 1
        end
    end
    if n > 0 then Log("Raid: finished raid, ignoring " .. n .. " old island marker(s)") end
    return n
end

function Raid.SnapBase()
    if Raid.TimerVisible() then return end
    local wo = Workspace:FindFirstChild("_WorldOrigin")
    local locs = wo and wo:FindFirstChild("Locations")
    if not locs then return end
    for _, c in ipairs(locs:GetChildren()) do
        if c.Name:match("^Island (%d+)$") then Raid.Base[c] = true end
    end
end

function Raid.IslandList()
    local out = {}
    local wo = Workspace:FindFirstChild("_WorldOrigin")
    local locs = wo and wo:FindFirstChild("Locations")
    if not locs then return out end
    for _, c in ipairs(locs:GetChildren()) do
        local n = c.Name:match("^Island (%d+)$")
        if n and not Raid.Base[c] and not Raid.Stale[c] and tonumber(n) <= 5 then
            local pos
            if c:IsA("BasePart") then pos = c.Position
            elseif c:IsA("Model") then
                local r = Utils.ModelRoot(c)
                pos = r and r.Position
            end
            if pos then table.insert(out, {idx = tonumber(n), pos = pos}) end
        end
    end
    table.sort(out, function(a, b) return a.idx > b.idx end) -- highest = the island we are on
    return out
end

function Raid.TimerVisible()
    local ok, v = pcall(function() return LocalPlayer.PlayerGui.Main.Timer.Visible end)
    return ok and v == true
end

-- The timer alone can be shown by other game features: after 2 fruitless timer-only attempts it is ignored
Raid.TimerOnly = 0
function Raid.InRaid()
    return #Raid.IslandList() > 0 or (Raid.TimerVisible() and Raid.TimerOnly < 2)
end

-- ---------- start ----------
-- Where the raid room is: the Mysterious Scientist stands in the same room as the raid button / tubes.
Raid.SciPos = nil
function Raid.ButtonRef()
    local spot = RAID_SPOTS[State.Sea]
    return Shop.NearestNPC({"mysterious scientist", "scientist"}) or Raid.SciPos or spot.fallback
end

-- ALL raid buttons that are streamed in, closest to `ref` first. Returns best ClickDetector, list.
function Raid.FindButton(ref)
    local map = Workspace:FindFirstChild("Map")
    local spot = RAID_SPOTS[State.Sea]
    if not map or not spot then return nil, {} end
    ref = ref or Raid.ButtonRef()
    local list, seen = {}, {}
    local function add(cd)
        if seen[cd] then return end
        seen[cd] = true
        local part = partOf(cd.Parent)
        if part then
            table.insert(list, {cd = cd, part = part, d = (part.Position - ref).Magnitude, path = (part:GetFullName():gsub("^Workspace%.", ""))})
        end
    end
    local isl = map:FindFirstChild(spot.path[1])
    local summon = isl and isl:FindFirstChild(spot.path[2])
    if summon then
        for _, d in ipairs(summon:GetDescendants()) do
            if d:IsA("ClickDetector") then add(d) end
        end
    end
    local n = 0
    for _, d in ipairs(map:GetDescendants()) do
        n = n + 1
        if n % 4000 == 0 then task.wait() end
        if d:IsA("ClickDetector") and not seen[d] then
            local p, depth = d.Parent, 0
            while p and p ~= map and depth < 8 do
                if p.Name:lower():find("raidsummon", 1, true) then add(d); break end
                p, depth = p.Parent, depth + 1
            end
        end
    end
    table.sort(list, function(a, b) return a.d < b.d end)
    return list[1] and list[1].cd, list
end

function Raid.WaitStart(sec)
    local t0 = os.clock()
    while os.clock() - t0 < sec and not raidCancel() do
        if #Raid.IslandList() > 0 then return true end
        task.wait(0.5)
    end
    return #Raid.IslandList() > 0
end

-- Part the host must stand on: the dark-blue tube (Sea 2) / yellow platform (Sea 3) next to the button.
function Raid.FindTube(cd)
    local btn = partOf(cd.Parent)
    if not btn then return nil end
    local hints = {"tube", "capsule", "circle", "platform", "pad", "ring", "summon"}
    local best, bestD
    for _, p in ipairs(Workspace:GetPartBoundsInRadius(btn.Position, 45)) do
        if p ~= btn and not p:IsDescendantOf(cd.Parent) and p.Size.X >= 5 and p.Size.Z >= 5 then
            local n = (p.Name .. " " .. (p.Parent and p.Parent.Name or "")):lower()
            local ok = false
            for _, h in ipairs(hints) do
                if n:find(h, 1, true) then ok = true; break end
            end
            if ok then
                local d = (Vector3.new(p.Position.X, 0, p.Position.Z) - Vector3.new(btn.Position.X, 0, btn.Position.Z)).Magnitude
                if not bestD or d < bestD then best, bestD = p, d end
            end
        end
    end
    if not best then return nil end
    local y = best.Size.Y < 8 and (best.Position.Y + best.Size.Y / 2 + 3) or (best.Position.Y - best.Size.Y / 2 + 3)
    return Vector3.new(best.Position.X, y, best.Position.Z)
end

function Raid.Start()
    local spot = RAID_SPOTS[State.Sea]
    Raid.FragBase = Shop.Funds("Fragments")   -- the raid counts as done only when this goes up
    local ref = Raid.ButtonRef()
    local MAXD = 300   -- the raid button must be this close to the Scientist (same room)
    local cd, list = Raid.FindButton(ref)
    if not (cd and list[1] and list[1].d <= MAXD) then
        -- fly to the Scientist's room first, wait for the map to stream in, then look again
        Raid.Say("Flying to the raid room (next to the Mysterious Scientist)")
        pcall(function() LocalPlayer:RequestStreamAroundAsync(ref, 4) end)
        local hover = ref + Vector3.new(0, 12, 0)
        if not Flight.To(hover, 8, raidCancel) then return false end
        State.HoldCF = CFrame.new(hover)
        pcall(function() LocalPlayer:RequestStreamAroundAsync(hover, 4) end)
        task.wait(2.5)
        State.HoldCF = nil
        cd, list = Raid.FindButton(ref)
    end
    if not (cd and list[1] and list[1].d <= MAXD) then
        Log("Raid: no raid button within " .. MAXD .. " studs of the Mysterious Scientist (" .. spot.name .. ")", "WARN")
        for i = 1, math.min(4, #list) do
            Log(string.format("  candidate %s  (%.0f studs from the Scientist)", list[i].path, list[i].d), "WARN")
        end
        return false
    end
    Log(string.format("Raid: using raid button %s (%.0f studs from the Scientist, %d other raid button(s) ignored)", list[1].path, list[1].d, #list - 1))

    State.InCombat = false
    if not Raid.ChipTool() then
        Log("Raid: Special Microchip is not in the backpack or hand (it is either not bought or was used)", "WARN")
        return false
    end

    local part = partOf(cd.Parent)
    local stand = Raid.FindTube(cd)
    if stand then
        Raid.Say("Flying into the raid tube")
    elseif part then
        stand = part.Position + Vector3.new(0, 3, 3)
        Raid.Say("Flying to the raid button (tube not found)")
    end
    if stand then
        if not Flight.To(stand, 3, raidCancel) then return false end
        State.HoldCF = CFrame.new(stand)
        task.wait(0.6)
    end

    if not fireclickdetector then
        Utils.Notify("Your executor has no fireclickdetector: press the raid button by hand (waiting 60 s)", 8, "warn")
        local ok = Raid.WaitStart(60)
        State.HoldCF = nil
        return ok
    end

    pcall(function() cd.MaxActivationDistance = 10000 end)
    -- The chip is pressed in two ways (held in hand / sitting in the backpack); the way that works is remembered.
    local order = {"bag", "bag", "bag", "bag"} -- empty hand + chip in the backpack (wiki); the chip is never equipped
    for attempt, mode in ipairs(order) do
        if raidCancel() then break end
        if mode == "hand" then
            Raid.HoldChip = true
            if not Raid.EquipChip() then
                Log("Raid: could not take the chip into the hand", "WARN")
            end
        else
            Raid.HoldChip = false
            Raid.EmptyHands()
        end
        if not Raid.ChipTool() then
            Log("Raid: chip left the inventory before pressing the button", "WARN")
            break
        end
        Raid.Say("Pressing the raid button (" .. attempt .. "/4, empty hand, chip in backpack)")
        local t0 = os.clock()
        local timerBefore = Raid.TimerVisible()
        pcall(fireclickdetector, cd)
        local started = false
        while os.clock() - t0 < 12 and not raidCancel() do
            if #Raid.IslandList() > 0 or (not timerBefore and Raid.TimerVisible()) then started = true; break end
            if Raid.LastWarnT >= t0 then
                Log("Raid: game said '" .. tostring(Raid.LastWarn) .. "' with the chip " .. (mode == "hand" and "in hand" or "in backpack") .. " -> switching method", "WARN")
                break
            end
            task.wait(0.4)
        end
        if started then
            Raid.PressMode = mode
            Raid.HoldChip = false
            State.HoldCF = nil
            Log("Raid started with the chip " .. (mode == "hand" and "in hand" or "in backpack"))
            return true
        end
    end
    Raid.HoldChip = false
    State.HoldCF = nil
    return false
end

-- ---------- fight ----------
-- Works through the raid islands IN ORDER (lowest not-cleared island first).
-- Returns true when at least one raid island was seen.
function Raid.Fight()
    local seenIsland = false
    local maxIdx = 0                       -- highest island number seen in this raid
    local lastAlive, lastMob = os.clock(), os.clock()
    local safeUntil = 0
    local lastFragChk = 0
    local cleared, everSeen, lastSeenAt = {}, {}, {}   -- island index -> true / time enemies were last seen there
    local curIdx = nil                     -- island we are working on
    local emptySince = nil                 -- the current island has been empty since...
    local allEmptySince = nil              -- every listed island is cleared since...
    State.TargetMob = "-"
    Farm.CountKills()

    local function stop() return raidCancel() end
    while State.Running and State.AutoRaid do
        local now = os.clock()
        local isl = Raid.IslandList()                               -- highest first
        if #isl > 0 then
            seenIsland = true
            if isl[1].idx > maxIdx then
                maxIdx = isl[1].idx
                lastMob = now
                Log("Raid: island " .. maxIdx .. " is up")
            end
        end
        if #isl > 0 or (Raid.TimerVisible() and Raid.TimerOnly < 2) then lastAlive = now end
        -- A raid has 5 islands: do not call it "over" before island 5 was reached unless the markers stay gone for a long time
        local grace = (seenIsland and maxIdx < 5) and 25 or 6
        if now - lastAlive > grace then break end                  -- raid is over
        if now - lastMob > 90 then
            Log("Raid: nothing to kill for 90 s, leaving the raid loop", "WARN")
            break
        end
        -- The Fragments only go up when the raid is COMPLETE: that ends the fight at once, whatever the island markers say
        if Raid.FragBase and now - lastFragChk >= 1 then
            lastFragChk = now
            local f = Shop.Funds("Fragments")
            if f and f > Raid.FragBase then
                Log("Raid: Fragments went up, raid finished")
                break
            end
        end

        local hum, root = Utils.GetHumanoid(), Utils.GetRootPart()
        if not hum or not root or hum.Health <= 0 then
            -- dead players cannot rejoin a raid
            Log("Raid: character died", "WARN")
            State.HoldCF, State.InCombat = nil, false
            break
        end

        -- target = the LOWEST island that is not cleared yet (isl is sorted highest first, so walk it backwards)
        local target
        for i = #isl, 1, -1 do
            if not cleared[isl[i].idx] then target = isl[i]; break end
        end
        if target and target.idx ~= curIdx then
            curIdx, emptySince = target.idx, nil
            lastMob = now
            Log("Raid: working on island " .. curIdx)
        end

        -- enemies of the TARGET island only (each enemy belongs to its nearest island marker); with no island list (timer only) any enemy
        local mobs = Farm.Alive(nil, 1500)                          -- nearest to you first
        local fightMobs = {}
        if #isl == 0 then
            fightMobs = mobs
        elseif target then
            for _, m in ipairs(mobs) do
                local bestIdx, bestD
                for _, it in ipairs(isl) do
                    local d = Utils.Distance(m.root.Position, it.pos)
                    if d <= 900 and (not bestD or d < bestD) then bestIdx, bestD = it.idx, d end
                end
                if bestIdx == target.idx then table.insert(fightMobs, m) end
            end
        end
        if #fightMobs > 0 then
            if target then everSeen[target.idx] = true; lastSeenAt[target.idx] = now end
            emptySince, allEmptySince = nil, nil
        end

        if State.SafeHP > 0 and hum.MaxHealth > 0 and hum.Health / hum.MaxHealth * 100 < State.SafeHP and now > safeUntil then
            -- low HP: float above the fight for a moment (a death would kick us out of the raid)
            State.InCombat = false
            Raid.Say("Low HP: recovering")
            local up = root.Position + Vector3.new(0, 150, 0)
            Flight.To(up, 4, stop)
            State.HoldCF = CFrame.new(up)
            local t0 = os.clock()
            while State.Running and State.AutoRaid and os.clock() - t0 < 15 do
                local h = Utils.GetHumanoid()
                if not h or h.Health <= 0 or h.Health / h.MaxHealth * 100 >= 70 then break end
                task.wait(0.5)
            end
            State.HoldCF = nil
            safeUntil = os.clock() + 20
        elseif #fightMobs > 0 then
            lastMob = now
            for _, m in ipairs(fightMobs) do Farm.Tracked[m.model] = m.hum end
            -- fight the group nearest to us first
            local first = fightMobs[1]
            local grp = {}
            for _, m in ipairs(fightMobs) do
                if Utils.Distance(m.root.Position, first.root.Position) <= 400 then table.insert(grp, m) end
            end
            local G = clusterCenter(grp)
            local H = G + Vector3.new(0, Farm.Hover(), 0)
            if Utils.Distance(root.Position, H) > 30 then
                State.InCombat = false
                State.HoldCF = nil
                Raid.Say("Island " .. (target and target.idx or "?") .. ": flying to enemies (" .. #fightMobs .. ")")
                Flight.To(H, 3, stop)
            end
            root = Utils.GetRootPart()
            if root and Utils.Distance(root.Position, H) < 40 then
                State.HoldCF = lookCF(H, G)
                State.InCombat = true
                Raid.Say("Island " .. (target and target.idx or "?") .. ": killing enemies (" .. #fightMobs .. ")")
            end
        elseif target then
            State.InCombat = false
            local seenAt = lastSeenAt[target.idx]
            if everSeen[target.idx] and seenAt then
                -- we fought here already: 5 s without enemies = cleared, right where we stand (no flying back to the marker)
                local idle = now - seenAt
                Raid.Say("Island " .. target.idx .. ": checking for more enemies (" .. math.floor(idle) .. " s)")
                if idle >= 5 then
                    cleared[target.idx] = true
                    emptySince = nil
                    Log("Raid: island " .. target.idx .. " cleared")
                end
            else
                -- never saw an enemy here: go there (enemies stream in near the player) and wait
                local H = target.pos + Vector3.new(0, 60, 0)
                if Utils.Distance(root.Position, H) > 60 then
                    State.HoldCF = nil
                    emptySince = nil
                    Raid.Say("Moving to island " .. target.idx)
                    Flight.To(H, 4, stop)
                    State.HoldCF = CFrame.new(H)
                else
                    State.HoldCF = CFrame.new(H)
                    emptySince = emptySince or now
                    local idle = now - emptySince
                    Raid.Say("Island " .. target.idx .. ": waiting for enemies (" .. math.floor(idle) .. " s)")
                    if idle >= 20 then
                        cleared[target.idx] = true
                        emptySince = nil
                        Log("Raid: island " .. target.idx .. " cleared (no enemies showed up)")
                    end
                end
            end
        else
            -- every listed island is cleared: wait at the newest one for the next island / the end of the raid
            State.InCombat = false
            allEmptySince = allEmptySince or now
            local cur = isl[1]
            if cleared[5] then
                -- last island done: stay where we are and wait for the reward (never fly to the old island marker)
                Raid.Say("Island 5 cleared: waiting for the Fragments")
            elseif cur then
                local H = cur.pos + Vector3.new(0, 60, 0)
                if Utils.Distance(root.Position, H) > 60 then
                    State.HoldCF = nil
                    Flight.To(H, 4, stop)
                end
                State.HoldCF = CFrame.new(H)
                Raid.Say("Island " .. cur.idx .. " cleared: waiting for the next island")
            end
            -- Island 5 is the LAST island: when it is cleared and the reward arrived (Fragments up) or the timer is gone, the raid is over.
            if cleared[5] then
                local idle = now - allEmptySince
                local done = false
                if idle >= 4 and Raid.FragBase and now - lastFragChk >= 1 then
                    lastFragChk = now
                    local f = Shop.Funds("Fragments")
                    if f and f > Raid.FragBase then done = true end
                end
                if not done and idle >= 12 and not Raid.TimerVisible() then done = true end
                if not done and idle >= 45 then done = true end
                if done then
                    Log("Raid: island 5 cleared, raid finished")
                    break
                end
            end
        end
        task.wait(0.1)
        Farm.CountKills()
    end
    Farm.CountKills()
    State.InCombat, State.HoldCF = false, nil
    return seenIsland
end

-- ---------- one full cycle ----------
Raid.FragBase = nil
function Raid.Cycle()
    -- Safety: islands are still listed, but no timer runs and nobody is left to kill, shortly after a finished raid -> stale markers
    if Raid.InRaid() and not Raid.TimerVisible() and os.clock() - Raid.DoneAt < 900 then
        local isl = Raid.IslandList()
        local busy = false
        for _, m in ipairs(Farm.Alive(nil, 3000)) do
            for _, it in ipairs(isl) do
                if Utils.Distance(m.root.Position, it.pos) <= 900 then busy = true; break end
            end
            if busy then break end
        end
        if not busy then Raid.MarkStale() end
    end
    if Raid.InRaid() then
        Raid.Say("Raid in progress")
        if not Raid.FragBase then Raid.FragBase = Shop.Funds("Fragments") end
        local fought = Raid.Fight()
        if fought then Raid.TimerOnly = 0 else Raid.TimerOnly = Raid.TimerOnly + 1 end
        if fought and State.AutoRaid then
            -- the raid is only finished when the Fragments went up
            local base = Raid.FragBase
            Raid.FragBase = nil
            local gained = nil
            if base then
                Raid.Say("Raid over: waiting for the Fragments")
                local t0 = os.clock()
                while os.clock() - t0 < 45 and State.Running and State.AutoRaid do
                    local f = Shop.Funds("Fragments")
                    if f and f > base then gained = f - base; break end
                    task.wait(1)
                end
            else
                Log("Raid: could not read Fragments, assuming the raid is complete", "WARN")
                task.wait(8)
                gained = 0
            end
            if not State.AutoRaid then return end
            Raid.DoneAt = os.clock()
            if gained or not Raid.TimerVisible() then Raid.MarkStale() end
            if gained then Raid.TimerOnly = 2 end   -- a timer that lingers after a finished raid is not a new raid   -- the next cycle buys a new chip instead of flying to island 5
            if gained then
                Raid.Done, Raid.Run = Raid.Done + 1, Raid.Run + 1
                Raid.Fails, Raid.FragFails = 0, 0
                Utils.Notify("Raid #" .. Raid.Run .. " complete" .. (gained > 0 and (" (+" .. Utils.Num(gained) .. " Fragments)") or ""), 5, "success")
                Log("Raid complete (#" .. Raid.Run .. ", Fragments +" .. tostring(gained) .. ")")
                Raid.Say("Raid complete, next raid")
                task.wait(3)
                if State.RaidLimit > 0 and Raid.Run >= State.RaidLimit then
                    raidStop("raid limit reached (" .. State.RaidLimit .. ")")
                end
            else
                Raid.FragFails = (Raid.FragFails or 0) + 1
                Log("Raid: Fragments did not go up after the raid (" .. Raid.FragFails .. "/3)", "WARN")
                if Raid.FragFails >= 3 then
                    raidStop("Fragments did not increase after 3 raids in a row")
                else
                    task.wait(3)
                end
            end
        end
        return
    end

    if not Raid.ChipTool() then
        local ok, why = Raid.FruitOk(State.RaidChip)
        if not ok then
            raidStop(why)
            return
        end
        if raidCancel() then return end
        Raid.SnapBase()
        local bought = Raid.BuyChip()   -- pays with a fruit if you have one, otherwise $100,000 Beli
        if not bought then
            Raid.Fails = Raid.Fails + 1
            Log("Raid: chip purchase failed (" .. Raid.Fails .. "/3)", "WARN")
            if Raid.Fails >= 3 then
                raidStop("could not buy a chip (talk to the Mysterious Scientist by hand and check System > log)")
            else
                task.wait(3)
            end
            return
        end
    end
    if raidCancel() then return end

    if Raid.Start() then
        Raid.Fails = 0
    else
        Raid.Fails = Raid.Fails + 1
        Log("Raid: start failed (" .. Raid.Fails .. "/3)", "WARN")
        if Raid.Fails >= 3 then
            raidStop("could not start the raid (check System > log)")
        else
            task.wait(3)
        end
    end
end

function Raid.Describe()
    if not State.AutoRaid then return "Off" end
    return Raid.Status
end

function Raid.Loop()
    Raid.WatchWarn()
    task.spawn(function()
        local wasOn = false
        while State.Running do
            task.wait(1)
            pcall(function()
                if not State.AutoRaid then
                    if wasOn then
                        wasOn = false
                        if Raid.Active then State.HoldCF, State.InCombat = nil, false end
                    end
                    Raid.Active = false
                    Raid.Status = "Off"
                    return
                end
                if not wasOn then
                    wasOn = true
                    Raid.Run, Raid.Fails, Raid.FragFails, Raid.WarnAt = 0, 0, 0, 0
                    Raid.SnapBase()
                end

                -- Sea 1 has no raids
                if State.Sea == 1 then
                    Raid.Active = false
                    Raid.Status = "No raids in Sea 1 yet"
                    raidNag(Raid.Msg.Sea1, "warn", 45)
                    return
                end
                if State.Sea ~= 2 and State.Sea ~= 3 then return end

                if Farm.Level() < RAID_MIN_LEVEL and not Raid.ChipTool() and not Raid.InRaid() then
                    Raid.Active = false
                    Raid.Status = "Raid chips need level " .. RAID_MIN_LEVEL .. " (you are " .. Farm.Level() .. ")"
                    raidNag("Raid chips need level " .. RAID_MIN_LEVEL .. "+ (you are level " .. Farm.Level() .. ")", "warn", 60)
                    return
                end
                if Paused() or State.Hopping or AutoSea.Running or Utils.EventBusy() then return end

                Raid.Active = true
                local ok, err = pcall(Raid.Cycle)
                if not ok then
                    Log("Raid error: " .. tostring(err), "WARN")
                    State.HoldCF, State.InCombat, State.Traveling = nil, false, false
                    task.wait(2)
                end
                if not State.AutoRaid then
                    Raid.Active = false
                    State.HoldCF, State.InCombat = nil, false
                end
            end)
        end
    end)
end

-- ============================================================
-- FACTORY  (Sea 2 event: the Core boss inside the Factory)
-- ============================================================
-- Auto Factory works together with Auto Farm: when the event shows up it takes the character, kills the Core with the
-- SELECTED weapon type (Farm > Loadout) and attack method (Combat), then gives control back to Auto Farm.
local FACTORY_POS = Vector3.new(448.5, 199.4, -441.4)   -- inside the Factory (Sea 2)
Factory.Active = false      -- true while Auto Factory controls the character (farm / boss / chest / fruit pause)
Factory.Mine = false        -- true only around Auto Factory's own flights
Factory.Status = "Off"
Factory.Done = 0
Factory.CoolUntil = 0

function Factory.Say(t)
    Factory.Status = t
    State.Status = "Auto Factory: " .. t
end

-- The event boss is a Humanoid model called "Core" in Workspace.Enemies while the Factory event runs
function Factory.Core()
    local en = Workspace:FindFirstChild("Enemies")
    local m = en and en:FindFirstChild("Core")
    if not m then return nil end
    local hum = m:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then return m, hum end
    return nil
end

local function factoryFly(target, tol, cancel)
    Factory.Mine = true
    local ok = Flight.To(target, tol, cancel)
    Factory.Mine = false
    return ok
end

function Factory.Release()
    Factory.Active, Factory.Mine = false, false
    State.HoldCF, State.InCombat, State.Traveling = nil, false, false
    State.TargetMob = "-"
    Farm.Epoch = (Farm.Epoch or 0) + 1      -- Auto Farm picks its target again after the event
    pcall(Farm.CountKills)
end

-- Returns true when the Core is gone (killed)
function Factory.Fight()
    local t0, lastSeen = os.clock(), os.clock()
    local safeUntil, fails = 0, 0
    local function stop() return (not State.Running) or (not State.AutoFactory) or Raid.Active end
    State.TargetMob = "Core"
    Factory.Say("Core spotted: heading to the Factory")
    task.wait(0.3)                          -- let the other loops let go of the character

    while not stop() do
        local now = os.clock()
        if Paused() or State.Hopping then return false end
        if now - t0 > 900 then
            Log("Factory: gave up after 15 min", "WARN")
            Factory.CoolUntil = now + 30
            return false
        end
        local hum, root = Utils.GetHumanoid(), Utils.GetRootPart()
        if not hum or not root or hum.Health <= 0 then return false end

        if Factory.Core() then lastSeen = now
        elseif now - lastSeen > 4 then return true end

        local mobs = Farm.Alive("Core", math.huge)
        if State.SafeHP > 0 and hum.MaxHealth > 0 and hum.Health / hum.MaxHealth * 100 < State.SafeHP and now > safeUntil then
            State.InCombat = false
            Factory.Say("Low HP: recovering")
            local up = root.Position + Vector3.new(0, 150, 0)
            factoryFly(up, 4, stop)
            State.HoldCF = CFrame.new(up)
            local r0 = os.clock()
            while not stop() and os.clock() - r0 < 15 do
                local h = Utils.GetHumanoid()
                if not h or h.Health <= 0 or h.Health / h.MaxHealth * 100 >= 70 then break end
                task.wait(0.5)
            end
            State.HoldCF = nil
            safeUntil = os.clock() + 20
        elseif #mobs > 0 then
            local c = mobs[1]
            Farm.Tracked[c.model] = c.hum
            local G = c.root.Position
            local H = G + Vector3.new(0, Farm.Hover(), 0)
            if Utils.Distance(root.Position, H) > 30 then
                State.InCombat, State.HoldCF = false, nil
                Factory.Say("flying to the Core")
                if not factoryFly(H, 3, stop) then
                    fails = fails + 1
                    if fails >= 4 then
                        Log("Factory: could not reach the Core", "WARN")
                        Factory.CoolUntil = os.clock() + 60
                        return false
                    end
                    task.wait(0.5)
                end
            end
            root = Utils.GetRootPart()
            if root and Utils.Distance(root.Position, H) < 40 then
                fails = 0
                State.HoldCF = lookCF(H, G)
                State.InCombat = true
                Factory.Say("fighting the Core (" .. tostring(State.WeaponType) .. " · " .. tostring(State.AttackMode) .. ")")
            end
        else
            -- the Core exists but is not loaded around us yet: go to the Factory so it streams in
            State.InCombat = false
            if Utils.Distance(root.Position, FACTORY_POS) > 60 then
                State.HoldCF = nil
                Factory.Say("flying to the Factory")
                if not factoryFly(FACTORY_POS, 5, stop) then
                    fails = fails + 1
                    if fails >= 4 then
                        Factory.CoolUntil = os.clock() + 60
                        return false
                    end
                    task.wait(0.5)
                end
            else
                State.HoldCF = CFrame.new(FACTORY_POS)
                Factory.Say("waiting for the Core to load")
            end
        end
        task.wait(0.1)
        Farm.CountKills()
    end
    return false
end

function Factory.Describe()
    if not State.AutoFactory then return "Off" end
    return Factory.Status
end

function Factory.Loop()
    task.spawn(function()
        while State.Running do
            task.wait(1.5)
            pcall(function()
                if not State.AutoFactory then
                    if Factory.Active then Factory.Release() end
                    Factory.Status = "Off"
                    return
                end
                if State.Sea ~= 2 then Factory.Status = "The Factory event exists only in Sea 2"; return end
                if Raid.Active or CakeP.Active or AutoSea.Running or Paused() or State.Hopping then
                    Factory.Status = "Waiting (another task is running)"
                    return
                end
                if os.clock() < Factory.CoolUntil then return end
                if not Factory.Core() then Factory.Status = "Waiting for the Factory event"; return end

                Factory.Active = true
                local ok, res = pcall(Factory.Fight)
                Factory.Release()
                if not ok then
                    Log("Factory error: " .. tostring(res), "WARN")
                    task.wait(2)
                elseif res then
                    Factory.Done = Factory.Done + 1
                    Factory.Status = "Core defeated (#" .. Factory.Done .. ")"
                    Log("Factory: Core defeated (#" .. Factory.Done .. ")")
                    Utils.Notify("Factory Core defeated", 5, "success")
                end
            end)
        end
    end)
end

-- ============================================================
-- CAKE PRINCE  (Sea 3 only)
-- ============================================================
-- How the game works (Blox Fruits Fandom wiki: Cake Prince / Dimensional Shift):
--   1) kill 500 enemies on Cake Land. The count is per SERVER and cumulative: every player in the server adds to it.
--   2) talk to drip_mama (house behind the Cake Quest giver). When 500 are reached she asks "Do you want to open the portal now?".
--   3) the portal is the big mirror behind her house. Inside the Dimensional Shift the Cake Prince spawns (gone after ~7.5 min).
--   A Sweet Chalice in hand makes her open the stronger dimension with the Dough King instead, so this feature never equips one.
-- Auto Cake Prince loops: farm Cake Land mobs -> drip_mama -> mirror -> kill Cake Prince -> repeat.
-- The kill counter (x/500) is read from the server through the same remote drip_mama uses and is shown in every server you join.
-- If the server reply cannot be read, the counter falls back to the kills this script made itself.
CakeP.NEED = 500
CakeP.MOBS = {"Cookie Crafter", "Cake Guard", "Baking Staff", "Head Baker"}   -- the Cake Land enemies
CakeP.LAND = Vector3.new(-1975, 40, -12430)       -- middle of Cake Land (between the two quest givers)
CakeP.NPC_POS = Vector3.new(-2022, 40, -12031)    -- fallback place for drip_mama (next to the Cake Quest giver)
CakeP.Skip = setmetatable({}, {__mode = "k"})   -- mobs that take no damage: ignored for a while
CakeP.NoPullUntil = 0
CakeP.PULL_R = 700        -- pull radius around the gather point
CakeP.PullAt = nil
CakeP.Active = false      -- true while Auto Cake Prince controls the character (farm / boss / chest / fruit pause)
CakeP.Mine = false        -- true only around its own flights
CakeP.Status = "Off"
CakeP.Done = 0            -- Cake Princes defeated this session
CakeP.Killed = nil        -- kills in THIS server according to the server (nil = unknown)
CakeP.Ready = false       -- server says the portal can be opened
CakeP.PollOK = false
CakeP.LastPoll = 0
CakeP.LastReply = ""
CakeP.LastSummon = ""
CakeP.CoolUntil = 0
CakeP.TrySummonAt = 0
CakeP.SafeUntil = 0
CakeP.Fails = 0
CakeP.NpcCache, CakeP.NpcScanAt = nil, 0
CakeP.G, CakeP.GName = nil, nil
CakeP.JobId = nil

function CakeP.Say(t)
    CakeP.Status = t
    State.Status = "Auto Cake Prince: " .. t
end

function CakeP.Fly(target, tol, cancel)
    CakeP.Mine = true
    local ok = Flight.To(target, tol, cancel)
    CakeP.Mine = false
    return ok
end

-- kills made by this script on Cake Land mobs (fallback counter)
function CakeP.LocalKills()
    local n = 0
    for _, name in ipairs(CakeP.MOBS) do n = n + Farm.KillsFor(name) end
    return n
end

-- (kills, source text)
function CakeP.Count()
    if CakeP.BossUp and CakeP.BossUp() then return CakeP.NEED, "Cake Prince is out" end
    if CakeP.Killed then
        -- the server reply can stay frozen (e.g. at 498) while kills keep coming: add my own kills made since that reply
        local extra = math.max(0, CakeP.LocalKills() - (CakeP.BaseLocal or CakeP.LocalKills()))
        return math.clamp(CakeP.Killed + extra, 0, CakeP.NEED), "server count"
    end
    return math.min(CakeP.LocalKills(), CakeP.NEED), "only my kills: server count unreadable"
end

function CakeP.IsReady()
    if CakeP.Ready then return true end
    -- server reply unreadable but I killed enough myself: try to open the portal now and then
    return CakeP.Killed == nil and CakeP.LocalKills() >= CakeP.NEED and os.clock() >= CakeP.TrySummonAt
end

-- Reads the reply of drip_mama. Known texts: "...500 enemies must be defeated on Cake Land..." (with the remaining number)
-- and "We have defeated enough enemies. Do you want to open the portal now?" when the portal can be opened.
function CakeP.Parse(res)
    if res == nil then return end
    local s = tostring(res)
    CakeP.LastReply = s
    CakeP.BaseLocal = CakeP.LocalKills()
    local low = s:lower()
    if low:find("open the portal", 1, true) or low:find("defeated enough", 1, true) then
        CakeP.Ready, CakeP.Killed = true, CakeP.NEED
        return
    end
    local n = tonumber(low:match("(%d+)"))
    if not n then return end
    CakeP.Ready = false
    local remaining
    if low:find("more", 1, true) or low:find("remain", 1, true) or low:find("left", 1, true)
        or low:find("must", 1, true) or low:find("need", 1, true) then
        remaining = n
    elseif low:find("defeated", 1, true) or low:find("killed", 1, true) then
        CakeP.Killed = math.clamp(n, 0, CakeP.NEED)
        return
    else
        remaining = n
    end
    CakeP.Killed = math.clamp(CakeP.NEED - remaining, 0, CakeP.NEED)
end

function CakeP.Poll(force)
    if State.Sea ~= 3 or State.RateLimit then return end
    if not force and os.clock() - CakeP.LastPoll < 8 then return end
    CakeP.LastPoll = os.clock()
    local ok, res = Utils.InvokeEx("CakePrinceSpawner", true)
    CakeP.PollOK = ok and res ~= nil
    if CakeP.PollOK then pcall(CakeP.Parse, res) end
    if CakeP.Boss() then CakeP.Killed = CakeP.NEED end      -- Cake Prince spawned: the counter is full whatever the reply says
end

-- cheap "is the Cake Prince out?" (cached 1.5 s) used while flying / farming so the script can drop everything and go
function CakeP.BossUp()
    if os.clock() - (CakeP.BUAt or 0) > 1.5 then
        CakeP.BUAt = os.clock()
        CakeP.BUVal = CakeP.Boss() ~= nil
    end
    return CakeP.BUVal
end

-- drip_mama (cached; the full search only runs now and then)
function CakeP.Npc()
    if CakeP.NpcCache and CakeP.NpcCache.Parent then return CakeP.NpcCache end
    CakeP.NpcCache = nil
    local npcs = Workspace:FindFirstChild("NPCs")
    local m = npcs and npcs:FindFirstChild("drip_mama")
    if not m and os.clock() - CakeP.NpcScanAt > 15 then
        CakeP.NpcScanAt = os.clock()
        for _, d in ipairs(Workspace:GetDescendants()) do
            if d:IsA("Model") and d.Name:lower() == "drip_mama" then m = d; break end
        end
    end
    CakeP.NpcCache = m
    return m
end

function CakeP.NpcPos()
    local m = CakeP.Npc()
    local r = m and Utils.ModelRoot(m)
    return r and r.Position or CakeP.NPC_POS
end

-- Parts that appear in the workspace right after drip_mama opens the portal (the portal / mirror is created then)
function CakeP.Watch(on)
    if CakeP.WConn then pcall(function() CakeP.WConn:Disconnect() end); CakeP.WConn = nil end
    CakeP.NewParts = {}
    if on then
        CakeP.WConn = Workspace.DescendantAdded:Connect(function(d)
            if #CakeP.NewParts < 600 and d:IsA("BasePart") then table.insert(CakeP.NewParts, d) end
        end)
    end
end

function CakeP.Bad(p)
    local en = Workspace:FindFirstChild("Enemies")
    if en and p:IsDescendantOf(en) then return true end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character and p:IsDescendantOf(pl.Character) then return true end
    end
    return false
end

-- the portal (big mirror behind her house): best effort. Candidates: parts called mirror / portal / dimension / shift near
-- drip_mama, and big parts that appeared after the summon.
function CakeP.FindMirror()
    local base = CakeP.NpcPos()
    local best, bs
    local function consider(p, bonus)
        if not p.Parent or CakeP.Bad(p) then return end
        local d = Utils.Distance(p.Position, base)
        if d > 450 then return end
        local sz = p.Size.X * p.Size.Y * p.Size.Z
        local score = bonus + math.min(sz, 4000) / 40 - d / 10
        if not bs or score > bs then best, bs = p, score end
    end
    pcall(function()
        for _, p in ipairs(Workspace:GetPartBoundsInRadius(base, 450)) do
            local n = p.Name:lower()
            if n:find("mirror", 1, true) or n:find("portal", 1, true) or n:find("dimension", 1, true) or n:find("shift", 1, true) then
                consider(p, 100)
            end
        end
    end)
    for _, p in ipairs(CakeP.NewParts or {}) do
        if p.Parent and p.Size.Magnitude >= 12 then consider(p, 40) end
    end
    return best
end

-- Cake Prince model that is alive: first in Workspace.Enemies (loaded), then in ReplicatedStorage (spawned but not streamed in
-- yet because we are far away: the game keeps such bosses there), then the slow full search after the portal request.
function CakeP.Boss()
    local en = Workspace:FindFirstChild("Enemies")
    if en then
        for _, m in ipairs(en:GetChildren()) do
            if m.Name:lower():find("cake prince", 1, true) then
                local hum = m:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then return m, hum end
            end
        end
    end
    -- spawned but far away (not streamed in): the model sits in ReplicatedStorage, fly to its position
    local okRS, rsM, rsH = pcall(function()
        for _, m in ipairs(ReplicatedStorage:GetChildren()) do
            if m:IsA("Model") and m.Name:lower():find("cake prince", 1, true) then
                local hum = m:FindFirstChildOfClass("Humanoid")
                local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
                if r and (not hum or hum.Health > 0) then return m, hum end
            end
        end
    end)
    if okRS and rsM then return rsM, rsH end
    -- the dimension may keep it somewhere else: slow search over the whole workspace every 3 s (name contains "cake prince")
    if CakeP.Scan and os.clock() - (CakeP.BossScanAt or 0) > 3 then
        CakeP.BossScanAt = os.clock()
        CakeP.BossFound = nil
        pcall(function()
            for _, d in ipairs(Workspace:GetDescendants()) do
                if d:IsA("Humanoid") and d.Health > 0 then
                    local m = d.Parent
                    if m and m:IsA("Model") and m.Name:lower():find("cake prince", 1, true) then
                        CakeP.BossFound = m
                        break
                    end
                end
            end
        end)
    end
    local m = CakeP.BossFound
    if m and m.Parent then
        local hum = m:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then return m, hum end
    end
    return nil
end

-- true when the character was teleported far away from Cake Land (= inside the Dimensional Shift)
function CakeP.InDimension()
    if CakeP.Jumped then return true end
    local root = Utils.GetRootPart()
    return root ~= nil and Utils.Distance(root.Position, CakeP.NpcPos()) > 900
end

function CakeP.Release()
    CakeP.Active, CakeP.Mine = false, false
    CakeP.Scan, CakeP.Jumped, CakeP.BossFound = false, false, nil
    CakeP.Watch(false)
    State.HoldCF, State.InCombat, State.Traveling = nil, false, false
    State.GatherPoint, State.GatherName = nil, nil
    State.TargetMob = "-"
    CakeP.G, CakeP.GName, CakeP.PullAt = nil, nil, nil
    Farm.Epoch = (Farm.Epoch or 0) + 1      -- Auto Farm picks its target again afterwards
    pcall(Farm.CountKills)
end

-- Low HP: fly up and wait. Returns true when it did something.
function CakeP.Recover(stop)
    local hum, root = Utils.GetHumanoid(), Utils.GetRootPart()
    if State.SafeHP <= 0 or not hum or not root or hum.MaxHealth <= 0 then return false end
    if hum.Health / hum.MaxHealth * 100 >= State.SafeHP or os.clock() < CakeP.SafeUntil then return false end
    State.InCombat, State.GatherPoint = false, nil
    CakeP.Say("Low HP: recovering")
    local up = root.Position + Vector3.new(0, 150, 0)
    CakeP.Fly(up, 4, stop)
    State.HoldCF = CFrame.new(up)
    local r0 = os.clock()
    while not stop() and os.clock() - r0 < 15 do
        local h = Utils.GetHumanoid()
        if not h or h.Health <= 0 or h.Health / h.MaxHealth * 100 >= 70 then break end
        task.wait(0.5)
    end
    State.HoldCF = nil
    CakeP.SafeUntil = os.clock() + 20
    return true
end

-- alive Cake Land mobs, nearest first
function CakeP.Mobs()
    local list = {}
    for _, n in ipairs(CakeP.MOBS) do
        for _, m in ipairs(Farm.Alive(n, math.huge, false)) do
            local sk = CakeP.Skip[m.model]
            if not sk or sk < os.clock() then table.insert(list, m) end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

-- one step of "kill Cake Land mobs"
function CakeP.FarmStep(stop)
    local root = Utils.GetRootPart()
    if not root then return end
    local mobs = CakeP.Mobs()

    if #mobs == 0 then
        -- No Cake Land mob is loaded around us (mobs far away are not streamed in, and the ones here are dead).
        -- Tour ALL Cake Land spawns: go to the nearest spawn we did not check lately; if nothing shows up within
        -- ~2.5 s there, mark it as checked and move on to the next one.
        State.InCombat, State.GatherPoint = false, nil
        CakeP.G, CakeP.GName, CakeP.PullAt = nil, nil, nil
        CakeP.Visited = CakeP.Visited or {}
        local now = os.clock()
        local cands = {}
        for _, n in ipairs(CakeP.MOBS) do
            for _, sp in ipairs(Farm.SpawnsFor(n)) do
                local key = math.floor(sp.X / 40) .. ":" .. math.floor(sp.Z / 40)
                local seen = false
                for _, c in ipairs(cands) do if c.key == key then seen = true; break end end
                if not seen then table.insert(cands, {pos = sp, key = key}) end
            end
        end
        if #cands == 0 then table.insert(cands, {pos = CakeP.LAND, key = "land"}) end
        local pick, pd
        for _, c in ipairs(cands) do
            local t = CakeP.Visited[c.key]
            if not t or now - t > 12 then
                local d = Utils.Distance(root.Position, c.pos)
                if not pd or d < pd then pick, pd = c, d end
            end
        end
        if not pick then CakeP.Visited = {}; pick = cands[1] end
        local H = pick.pos + Vector3.new(0, Farm.Hover(), 0)
        if Utils.Distance(root.Position, H) > 40 then
            State.HoldCF = nil
            CakeP.ArriveAt = nil
            CakeP.Say("flying to the next Cake Land spawn")
            if CakeP.Fly(H, 4, stop) then
                CakeP.Fails = 0
            elseif not stop() then
                CakeP.Fails = CakeP.Fails + 1
                CakeP.Visited[pick.key] = now      -- unreachable: skip it for a while
                task.wait(0.5)
            end
        else
            State.HoldCF = CFrame.new(H)
            CakeP.ArriveAt = CakeP.ArriveAt or now
            CakeP.Say("waiting for Cake Land mobs at this spawn")
            if now - CakeP.ArriveAt > 1.0 then
                CakeP.Visited[pick.key] = now
                CakeP.ArriveAt = nil
            end
            task.wait(0.2)
        end
        return
    end

    for _, m in ipairs(mobs) do Farm.Tracked[m.model] = m.hum end
    local now0 = os.clock()
    local gather = State.BringMobs and now0 > CakeP.NoPullUntil
    local G
    if gather then
        -- only mobs with the SAME NAME as the nearest one are pulled (big radius) to one point and die together; the point
        -- stays until none of that name is left near it, then the nearest mob (any type) decides the next name/point
        local keep = false
        if CakeP.G and CakeP.GName then
            for _, m in ipairs(mobs) do
                if cleanName(m.model.Name) == CakeP.GName and Utils.Distance(m.root.Position, CakeP.G) <= CakeP.PULL_R then keep = true; break end
            end
        end
        if not keep then
            CakeP.G = mobs[1].root.Position
            CakeP.GName = cleanName(mobs[1].model.Name)
            CakeP.PullAt = nil
        end
        G = CakeP.G
    else
        G = mobs[1].root.Position
        CakeP.G = nil
    end

    local H = G + Vector3.new(0, Farm.Hover(), 0)
    if Utils.Distance(root.Position, H) > (gather and 14 or 30) then
        State.InCombat, State.HoldCF, State.GatherPoint = false, nil, nil
        CakeP.PullAt = nil
        CakeP.Say("flying to " .. cleanName(mobs[1].model.Name))
        if CakeP.Fly(H, 3, stop) then
            CakeP.Fails = 0
        elseif not stop() then
            CakeP.Fails = CakeP.Fails + 1
        end
    end
    root = Utils.GetRootPart()
    if root and Utils.Distance(root.Position, H) < 40 then
        -- stuck checks: (a) the nearest mob takes no damage -> skip it, (b) pulling does not bring anything -> hit one by one
        local now = os.clock()
        local tgt = mobs[1]
        local rec = CakeP.HPRec
        if not rec or rec.m ~= tgt.model then
            CakeP.HPRec = {m = tgt.model, hp = tgt.hum.Health, t = now}
        elseif tgt.hum.Health < rec.hp - 0.5 or Utils.Distance(root.Position, tgt.root.Position) > 80 then
            rec.hp, rec.t = tgt.hum.Health, now
        elseif now - rec.t > 5 then
            CakeP.Skip[tgt.model] = now + 30
            CakeP.HPRec, CakeP.G, CakeP.PullAt, CakeP.PullSince = nil, nil, nil, nil
            State.GatherPoint = nil
            Log("Cake Prince: a mob takes no damage -> skipping it for 30 s", "WARN")
            return
        end
        if gather then
            if CakeP.PullFor ~= G then CakeP.PullFor, CakeP.PullSince = G, now end
            if now - (CakeP.PullSince or now) > 3 and #mobs > 1 then
                local near = 0
                local same = 0
                for _, m in ipairs(mobs) do
                    if m.model ~= tgt.model and cleanName(m.model.Name) == CakeP.GName then same = same + 1 end
                end
                for _, m in ipairs(mobs) do
                    if m.model ~= tgt.model and cleanName(m.model.Name) == CakeP.GName and Utils.Distance(m.root.Position, G) <= 25 then near = near + 1 end
                end
                if near == 0 and same > 0 then
                    CakeP.NoPullUntil = now + 45
                    CakeP.G, CakeP.PullAt, CakeP.PullSince, CakeP.PullFor = nil, nil, nil, nil
                    State.GatherPoint = nil
                    Log("Cake Prince: mobs are not being pulled -> hitting them one by one for 45 s", "WARN")
                    return
                end
            end
        end
        State.HoldCF = lookCF(H, G)
        State.InCombat = true
        State.TargetMob = "-"
        if gather then
            CakeP.PullAt = G
            State.GatherPoint, State.GatherName = G, nil     -- keeps the simulation radius maxed; the pulling is done by CakeP.PullInit
        else
            CakeP.PullAt, State.GatherPoint = nil, nil
        end
        local k = CakeP.Count()
        CakeP.Say(string.format("killing Cake Land mobs (%d/%d)", k, CakeP.NEED))
    end
end

-- fly to drip_mama and open the portal. Returns true when the request was sent.
function CakeP.Summon(stop)
    local t0 = os.clock()
    CakeP.Say("flying to drip_mama")
    while not stop() and os.clock() - t0 < 60 do
        local root = Utils.GetRootPart()
        if not root then return false end
        local H = CakeP.NpcPos() + Vector3.new(0, 4, 0)
        if Utils.Distance(root.Position, H) > 14 then
            State.InCombat, State.HoldCF, State.GatherPoint = false, nil, nil
            CakeP.Fly(H, 4, stop)
        else
            State.HoldCF = CFrame.new(H)
            CakeP.Say("opening the portal at drip_mama")
            CakeP.Watch(true)
            CakeP.Scan = true      -- full-workspace boss search only after the portal request (it is heavy)
            local ok, res = Utils.InvokeEx("CakePrinceSpawner")
            CakeP.LastSummon = ok and tostring(res) or ("error: " .. tostring(res))
            Log("Cake Prince: drip_mama reply: " .. CakeP.LastSummon)
            CakeP.TrySummonAt = os.clock() + 30
            CakeP.Ready, CakeP.Killed = false, nil
            task.wait(1.5)
            State.HoldCF = nil
            return true
        end
        task.wait(0.2)
    end
    return false
end

-- after the portal is open: walk into it until the Cake Prince is there
function CakeP.Enter(stop)
    local t0, lastScan, mirror = os.clock(), -math.huge, nil
    local sweepI, sweepAt = 0, 0
    local ringR = {30, 60, 100}
    local lastPos, logged, listed = nil, nil, false
    CakeP.Jumped = false
    while not stop() and os.clock() - t0 < 150 do
        if CakeP.Boss() then return true end
        local root = Utils.GetRootPart()
        if not root then return false end
        State.InCombat = false
        -- a sudden big position change = the portal teleported us
        if lastPos and not CakeP.Jumped and Utils.Distance(root.Position, lastPos) > 250 and not State.Traveling then
            CakeP.Jumped = true
            Log("Cake Prince: teleported into the dimension at " .. tostring(root.Position))
        end
        lastPos = root.Position

        if CakeP.InDimension() then
            -- inside the Dimensional Shift: wait until the boss streams in
            CakeP.Say("inside the Dimensional Shift: looking for the Cake Prince")
            State.HoldCF = nil
            if not listed and os.clock() - t0 > 6 then
                -- diagnostics: which living humanoids are around (so the boss name can be checked in the log)
                listed = true
                local names, n = {}, 0
                pcall(function()
                    for _, d in ipairs(Workspace:GetDescendants()) do
                        if d:IsA("Humanoid") and d.Health > 0 and d.Parent and not Players:GetPlayerFromCharacter(d.Parent) then
                            n = n + 1
                            if n <= 8 then table.insert(names, d.Parent.Name) end
                        end
                    end
                end)
                Log("Cake Prince: in the dimension, living NPCs: " .. n .. " [" .. table.concat(names, ", ") .. "]")
            end
            task.wait(0.5)
        else
            if os.clock() - lastScan > 4 then
                lastScan = os.clock()
                mirror = CakeP.FindMirror()
            end
            local base = CakeP.NpcPos()
            if mirror and mirror.Parent then
                if logged ~= mirror then
                    logged = mirror
                    Log("Cake Prince: portal candidate: " .. mirror.Name .. " at " .. tostring(mirror.Position))
                end
                CakeP.Say("walking into the portal")
                local target = mirror.Position
                if Utils.Distance(root.Position, target) > 5 then
                    CakeP.Fly(target, 3, stop)
                else
                    -- standing in it: wiggle through, some portals need a real touch
                    CakeP.Fly(target + Vector3.new(4, 0, 0), 2, stop)
                    CakeP.Fly(target - Vector3.new(4, 0, 0), 2, stop)
                end
            else
                -- portal not found by name: sweep rings around (and behind) drip_mama, the touch teleports us
                CakeP.Say("searching the portal around drip_mama")
                sweepI = sweepI + 1
                local ang = ((sweepI - 1) % 8) * (math.pi / 4)
                local r = ringR[(math.floor((sweepI - 1) / 8) % #ringR) + 1]
                local pt = base + Vector3.new(math.cos(ang) * r, 3, math.sin(ang) * r)
                CakeP.Fly(pt, 3, stop)
            end
        end
        task.wait(0.3)
    end
    State.HoldCF = nil
    return CakeP.Boss() ~= nil
end

-- Returns true when the Cake Prince is gone (killed)
function CakeP.FightBoss(stop)
    local t0, lastSeen, fails = os.clock(), os.clock(), 0
    State.TargetMob = "Cake Prince"
    State.GatherPoint = nil
    CakeP.Say("Cake Prince spotted")
    while not stop() do
        local now = os.clock()
        if Paused() or State.Hopping then return false end
        if now - t0 > 540 then
            Log("Cake Prince: gave up after 9 min", "WARN")
            CakeP.CoolUntil = now + 30
            return false
        end
        local hum, root = Utils.GetHumanoid(), Utils.GetRootPart()
        if not hum or not root or hum.Health <= 0 then return false end

        local boss, bhum = CakeP.Boss()
        if boss then lastSeen = now elseif now - lastSeen > 4 then return true end

        if CakeP.Recover(stop) then
            -- recovered, next round
        elseif boss then
            local broot = Utils.ModelRoot(boss)
            if broot then
                Farm.Tracked[boss] = bhum
                local G = broot.Position
                local H = G + Vector3.new(0, Farm.Hover(), 0)
                if Utils.Distance(root.Position, H) > 30 then
                    State.InCombat, State.HoldCF = false, nil
                    CakeP.Say("flying to the Cake Prince")
                    if CakeP.Fly(H, 3, stop) then
                        fails = 0
                    elseif not stop() then
                        fails = fails + 1
                        if fails >= 4 then
                            Log("Cake Prince: could not reach the boss", "WARN")
                            CakeP.CoolUntil = os.clock() + 60
                            return false
                        end
                        task.wait(0.5)
                    end
                end
                root = Utils.GetRootPart()
                if root and Utils.Distance(root.Position, H) < 40 then
                    fails = 0
                    State.HoldCF = lookCF(H, G)
                    State.InCombat = true
                    CakeP.Say("fighting the Cake Prince (" .. tostring(State.WeaponType) .. " · " .. tostring(State.AttackMode) .. ")")
                end
            end
        end
        task.wait(0.1)
        Farm.CountKills()
    end
    return false
end

-- one full run. Returns true when a Cake Prince was killed.
function CakeP.Cycle()
    local function stop() return (not State.Running) or (not State.AutoCakePrince) or Raid.Active or Factory.Active end
    State.TargetMob = "-"
    CakeP.Fails = 0
    task.wait(0.3)                          -- let the other loops let go of the character
    while not stop() do
        if Paused() or State.Hopping then return false end
        local hum, root = Utils.GetHumanoid(), Utils.GetRootPart()
        if not hum or not root or hum.Health <= 0 then return false end

        if CakeP.Boss() then return CakeP.FightBoss(stop) end   -- already out (another player opened it)

        CakeP.Poll()
        if CakeP.Recover(stop) then
            -- recovered, next round
        elseif CakeP.IsReady() then
            if not CakeP.Summon(stop) then return false end
            if CakeP.Enter(stop) then return CakeP.FightBoss(stop) end
            if not stop() then
                Log("Cake Prince: the portal did not lead to a boss (reply: " .. tostring(CakeP.LastSummon) .. ")", "WARN")
                CakeP.CoolUntil = os.clock() + 20
            end
            return false
        else
            CakeP.FarmStep(function() return stop() or CakeP.BossUp() end)
            if CakeP.Fails >= 4 then
                Log("Cake Prince: could not reach Cake Land", "WARN")
                CakeP.CoolUntil = os.clock() + 30
                return false
            end
        end
        task.wait(0.1)
        Farm.CountKills()
    end
    return false
end

function CakeP.Describe()
    if State.Sea ~= 3 then return "Sea 3 only" end
    if not State.AutoCakePrince then return "Off" end
    return CakeP.Status
end

-- Pulls the Cake Land mobs that have the same name as the current group (CakeP.GName) within PULL_R onto the gather point
function CakeP.PullInit()
    table.insert(State.Connections, RunService.Heartbeat:Connect(function()
        local p, want = CakeP.PullAt, CakeP.GName
        if not p or not want or not CakeP.Active then return end
        for model, hum in pairs(Registry.Mobs) do
            if model.Parent and hum.Health > 0 and not Farm.IsUnpullable(model) and Farm.IsFarmable(model) then
                local nm = cleanName(model.Name)
                if nm:lower() == want:lower() then
                    local root = model:FindFirstChild("HumanoidRootPart")
                    if root and Utils.Distance(root.Position, p) < CakeP.PULL_R and Farm.Owned(root) then
                        local slot = Farm.SlotOf(model)
                        local ang = slot * 2.399963
                        local rad = 1 + 0.9 * math.sqrt(slot)
                        root.CFrame = CFrame.new(p + Vector3.new(math.cos(ang) * rad, 0, math.sin(ang) * rad))
                        root.AssemblyLinearVelocity = ZERO
                        root.AssemblyAngularVelocity = ZERO
                        root.CanCollide = false
                        hum.WalkSpeed = 0
                        hum.AutoRotate = false
                    end
                end
            end
        end
    end))
end

function CakeP.Loop()
    pcall(CakeP.PullInit)
    task.spawn(function()
        local announced = false
        while State.Running do
            task.wait(1.5)
            pcall(function()
                if State.Sea ~= 3 then CakeP.Status = "Sea 3 only"; return end
                -- the counter is read in every server you enter, even when the toggle is off
                CakeP.Poll()
                if not announced and CakeP.PollOK then
                    announced = true
                    local k, src = CakeP.Count()
                    Utils.Notify("Cake Prince: " .. k .. "/" .. CakeP.NEED .. " mobs killed in this server", 6, "info")
                    Log("Cake Prince: " .. k .. "/" .. CakeP.NEED .. " (" .. src .. "), drip_mama reply: " .. tostring(CakeP.LastReply))
                end
                if not State.AutoCakePrince then
                    if CakeP.Active then CakeP.Release() end
                    CakeP.Status = "Off"
                    return
                end
                if Raid.Active or Factory.Active or AutoSea.Running or Paused() or State.Hopping then
                    CakeP.Status = "Waiting (another task is running)"
                    return
                end
                if os.clock() < CakeP.CoolUntil then return end

                CakeP.Active = true
                local ok, res = pcall(CakeP.Cycle)
                CakeP.Release()
                if not ok then
                    Log("Cake Prince error: " .. tostring(res), "WARN")
                    task.wait(2)
                elseif res then
                    CakeP.Done = CakeP.Done + 1
                    CakeP.Killed, CakeP.Ready = nil, false
                    CakeP.LastPoll = 0
                    CakeP.Status = "Cake Prince defeated (#" .. CakeP.Done .. ")"
                    Log("Cake Prince defeated (#" .. CakeP.Done .. ")")
                    Utils.Notify("Cake Prince defeated", 5, "success")
                end
            end)
        end
    end)
end

-- refreshes the Cake Prince card (visible only in Sea 3)
function CakeP.UpdateUI()
    if UI.CakeBox then UI.CakeBox.Visible = (State.Sea == 3) end
    if State.Sea ~= 3 then return end
    local k, src = CakeP.Count()
    if UI.CakeBar then UI.CakeBar.Size = UDim2.new(math.clamp(k / CakeP.NEED, 0, 1), 0, 1, 0) end
    if UI.CakeInfo then
        UI.CakeInfo.Text = string.format("Mobs killed in this server: %d / %d  (%s)%s\nStatus: %s%s",
            k, CakeP.NEED, src, CakeP.Ready and "  ·  PORTAL READY" or "", CakeP.Describe(),
            CakeP.Done > 0 and ("\nCake Prince defeated: " .. CakeP.Done) or "")
    end
end


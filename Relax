function UI.Build()
    local parent = Utils.GuiParent()
    local sg
    local ok = pcall(function()
        for _, n in ipairs({"RelaxHub_GUI", "BFPRO_GUI"}) do
            local old = parent:FindFirstChild(n)
            if old then old:Destroy() end
        end
        sg = Instance.new("ScreenGui")
        sg.Name = "RelaxHub_GUI"
        sg.ResetOnSpawn = false
        sg.DisplayOrder = 999
        sg.IgnoreGuiInset = true
        sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        sg.Parent = parent
    end)
    if not ok or not sg then Log("Could not create ScreenGui", "WARN"); return end
    UI.Gui = sg

    -- Notifications
    local nbox = mk("Frame", {Size = UDim2.new(0, 240, 0, 210), Position = UDim2.new(1, -250, 0, 50),
        BackgroundTransparency = 1, ZIndex = 200}, sg)
    mk("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}, nbox)
    UI.NotifBox = nbox
    Utils._NotifyFn = function(m, d, k) UI.ShowNotification(m, d, k) end

    -- Size (compact)
    local vp = viewport()
    UI.BaseW = math.clamp(math.floor(vp.X * 0.62), 340, 480)
    UI.BaseH = math.clamp(math.floor(vp.Y * 0.72), 280, 340)
    local f0 = math.clamp(State.WinScale / 100, 0.6, 1)
    UI.W, UI.H = math.floor(UI.BaseW * f0), math.floor(UI.BaseH * f0)
    local compact = UI.BaseW < 420
    local sideW = compact and 44 or 94
    local HD, FT = UI.HEADER, UI.FOOT

    local mf = mk("Frame", {Name = "Main", BackgroundColor3 = T.Bg, BorderSizePixel = 0, ClipsDescendants = true,
        Size = UDim2.fromOffset(UI.W, UI.H),
        Position = UDim2.fromOffset(math.max(0, (vp.X - UI.W) / 2), math.max(0, (vp.Y - UI.H) / 2))}, sg)
    corner(mf, 12); stroke(mf, T.Border, 1)

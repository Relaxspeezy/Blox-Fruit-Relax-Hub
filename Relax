local enemiesCache
function Farm.EnemiesFolder()
    if enemiesCache and enemiesCache.Parent then return enemiesCache end
    enemiesCache = Workspace:FindFirstChild("Enemies")
    return enemiesCache
end

function Farm.IsFarmable(model)
    if model == LocalPlayer.Character or Players:GetPlayerFromCharacter(model) then return false end
    local enemies = Farm.EnemiesFolder()
    if enemies then return model:IsDescendantOf(enemies) end
    local npcs = Workspace:FindFirstChild("NPCs")
    if npcs and model:IsDescendantOf(npcs) then return false end
    return true
end

function Farm.Level()
    local ok, v = pcall(function() return LocalPlayer.Data.Level.Value end)
    return ok and tonumber(v) or 1
end

function Farm.NameIs(modelName, target, loose)
    if loose then return Utils.Has(modelName, target) end
    return cleanName(modelName):lower() == target:lower()
end

local spawnCache, spawnCacheT = nil, 0
function Farm.Spawns()
    if spawnCache and os.clock() - spawnCacheT < 20 then return spawnCache end
    local list = {}
    pcall(function()
        local wo = Workspace:FindFirstChild("_WorldOrigin")
        local f = wo and wo:FindFirstChild("EnemySpawns")
        if not f then return end
        for _, c in ipairs(f:GetChildren()) do
            local pos
            if c:IsA("BasePart") then pos = c.Position
            elseif c:IsA("Model") then
                local r = Utils.ModelRoot(c)
                pos = r and r.Position
            end
            if pos then table.insert(list, {name = c.Name, pos = pos}) end
        end
    end)
    spawnCache, spawnCacheT = list, os.clock()
    return list
end

function Farm.InvalidateSpawns() spawnCache = nil end

function Farm.SpawnMobNames()
    local seen, names = {}, {}
    for _, s in ipairs(Farm.Spawns()) do
        local n = cleanName(s.name)
        if n ~= "" and not seen[n] then seen[n] = true; table.insert(names, n) end
    end
    table.sort(names)
    return names
end

-- Spawn positions for this mob (near to far). Falls back to partial name match.
function Farm.SpawnsFor(mob)
    local my = Utils.GetPos()
    local exact, loose = {}, {}
    for _, s in ipairs(Farm.Spawns()) do
        if Farm.NameIs(s.name, mob, false) then table.insert(exact, s.pos)
        elseif Utils.Has(s.name, mob) then table.insert(loose, s.pos) end
    end
    local list = #exact > 0 and exact or loose
    table.sort(list, function(a, b) return Utils.Distance(my, a) < Utils.Distance(my, b) end)
    return list
end

function Farm.NearestSpawn(mob)
    return Farm.SpawnsFor(mob)[1]
end

-- Exact match always wins. Otherwise the SHORTEST partial match is used.
function Farm.ResolveName(name)
    local loose
    local function consider(c)
        if Utils.Has(c, name) and (not loose or #c < #loose) then loose = c end
    end
    for _, s in ipairs(Farm.Spawns()) do
        local c = cleanName(s.name)
        if c:lower() == name:lower() then return c end
        consider(c)
    end
    for model in pairs(Registry.Mobs) do
        if model.Parent and Farm.IsFarmable(model) then
            local c = cleanName(model.Name)
            if c:lower() == name:lower() then return c end
            consider(c)
        end
    end
    return loose or name
end

function Farm.Alive(name, maxDist, loose)
    local list = {}
    local my = Utils.GetPos()
    for model, hum in pairs(Registry.Mobs) do
        if model.Parent and hum.Parent and hum.Health > 0 and Farm.IsFarmable(model) then
            if not name or Farm.NameIs(model.Name, name, loose) then
                local root = Utils.ModelRoot(model)
                if root then
                    local d = Utils.Distance(my, root.Position)
                    if d <= (maxDist or math.huge) then
                        table.insert(list, {model = model, root = root, hum = hum, dist = d})
                    end
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

-- loose: true = partial name match (for bosses)
function Farm.Nearby(range, name, loose)
    local my = Utils.GetPos()
    local list = {}
    for model, hum in pairs(Registry.Mobs) do
        if model.Parent and hum.Parent and hum.Health > 0 and Farm.IsFarmable(model)
            and (not name or Farm.NameIs(model.Name, name, loose)) then
            local root = Utils.ModelRoot(model)
            if root and Utils.Distance(my, root.Position) <= range then
                table.insert(list, {model = model, root = root, hum = hum})
            end
        end
    end
    return list
end

Farm.Tracked = setmetatable({}, {__mode = "k"})
Farm.Unpullable = setmetatable({}, {__mode = "k"})
Farm.Slot = setmetatable({}, {__mode = "k"})
Farm.SlotN = 0
Farm.KillsByName = {} -- cleaned lowercase mob name -> REAL kills (only mobs WE were hitting)
Farm.HitAt = setmetatable({}, {__mode = "k"}) -- model -> last time WE hit it (set by Combat.Loop)

-- Only REAL deaths (health <= 0) of mobs WE were hitting (last 2.5 s) count as kills.
-- A mob that merely despawns / streams out, or that another player killed, is dropped silently.
function Farm.CountKills()
    local now = os.clock()
    for model, hum in pairs(Farm.Tracked) do
        local dead = false
        pcall(function() dead = hum.Health <= 0 end)
        if dead then
            Farm.Tracked[model] = nil
            local hitAt = Farm.HitAt[model]
            if hitAt and now - hitAt <= 2.5 then
                State.Kills = State.Kills + 1
                local k = cleanName(model.Name):lower()
                Farm.KillsByName[k] = (Farm.KillsByName[k] or 0) + 1
            end
        elseif not model.Parent or not hum.Parent then
            Farm.Tracked[model] = nil
        end
    end
end

function Farm.KillsFor(mob)
    return Farm.KillsByName[cleanName(tostring(mob)):lower()] or 0
end

-- Hover height: close mode > fast attack > normal click
function Farm.Hover()
    if Combat.IsClose() then return 4 end
    if Combat.FastReady() then return State.HoverHeight end
    return math.min(State.HoverHeight, 9)
end

function Farm.SlotOf(model)
    local s = Farm.Slot[model]
    if not s then
        Farm.SlotN = Farm.SlotN + 1
        s = ((Farm.SlotN - 1) % 12) + 1
        Farm.Slot[model] = s
    end
    return s
end

function Farm.IsUnpullable(model)
    local u = Farm.Unpullable[model]
    if not u then return false end
    if u > os.clock() then return true end
    Farm.Unpullable[model] = nil
    return false
end

-- Mobs that take no damage for a long time are marked "unpullable" for 30 s
function Farm.CheckUnpullable(mobs)
    local now = os.clock()
    if now - Combat.LastDamage > 3 then return end
    for _, m in ipairs(mobs) do
        local rec = Combat.HP[m.model]
        if rec and not Farm.IsUnpullable(m.model) then
            local ref = rec.dmgAt > 0 and rec.dmgAt or rec.since
            if now - ref > 5 then
                Farm.Unpullable[m.model] = now + 30
                rec.since = now
                rec.dmgAt = 0
                Log("A mob is not taking damage: targeted separately for 30 s", "WARN")
            end
        end
    end
end

function Farm.Owned(root)
    if not root or not isnetworkowner then return true end
    local ok, v = pcall(isnetworkowner, root)
    return (not ok) or v == true
end

-- Pulls mobs to one point (ring layout, no overlap)
function Farm.GatherInit()
    local function simRadius()
        pcall(function() sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge) end)
        pcall(function() sethiddenproperty(LocalPlayer, "MaximumSimulationRadius", math.huge) end)
        pcall(function() setsimulationradius(math.huge, math.huge) end)
    end
    simRadius()
    task.spawn(function()
        while State.Running do
            if State.GatherPoint then simRadius() end
            task.wait(1.5)
        end
    end)
    table.insert(State.Connections, RunService.Heartbeat:Connect(function()
        local p, name = State.GatherPoint, State.GatherName
        if not p or not name then return end
        for model, hum in pairs(Registry.Mobs) do
            if model.Parent and hum.Health > 0 and not Farm.IsUnpullable(model)
                and Farm.NameIs(model.Name, name, false) and Farm.IsFarmable(model) then
                local root = model:FindFirstChild("HumanoidRootPart")
                if root and Utils.Distance(root.Position, p) < State.GatherRadius and Farm.Owned(root) then
                    local slot = Farm.SlotOf(model)
                    local ang = slot * 2.399963
                    local rad = 1 + 0.9 * math.sqrt(slot)
                    root.CFrame = CFrame.new(p + Vector3.new(math.cos(ang) * rad, 0, math.sin(ang) * rad))
                    root.AssemblyLinearVelocity = ZERO
                    root.AssemblyAngularVelocity = ZERO
                    root.CanCollide = false
                    hum.WalkSpeed = 0
                    hum.AutoRotate = false
                end
            end
        end
    end))
end


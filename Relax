    return ok and q or nil
end

local function stripTags(s) return (tostring(s):gsub("<[^>]+>", "")) end

local function normQ(s)
    s = tostring(s):lower():gsub("%[.-%]", " "):gsub("%(.-%)", " "):gsub("[^%w]+", " ")
    return " " .. s:gsub("^%s+", ""):gsub("%s+$", "") .. " "
end

local function words(s)
    local out = {}
    for w in normQ(s):gmatch("%S+") do out[#out + 1] = w end
    return out
end

-- Tolerates plural / singular (bandit/bandits, zombie/zombies, fishman/fishmen)
local function wordEq(a, b)
    if a == b then return true end
    local m = math.min(#a, #b)
    if m < 4 then return false end
    local n = 0
    while n < m and a:sub(n + 1, n + 1) == b:sub(n + 1, n + 1) do n = n + 1 end
    local need = (m <= 6) and m or (m - 2)
    return n >= need and math.abs(#a - #b) <= 3
end

local function mobInText(text, mob)
    local tw, mw = words(text), words(mob)
    if #mw == 0 then return false end
    for i = 1, #tw - #mw + 1 do
        local ok = true
        for j = 1, #mw do
            if not wordEq(tw[i + j - 1], mw[j]) then ok = false; break end
        end
        if ok then return true end
    end
    return false
end

local function textDone(t)
    local a, b = tostring(t):match("(%d+)%s*/%s*(%d+)")
    a, b = tonumber(a), tonumber(b)
    return a ~= nil and b ~= nil and b > 0 and a >= b
end

-- Fallback scan: visible "(x/y)" text that contains a quest mob name (our own UI is skipped)
local function visibleProgressText()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local cands = Quest.Candidates()
    if #cands == 0 then return nil end
    local own = UI.Gui
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text:find("%(%d+%s*/%s*%d+%)")
            and not (own and d:IsDescendantOf(own)) and guiShown(d) then
            local t = stripTags(d.Text)
            for _, c in ipairs(cands) do
                if mobInText(t, c.mob) then return d.Text end
            end
        end
    end
    return nil
end

local function panelText(q, strict)
    local ok, text = pcall(function()
        local c = q:FindFirstChild("Container")
        local qt = c and c:FindFirstChild("QuestTitle")
        local t = qt and qt:FindFirstChild("Title")
        if t and t:IsA("TextLabel") and t.Text ~= "" and (not strict or guiShown(t)) then return t.Text end
        for _, d in ipairs(q:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text:find("%d+%s*/%s*%d+") and (not strict or guiShown(d)) then return d.Text end
        end
        return nil
    end)
    if ok and text then return stripTags(text) end
    return nil
end

-- Quest panel title ("Defeat 5 Bandits (0/5)"). Only text that is really on screen is returned.
function Quest.ReadGui()
    if not Quest.PanelTrusted() then return nil end
    local q = Quest.Panel()
    if q then
        if Quest.Relaxed then
            if not guiShown(q) then return nil end
            local t = panelText(q, false)
            if t then Quest.EverRead = true end
            return t
        end
        local t = panelText(q, true)
        if t then Quest.EverRead = true; return t end
    end
    if os.clock() - (Quest._vpAt or -math.huge) >= 1 then
        Quest._vpAt = os.clock()
        Quest._vpV = visibleProgressText()
    end
    local v = Quest._vpV
    if v then Quest.EverRead = true; return stripTags(v) end
    return nil
end

function Quest.GuiText()
    local now = os.clock()
    if Quest._gtAt and now - Quest._gtAt < 0.12 then return Quest._gtV end
    local v = Quest.ReadGui()
    Quest._gtAt, Quest._gtV = now, v
    return v
end

function Quest.Invalidate() Quest._gtAt = nil; Quest._vpAt = nil end

function Quest.GuiActive()
    return Quest.GuiText() ~= nil
end

-- Counter: from the panel if readable, otherwise from the real kill count (blind mode)
function Quest.Progress()
    local t = Quest.GuiText()
    if t then
        local a, b = t:match("(%d+)%s*/%s*(%d+)")
        if a and b then
            Quest.LastCur = tonumber(a)
            return tonumber(a), tonumber(b)
        end
        return nil
    end
    if Quest.Blind and Quest.Current then
        return math.min(Quest.MobKills(), Quest.Current.count), Quest.Current.count
    end
    return nil
end

function Quest.Done()
    local c, m = Quest.Progress()
    return c ~= nil and m ~= nil and m > 0 and c >= m
end

-- Is the current quest finished RIGHT NOW? Panel readable -> only the counter decides.
-- Panel unreadable -> enough REAL kills must have landed.
function Quest.Finished()
    local cur = Quest.Current
    if not cur then return false end
    if Quest.GuiText() ~= nil then return Quest.Done() end
    return Quest.MobKills() >= cur.count
end

-- Finished AND stable for 1.2 s (protects against one-frame glitches / stale panel text)
function Quest.FinishedSure()
    if not Quest.Finished() then
        Quest._finSince = nil
        return false
    end
    Quest._finSince = Quest._finSince or os.clock()
    return os.clock() - Quest._finSince >= 1.2
end

function Quest.TextMatches(mob)
    local t = Quest.GuiText()
    if not t then return nil end
    return mobInText(t, mob)
end

-- Finds which quest is really active from the panel title
function Quest.FromText()
    local t = Quest.GuiText()
    if not t then return nil end
    local best
    for _, c in ipairs(Quest.Candidates()) do
        if mobInText(t, c.mob) then
            if not best or #c.mob > #best.mob or (#c.mob == #best.mob and c.level > best.level) then
                best = c
            end
        end
    end
    return best
end

function Quest.SpawnExists(mob)
    for _, s in ipairs(Farm.Spawns()) do
        if Utils.Has(s.name, mob) then return true end
    end
    return #Farm.Alive(mob, math.huge, true) > 0
end

function Quest.Usable(c)
    return Quest.HasHint(c) or Quest.Saved(c) ~= nil or Quest.SpawnExists(c.mob)
end

-- Sea from quest level (Sea 1: <700, Sea 2: 700-1499, Sea 3: 1500+)
local function seaOfLevel(lv)
    if lv >= 1500 then return 3 end
    if lv >= 700 then return 2 end
    return 1
end

function Quest.Candidates()
    if Quest._cands and Quest._candsSea == State.Sea and #Quest._cands > 0 then return Quest._cands end
    local mod = Quest.Module()
    local list = {}
    if not mod then return list end
    local bosses = seaBosses()
    for qName, tbl in pairs(mod) do
        if type(qName) == "string" and type(tbl) == "table" then
            for idx, q in pairs(tbl) do
                if type(idx) == "number" and type(q) == "table"
                    and type(q.LevelReq) == "number" and type(q.Task) == "table" then
                    local mob, count
                    for k, v in pairs(q.Task) do mob, count = k, v end
                    if type(mob) == "string" and type(count) == "number" and count >= 2 then
                        local isBoss = false
                        for _, b in ipairs(bosses) do
                            if Utils.Has(mob, b) then isBoss = true; break end
                        end
                        if not isBoss and seaOfLevel(q.LevelReq) == State.Sea then
                            table.insert(list, {name = qName, idx = idx, mob = mob, level = q.LevelReq, count = count})
                        end
                    end
                end
            end
        end
    end
    Quest._cands, Quest._candsSea = list, State.Sea
    return list
end

-- Highest quest your level allows
function Quest.Pick()
    local level = Farm.Level()
    local best, blocked
    for _, c in ipairs(Quest.Candidates()) do
        if c.level <= level then
            if Quest.Usable(c) then
                if not best or c.level > best.level then best = c end
            elseif not blocked or c.level > blocked.level then
                blocked = c
            end
        end
    end
    if blocked and (not best or blocked.level > best.level) and os.clock() - Quest.LastWarnUnusable > 60 then
        Quest.LastWarnUnusable = os.clock()
        Log("A higher quest fits your level but its NPC position is unknown: " .. blocked.name .. " (" .. blocked.mob
            .. ") -> Farm > 'Save quest NPC here' or take the quest manually once", "WARN")
    end
    return best
end

-- Has a higher quest than the current one unlocked? (checked every 2 s)
function Quest.UpgradeAvailable()
    if not Quest.Current then return false end
    if os.clock() - (Quest._upT or -math.huge) < 2 then return Quest._upV == true end
    Quest._upT = os.clock()
    local p = Quest.Pick()
    Quest._upV = p ~= nil and p.level > Quest.Current.level
        and os.clock() - Quest.TakenAt > 5 and os.clock() >= Quest.FailUntil
    return Quest._upV
end

function Quest.NpcKey(want, npcName, pos)
    return want.name .. "|" .. npcName .. "|" .. math.floor(pos.X / 25) .. "," .. math.floor(pos.Z / 25)
end

function Quest.NpcCandidates(want, center, maxD)
    center = center or Quest.HintFor(want) or Farm.NearestSpawn(want.mob)
    maxD = maxD or 800
    local npcs = Workspace:FindFirstChild("NPCs")
    local list = {}
    if not npcs or not center then return list end
    for _, n in ipairs(npcs:GetDescendants()) do
        if n:IsA("Model") and (n:FindFirstChildOfClass("Humanoid") or n:FindFirstChild("HumanoidRootPart")) then
            local skip = false
            for _, w in ipairs(NPC_SKIP) do
                if Utils.Has(n.Name, w) then skip = true; break end
            end
            local r = (not skip) and Utils.ModelRoot(n)
            if r and (Quest.BadNPC[Quest.NpcKey(want, n.Name, r.Position)] or 0) < os.clock() then
                local d = Utils.Distance(r.Position, center)
                if d < maxD then
                    local score = d
                    if Utils.Has(n.Name, "quest") or Utils.Has(n.Name, "giver") then score = score - 150 end
                    table.insert(list, {pos = r.Position, d = d, score = score, name = n.Name})
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.score < b.score end)
    return list
end

-- StartQuest attempt. Returns: true | "blind" | false
function Quest.Try(want, rounds)
    Quest.Invalidate()
    local before = Quest.GuiText()
    local lastSeen, anyCall
    for round = 1, rounds or 2 do
        local callOk, res = Utils.InvokeEx("StartQuest", want.name, want.idx)
        if callOk then anyCall = true end
        Quest.LastRes = tostring(res)
        local limit = round == 1 and 3.0 or 3.5
        local t0 = os.clock()
        while os.clock() - t0 < limit do
            task.wait(0.15)
            Quest.Invalidate()
            local t = Quest.GuiText()
            if not t and not Quest.Relaxed and Quest.PanelTrusted() then
                local q = Quest.Panel()
                if q and guiShown(q) then
                    local rt = panelText(q, false)
                    if rt and not textDone(rt) and normQ(rt) ~= normQ(before or "") then
                        Quest.Relaxed = true
                        Log("Inner panel frames look hidden: switched to relaxed reading", "WARN")
                        Quest.Invalidate()
                        t = rt
                    end
                end
            end
            if t then
                lastSeen = t
                if not textDone(t) then
                    if mobInText(t, want.mob) then return true end
                    if normQ(t) ~= normQ(before or "") then
                        Quest.LastPanel = t
                        Log("Panel text did not match mob ('" .. t .. "' / '" .. want.mob .. "') but quest changed: accepted", "WARN")
                        return true
                    end
                end
            end
        end
    end
    Quest.LastPanel = lastSeen
    if lastSeen == nil and anyCall and (not Quest.EverRead or not Quest.PanelTrusted()) then
        Log("Quest panel unreadable: assuming quest taken (blind mode)", "WARN")
        return "blind"
    end
    return false
end

-- Take a quest: 1) saved NPC  2) known position  3) nearby NPCs (max 10)
function Quest.TakeInner(want)
    local function cancelled() return not State.Running or not State.AutoFarm end
    local key = want.name .. "|" .. want.idx

    local function haveQuest()
        Quest.Invalidate()
        local t = Quest.GuiText()
        return t ~= nil and not textDone(t) and mobInText(t, want.mob)
    end

    -- "ok" | "blind" | "fly" | "try"
    local function visit(stand, label)
        State.Status = label
        if Utils.Distance(Utils.GetPos(), stand) > 10 then
            if not Flight.To(stand, 3, cancelled) then return "fly" end
            task.wait(0.25)
        end
        if cancelled() then return "fly" end
        State.HoldCF = CFrame.new(stand)
        local ok = Quest.Try(want, 2)
        local blind = (ok == "blind")
        if not ok then
            task.wait(0.8)
            ok = haveQuest()
        end
        State.HoldCF = nil
        if not ok then return "try" end
        return blind and "blind" or "ok"
    end

    local function accept(r)
        Quest.Blind = (r == "blind")
        Quest.Baseline(want)
        return true
    end

    local function learn(stand)
        local c = Quest.Saved(want)
        local sk = Quest.SavedKey(want)
        if c and c.manual and not (sk and (Quest.SkipSaved[sk] or 0) > os.clock()) then return end
        State.QuestNPCs[Quest.SaveKey(want)] = {x = stand.X, y = stand.Y, z = stand.Z, manual = false}
        ConfigManager.Save(true)
    end

    if haveQuest() then return accept("ok") end

    -- 1) Saved NPC
    local cachedKey = Quest.SavedKey(want)
    local cached = cachedKey and State.QuestNPCs[cachedKey]
    if cached and (Quest.SkipSaved[cachedKey] or 0) > os.clock() then cached = nil end
    if cached then
        local r = visit(Vector3.new(cached.x, cached.y, cached.z), "Flying to quest NPC")
        if r == "ok" or r == "blind" then
            Quest.ManualFail[cachedKey] = nil
            return accept(r)
        end
        if cancelled() then return false end
        if r == "try" then
            if cached.manual then
                local n = (Quest.ManualFail[cachedKey] or 0) + 1
                Quest.ManualFail[cachedKey] = n
                Log("Quest not taken at manually saved NPC (" .. n .. "/2, NPC kept): " .. want.name
                    .. " | panel: " .. tostring(Quest.LastPanel) .. " | reply: " .. tostring(Quest.LastRes), "WARN")
                if n >= 2 then
                    Quest.ManualFail[cachedKey] = nil
                    Quest.SkipSaved[cachedKey] = os.clock() + 600
                    Log("Manual NPC failed twice: trying known position / nearby NPCs for 10 min", "WARN")
                end
            else
                State.QuestNPCs[cachedKey] = nil
                Log("Saved NPC did not work, searching again: " .. want.name, "WARN")
            end
        end
    end

    -- 2) Known position
    local hint = Quest.HintFor(want)
    if hint and (Quest.BadHint[key] or 0) < os.clock() then
        local stand = hint + Vector3.new(0, 3, 0)
        local r = visit(stand, "Flying to quest NPC")
        if r == "ok" or r == "blind" then
            if r == "ok" then learn(stand) end
            Log("Quest taken (known position): " .. want.name)
            return accept(r)
        end
        if cancelled() then return false end
        if r == "try" then
            Quest.BadHint[key] = os.clock() + 300
            Log("Quest not taken at known position (position may be wrong): " .. want.name, "WARN")
        end
    end

    -- 3) Nearby NPCs
    local sp = Farm.NearestSpawn(want.mob)
    if hint then pcall(function() LocalPlayer:RequestStreamAroundAsync(hint, 150) end) end
    if sp then pcall(function() LocalPlayer:RequestStreamAroundAsync(sp, 150) end) end
    task.wait(0.8)

    local cands, seen = {}, {}
    local function addFrom(center, maxD)
        if not center then return end
        for _, c in ipairs(Quest.NpcCandidates(want, center, maxD)) do
            local k = math.floor(c.pos.X / 10) .. "," .. math.floor(c.pos.Z / 10)
            if not seen[k] then seen[k] = true; table.insert(cands, c) end
        end
    end
    addFrom(hint, 300)
    addFrom(sp, 800)
    if #cands == 0 then
        Log("No quest NPC candidate: " .. want.name .. " (use Farm > 'Save quest NPC here' or take the quest manually once)", "WARN")
        return false
    end
    local n = math.min(10, #cands)
    for i = 1, n do
        if cancelled() then return false end
        local c = cands[i]
        local stand = c.pos + Vector3.new(0, 3, 0)
        local r = visit(stand, "Searching quest NPC (" .. i .. "/" .. n .. ")")
        if r == "ok" or r == "blind" then
            if r == "ok" then learn(stand) end
            Log("Quest NPC found: " .. c.name .. " -> " .. want.name)
            return accept(r)
        end
        if r == "try" then
            Quest.BadNPC[Quest.NpcKey(want, c.name, c.pos)] = os.clock() + 600
        end
    end
    return false
end

function Quest.Take(want)
    if not Utils.CommF() then return false end
    Quest.Taking = true
    local ok, res = pcall(Quest.TakeInner, want)
    Quest.Taking = false
    Quest.LastTakeAt = os.clock()
    State.HoldCF = nil
    if not ok then
        Log("Quest take error: " .. tostring(res), "WARN")
        State.Traveling = false
        return false
    end
    return res == true
end

-- Save the current position as the NPC of the current quest
function Quest.TeachHere()
    local want = Quest.Pick()
    if not want then Utils.Notify("Quest data could not be read", 4, "warn"); return end
    if Quest.Taking then Utils.Notify("Cannot save while a quest is being taken, wait a bit", 3, "warn"); return end
    Utils.Notify("Trying " .. want.name .. " at this spot...", 3)
    task.spawn(function()
        Quest.Taking = true
        local ok, got = pcall(function()
            if Quest.GuiActive() then Quest.Abandon() end
            return Quest.Try(want, 2)
        end)
        Quest.Taking = false
        Quest.LastTakeAt = os.clock()
        if not (ok and got) then
            Utils.Notify("Could not take the quest here. Stand next to the right NPC and press again.", 5, "warn")
            return
        end
        local p = Utils.GetPos()
        local k = Quest.SaveKey(want)
        State.QuestNPCs[k] = {x = p.X, y = p.Y, z = p.Z, manual = true}
        Quest.SkipSaved[k] = nil
        Quest.ManualFail[k] = nil
        Quest.FailUntil, Quest.FailCount = 0, 0
        Quest.BadNPC = {}
        Quest.Current, Quest.TakenAt = want, os.clock()
        Quest.Blind = (got == "blind")
        Quest.Baseline(want)
        ConfigManager.Save(true)
        Utils.Notify("Quest NPC position saved: " .. want.name, 4, "success")
    end)
end

function Quest.Reset()
    Farm.Epoch = (Farm.Epoch or 0) + 1
    Quest.Current, Quest.FailUntil, Quest.FailCount = nil, 0, 0
    Quest.BadNPC = {}
    Quest.BadHint = {}
    Quest.Blind = false
    Quest.Fallback = nil
    Quest.ForceRetake = false
    Quest.StallCount = 0
    Quest.UnreliableUntil = 0
    Quest.SkipSaved = {}
    Quest.ManualFail = {}
    Quest._finSince = nil
end

function Quest.Abandon()
    Quest.LastAbandon = os.clock()
    Quest.Blind = false
    Utils.Invoke("AbandonQuest")
    local t0 = os.clock()
    while os.clock() - t0 < 1.5 do
        Quest.Invalidate()
        if not Quest.GuiActive() then break end
        task.wait(0.1)
    end
    Quest.Current = nil
end

-- Completed-quest counter: increments once per quest
function Quest.MarkDone()
    if Quest.CountedAt ~= Quest.TakenAt then
        Quest.CountedAt = Quest.TakenAt
        State.QuestsDone = State.QuestsDone + 1
        Log("Quest completed -> taking a new one")
    end
end

-- QUEST WATCHDOG: counter does not move although many REAL kills landed -> quest is stuck
function Quest.CheckStall()
    if not State.QuestWatch or not Quest.Current or Quest.Blind or Quest.Taking then return false end
    local cur = Quest.Progress()
    local mk = Farm.KillsFor(Quest.Current.mob)
    if cur ~= Quest.ProgVal then
        Quest.ProgVal, Quest.ProgAt, Quest.ProgKills = cur, os.clock(), mk
        return false
    end
    local need = math.max(Quest.Current.count + 3, 8)
    return mk - Quest.ProgKills >= need and os.clock() - Quest.ProgAt > 20
end

function Quest.OnStall()
    local cur = Quest.Current
    if os.clock() - Quest.StallAt < 600 then
        Quest.StallCount = Quest.StallCount + 1
    else
        Quest.StallCount = 1
    end
    Quest.StallAt = os.clock()
    Log("Quest stuck (counter not moving): " .. (cur and (cur.name .. " -> " .. cur.mob) or "?")
        .. " | panel: " .. tostring(Quest.GuiText()) .. " -> retaking", "WARN")
    if Quest.StallCount >= 2 then
        Quest.UnreliableUntil = os.clock() + 600
        Quest.EverRead = false
        Log("Panel marked unreliable: quest tracked by kill count for 10 min", "WARN")
        Utils.Notify("Quest panel unreliable: tracking by kill count (10 min)", 5, "warn")
    end
    Quest.Invalidate()
    if os.clock() - Quest.LastAbandon > 8 then Quest.Abandon() end
    Quest.Current = nil
    Quest.Blind = false
    Quest.FailUntil, Quest.FailCount = 0, 0
    Quest.BadNPC, Quest.BadHint = {}, {}
end

function Quest.NearNpc(pos, d)
    local npcs = Workspace:FindFirstChild("NPCs")
    if not npcs then return false end
    for _, n in ipairs(npcs:GetDescendants()) do
        if n:IsA("Model") then
            local r = Utils.ModelRoot(n)
            if r and (r.Position - pos).Magnitude <= d then return true end
        end
    end
    return false
end

-- Auto learn: when YOU take a quest by hand (0/x, next to an NPC) the position is saved.
function Quest.WatchLoop()
    task.spawn(function()
        local last = Quest.GuiActive()
        while State.Running do
            task.wait(0.5)
            local ok, err = pcall(function()
                local act = Quest.GuiActive()
                if act and not last and not Quest.Taking and os.clock() - Quest.CharAt > 20
                    and os.clock() - Quest.LastTakeAt > 15 and not State.Traveling
                    and (not State.AutoFarm or Quest.Current == nil) then
                    local t = Quest.GuiText()
                    local c = t and t:match("(%d+)%s*/%s*%d+")
                    local actual = Quest.FromText()
                    local root = Utils.GetRootPart()
                    if actual and root and tonumber(c) == 0 and Quest.NearNpc(root.Position, 30) then
                        local cur = Quest.Saved(actual)
                        if not (cur and cur.manual) then
                            local p = root.Position
                            State.QuestNPCs[Quest.SaveKey(actual)] = {x = p.X, y = p.Y, z = p.Z, manual = true}
                            ConfigManager.Save(true)
                            Log("Quest NPC learned automatically (taken by hand): " .. actual.name)
                            Utils.Notify("Quest NPC learned: " .. actual.name, 4, "success")
                        end
                    end
                end
                last = act
            end)
            if not ok then Log("Quest watch: " .. tostring(err), "WARN") end
        end
    end)
end

function Quest.Report()
    local want = Quest.Pick()
    Log("— Quest diagnostics —")
    Log("Level " .. Farm.Level() .. " | quest on screen: " .. tostring(Quest.GuiActive()))
    Log("Title: " .. tostring(Quest.GuiText()))
    Log("Panel read: read=" .. tostring(Quest.EverRead) .. " | relaxed=" .. tostring(Quest.Relaxed)
        .. " | blind=" .. tostring(Quest.Blind))
    Log("Watchdog: " .. tostring(State.QuestWatch) .. " | panel trusted=" .. tostring(Quest.PanelTrusted())
        .. " | stalls=" .. Quest.StallCount .. " | real mob kills (this quest)=" .. Quest.MobKills()
        .. " | last counter=" .. tostring(Quest.LastCur) .. " | finished=" .. tostring(Quest.Finished()))
    Log("Last panel text (not taken): " .. tostring(Quest.LastPanel))
    local q = Quest.Panel()
    if not q then
        Log("Panel: PlayerGui.Main.Quest not found", "WARN")
    else
        Log("Panel visible: " .. tostring(q.Visible))
        local n = 0
        for _, d in ipairs(q:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text ~= "" then
                n = n + 1
                if n <= 5 then
                    Log(string.format("   [%s] %s (on screen=%s)", d.Name, d.Text, tostring(guiShown(d))))
                end
            end
        end
    end
    Log("Picked: " .. (want and (want.name .. " #" .. want.idx .. " -> " .. want.mob) or "none"))
    local nq = want and Quest.Saved(want)
    Log("Saved NPC: " .. (nq and (math.floor(nq.x) .. ", " .. math.floor(nq.z) .. (nq.manual and " (manual)" or "")) or "none"))
    if want then
        local sk = Quest.SavedKey(want)
        if sk and (Quest.SkipSaved[sk] or 0) > os.clock() then
            Log("Saved NPC is being SKIPPED (did not work): " .. math.ceil(Quest.SkipSaved[sk] - os.clock()) .. " s")
        end
        local h = Quest.HintFor(want)
        Log("Known NPC position: " .. (h and (math.floor(h.X) .. ", " .. math.floor(h.Z)) or "none"))
        Log("Spawn loaded: " .. tostring(Quest.SpawnExists(want.mob)))
        local nc = Quest.NpcCandidates(want)
        Log("NPC candidates: " .. #nc)
        for i = 1, math.min(5, #nc) do
            Log(string.format("   %d) %s — %d studs", i, nc[i].name, math.floor(nc[i].d)))
        end
    end
    Log("Last StartQuest reply: " .. tostring(Quest.LastRes))
    Log("Quests completed: " .. State.QuestsDone)
    Utils.Notify("Quest diagnostics ready: System > log", 4)
end

local function setQT(q) State.QuestText = q.name .. " #" .. q.idx .. " -> " .. q.mob end

function Quest.Ensure()
    local want = Quest.Pick()
    if not want then
        State.QuestText = "No quest data"
        Quest.Fallback = nil
        return nil
    end

    local function fail(msg)
        State.QuestText = msg
        Quest.Fallback = want
        return nil
    end

    local function adopt(q)
        local c = Quest.Current
        if not c or c.name ~= q.name or c.idx ~= q.idx then Quest.Baseline(q) end
        Quest.Current = q
    end

    -- The previous quest is CONFIRMED finished: drop the old (completed) panel, then take a fresh quest.
    if Quest.ForceRetake then
        Quest.ForceRetake = false
        if Quest.GuiActive() and os.clock() - Quest.LastAbandon > 2 then Quest.Abandon() end
        Quest.Current = nil
        Quest.Blind = false
    end

    -- Blind mode: panel unreadable, quest assumed taken. Counter = REAL mob kill count.
    if Quest.Blind and Quest.Current then
        if Quest.GuiActive() then
            Quest.Blind = false
        else
            local cur = Quest.Current
            -- never finish by a timer. Only real kills (or, if the mob name never matches, many total kills).
            local finished = Quest.FinishedSure()
                or (Quest.MobKills() == 0 and State.Kills - Quest.KillBase >= cur.count * 2 + 2)
            local higher = want.level > cur.level and os.clock() - Quest.TakenAt > 5 and os.clock() >= Quest.FailUntil
            if not finished and not higher then
                Quest.Fallback = nil
                setQT(cur)
                return cur
            end
            if finished then
                Quest.MarkDone()
            else
                Log("Taking a higher quest: " .. want.name .. " (" .. want.mob .. ")")
            end
            Quest.Current = nil
            if os.clock() - Quest.LastAbandon > 8 then Quest.Abandon() end
        end
    end

    -- Counter is full (panel readable, stable): abandon the completed quest, a new one is taken below
    local staleDone = false
    if Quest.GuiActive() and Quest.Done() and os.clock() - Quest.TakenAt > 3 then
        if Quest.FinishedSure() or not Quest.Current then
            Quest.MarkDone()
            if os.clock() - Quest.LastAbandon > 8 then Quest.Abandon() end
            staleDone = Quest.GuiActive() and Quest.Done()
        else
            -- not stable yet: keep farming / waiting, do not touch the quest
            staleDone = false
            setQT(Quest.Current)
            return Quest.Current
        end
    end

    -- An active quest in the panel is the real source of truth
    if not staleDone and Quest.GuiActive() then
        local actual = Quest.FromText()
        if actual and Quest.Usable(actual) then
            local same = actual.name == want.name and actual.idx == want.idx
            local lower = actual.level < want.level
                and os.clock() - Quest.TakenAt > 5
                and os.clock() >= Quest.FailUntil
            if same or not lower then
                adopt(actual)
                Quest.Fallback = nil
                setQT(actual)
                return actual
            end
            Log("Taking a higher quest: " .. want.name .. " (" .. want.mob .. ")")
            Quest.Abandon()
        elseif not actual then
            -- Unknown title: NEVER abandon. Use the last taken (or picked) quest.
            local cur = Quest.Current
            if cur and want.level > cur.level and os.clock() - Quest.TakenAt > 5 and os.clock() >= Quest.FailUntil then
                Log("Taking a higher quest: " .. want.name .. " (" .. want.mob .. ")")
                Quest.Abandon()
            else
                if not cur then Quest.TakenAt = os.clock() end
                cur = cur or want
                adopt(cur)
                Quest.Fallback = nil
                setQT(cur)
                return cur
            end
        elseif os.clock() - Quest.LastAbandon > 20 then
            Log("Abandoning unusable quest in panel: " .. tostring(Quest.GuiText()), "WARN")
            Quest.Abandon()
        end
    end

    -- Panel hidden / unreadable but the quest is clearly NOT finished yet: keep it. No timer, no NPC trip.
    -- (Switch to kill-count tracking with the last known counter.)
    do
        local cur = Quest.Current
        if cur and not Quest.Taking and not Quest.GuiActive() and not Quest.Finished()
            and want.level <= cur.level then
            if not Quest.Blind then Quest.GoBlind() end
            Quest.Fallback = nil
            setQT(cur)
            return cur
        end
    end

    if os.clock() < Quest.FailUntil then
        return fail("Quest not taken, retry in " .. math.ceil(Quest.FailUntil - os.clock()) .. " s (farming without quest)")
    end

    if Quest.Take(want) then
        Quest.Current, Quest.TakenAt, Quest.FailCount = want, os.clock(), 0
        Quest.Fallback = nil
        setQT(want)
        Log("Quest taken: " .. want.name .. " #" .. want.idx .. " (" .. want.mob .. ")" .. (Quest.Blind and " [blind mode]" or ""))
        return want
    end

    -- Not taken: short wait, retry the SAME quest (never drop to a lower quest). Meanwhile farm without quest.
    Quest.FailCount = Quest.FailCount + 1
    local wait = math.min(6 * Quest.FailCount, 30)
    Quest.FailUntil = os.clock() + wait
    Log("Quest not taken: " .. want.name .. " #" .. want.idx .. " (reply: " .. tostring(Quest.LastRes)
        .. " | panel: " .. tostring(Quest.LastPanel) .. ")", "WARN")
    if Quest.FailCount >= 3 then
        Quest.FailCount = 0
        Quest.BadNPC, Quest.BadHint = {}, {}
        Log("Failed 3 times: NPC searches reset, same quest will be retried", "WARN")
    end
    return fail("Quest not taken: " .. want.name .. " (retry in " .. wait .. " s, farming without quest)")
end

-- ============================================================
-- FARM: main loop
-- ============================================================
local function lookCF(from, to)
    return CFrame.new(from, to + Vector3.new(0.05, 0, 0.05))
end

-- Position of the mob that has the most mobs around it (cluster center)
local function clusterCenter(list)
    local best, bestN = list[1].root.Position, -1
    for _, a in ipairs(list) do
        local pa = a.root.Position
        local n = 0
        for _, b in ipairs(list) do
            if Utils.Distance(pa, b.root.Position) <= 30 then n = n + 1 end
        end
        if n > bestN then best, bestN = pa, n end
    end
    return best
end

Farm.GatherBrokenUntil = 0
Farm.Epoch = 0
Farm.BossBusy = false

function Farm.Engage(mobName, isBoss)
    local G, anchor
    local gatherSince = os.clock()
    local usingGather = (not isBoss) and State.BringMobs and os.clock() > Farm.GatherBrokenUntil
    local flightFails = 0
    local goneSince
    local epoch = Farm.Epoch
    local startedAt = os.clock()
    local safePos
    local function enabled()
        if Utils.EventBusy() then return false end
        if isBoss then return State.AutoBoss end
        return State.AutoFarm
    end
    local function cancelled() return not enabled() end

    while State.Running and enabled() and not Paused() do
        local mobs = Farm.Alive(mobName, isBoss and math.huge or SEARCH_RANGE, isBoss)
        if #mobs == 0 then break end
        if Farm.Epoch ~= epoch then
            Log("State reset -> picking target again")
            break
        end

        if not isBoss and State.AutoQuest and State.FarmTargetMob == "" then
            -- Counter full AND stable -> leave the loop, a new quest is taken immediately
            if Quest.Current and os.clock() - Quest.TakenAt > 4 and Quest.FinishedSure() then
                Quest.MarkDone()
                Quest.ForceRetake = true
                Quest.Current = nil
                Log("Quest counter full (confirmed) -> new quest")
                break
            end

            -- Panel disappeared: keep the last known counter and continue by REAL kill count.
            -- The quest is never retaken because of this.
            if Quest.Current and not Quest.Blind and os.clock() - Quest.TakenAt > 6 then
                if not Quest.GuiActive() then
                    goneSince = goneSince or os.clock()
                    if os.clock() - goneSince > 2 then
                        Quest.GoBlind()
                        goneSince = nil
                    end
                else
                    goneSince = nil
                end
            end

            -- Watchdog: counter not moving although many real kills landed -> abandon and retake
            if Quest.CheckStall() then
                Quest.OnStall()
                break
            end

            -- A higher quest unlocked: switch (even far away)
            if Quest.UpgradeAvailable() then
                Log("New quest available for your level -> switching")
                break
            end

            -- While farming without quest: retry the quest when the wait is over
            if not Quest.Current and Quest.Fallback and os.clock() >= Quest.FailUntil then
                break
            end

            -- No quest and no fallback: re-evaluate every 8 s
            if not Quest.Current and not Quest.Fallback and os.clock() - startedAt > 8 then
                break
            end
        end

        local hum = Utils.GetHumanoid()
        local root = Utils.GetRootPart()
        if not root or not hum or hum.Health <= 0 then break end

        if State.SafeHP > 0 and hum.MaxHealth > 0 and hum.Health / hum.MaxHealth * 100 < State.SafeHP then
            State.InCombat = false
            State.GatherPoint = nil
            State.Status = "Low HP: retreating to safety"
            if not safePos or Utils.Distance(root.Position, safePos) > 60 then
                safePos = root.Position + Vector3.new(0, 200, 0)
            end
            local safe = safePos
            Flight.To(safe, 4, cancelled)
            State.HoldCF = CFrame.new(safe)
            local t0 = os.clock()
            while State.Running and enabled() and os.clock() - t0 < 40 do
                local h = Utils.GetHumanoid()
                if not h or h.Health <= 0 or h.Health / h.MaxHealth * 100 >= 85 then break end
                task.wait(0.5)
            end
            local hAfter = Utils.GetHumanoid()
            if hAfter and hAfter.MaxHealth > 0 and hAfter.Health / hAfter.MaxHealth * 100 >= 85 then safePos = nil end
            State.HoldCF = nil
        else
            for _, m in ipairs(mobs) do Farm.Tracked[m.model] = m.hum end

            -- Only mobs we own the network for can be moved (others snap back = ghost mobs)
            local pull = {}
            if usingGather then
                Farm.CheckUnpullable(mobs)
                for _, m in ipairs(mobs) do
                    if not Farm.IsUnpullable(m.model) and Farm.Owned(m.root) then
                        table.insert(pull, m)
                    end
                end
            end
            local follow = (not usingGather) or #pull == 0

            if follow then
                G = clusterCenter(mobs)
                anchor = nil
            else
                local near = false
                if G then
                    for _, m in ipairs(pull) do
                        if Utils.Distance(m.root.Position, G) <= State.GatherRadius then near = true; break end
                    end
                end
                if not G or not near then
                    G = pull[1].root.Position
                    anchor = pull[1].model
                    gatherSince = os.clock()
                end
                if anchor and gatherSince and os.clock() - gatherSince > 3.5 then
                    local others, gathered = 0, 0
                    for _, m in ipairs(pull) do
                        if m.model ~= anchor then
                            local d = Utils.Distance(m.root.Position, G)
                            if d <= State.GatherRadius then
                                others = others + 1
                                if d <= 15 then gathered = gathered + 1 end
                            end
                        end
                    end
                    if others >= 1 and gathered == 0 then
                        usingGather = false
                        Farm.GatherBrokenUntil = os.clock() + 90
                        State.GatherPoint = nil
                        Log("Mob gathering did not work -> switched to one-by-one hits", "WARN")
                    end
                    gatherSince = nil
                end
            end

            local H = G + Vector3.new(0, Farm.Hover(), 0)
            if Utils.Distance(root.Position, H) > (follow and 30 or 14) then
                State.InCombat = false
                State.HoldCF = nil
                State.GatherPoint = nil
                State.Status = "Flying to " .. mobName
                if Flight.To(H, 3, cancelled) then
                    flightFails = 0
                elseif enabled() then
                    flightFails = flightFails + 1
                    if flightFails >= 3 then
                        Log("Could not reach mob, searching for a new target", "WARN")
                        break
                    end
                end
            end

            root = Utils.GetRootPart()
            if root and enabled() and Utils.Distance(root.Position, H) < 40 then
                State.HoldCF = lookCF(H, G)
                State.InCombat = true
                if follow then
                    State.GatherPoint = nil
                    State.Status = (isBoss and "Boss: " or "Attacking: ") .. mobName .. " (" .. #mobs .. ")"
                else
                    State.GatherPoint, State.GatherName = G, mobName
                    State.Status = "Gathering mobs (" .. #pull .. "/" .. #mobs .. "): " .. mobName
                end
            else
                State.HoldCF = nil
                State.InCombat = false
                State.GatherPoint = nil
            end
        end
        task.wait(0.1)
        Farm.CountKills()
    end
    Farm.CountKills() -- count the last kill before leaving the loop
    State.InCombat = false
    State.GatherPoint, State.GatherName = nil, nil
    State.HoldCF = nil
end

Farm.SpawnWaitSince = nil
Farm.SpawnIdx = 1
Farm.SpawnOrder = {}
Farm.SpawnMob = nil

function Farm.Step()
    if Quest.Taking then
        State.Status = "Taking quest, waiting"
        task.wait(0.5)
        return
    end
    local mobName = State.FarmTargetMob ~= "" and State.FarmTargetMob or nil

    if State.AutoQuest and not mobName then
        local q = Quest.Ensure()
        if q then
            mobName = q.mob
        elseif Quest.Fallback and State.AutoFarm then
            mobName = Quest.Fallback.mob
        end
    elseif not State.AutoQuest then
        State.QuestText = "Off"
    else
        State.QuestText = "OFF: manual target mob selected (Farm > pick 'Automatic')"
    end
    if not State.AutoFarm then return end

    if not mobName then
        local near = Farm.Alive(nil, 600)
        if near[1] then mobName = cleanName(near[1].model.Name)
        else State.Status = "No target mob"; task.wait(1.5); return end
    end
    mobName = Farm.ResolveName(mobName)
    State.TargetMob = mobName

    if #Farm.Alive(mobName, SEARCH_RANGE) == 0 then
        -- All mobs are dead. Only a CONFIRMED finished quest sends us to the NPC.
        -- Otherwise we stay at the spawn and wait for respawns.
        if State.AutoQuest and State.FarmTargetMob == "" and Quest.Current and os.clock() - Quest.TakenAt > 4 then
            Farm.CountKills()
            if Quest.Finished() then
                if Quest.FinishedSure() then
                    Quest.MarkDone()
                    Quest.ForceRetake = true
                    Quest.Current = nil
                    Log("All mobs killed and quest is full (confirmed) -> going for a new quest")
                else
                    State.Status = "Confirming quest completion..."
                    task.wait(0.3)
                end
                return
            end
        end

        if Farm.SpawnMob ~= mobName or not Farm.SpawnWaitSince then
            Farm.SpawnOrder = Farm.SpawnsFor(mobName)
            Farm.SpawnIdx, Farm.SpawnMob, Farm.SpawnWaitSince = 1, mobName, os.clock()
        end
        if #Farm.SpawnOrder == 0 then Farm.SpawnOrder = Farm.SpawnsFor(mobName) end
        if #Farm.SpawnOrder == 0 then
            -- Spawns not loaded (far region): fly to the area guessed from the quest NPC, then rescan
            local area = Farm.AreaHint(mobName)
            if area and os.clock() > (Farm.AreaTry[mobName] or 0) then
                State.Status = "Flying to area: " .. mobName
                State.HoldCF = nil
                local AH = area + Vector3.new(0, 40, 0)
                if Flight.To(AH, 6, function() return not State.AutoFarm end) then
                    State.HoldCF = CFrame.new(AH)
                    task.wait(2)
                    State.HoldCF = nil
                    Farm.InvalidateSpawns()
                    Farm.SpawnOrder = Farm.SpawnsFor(mobName)
                    Farm.SpawnIdx = 1
                    if #Farm.SpawnOrder == 0 and #Farm.Alive(mobName, SEARCH_RANGE) == 0 then
                        Farm.AreaTry[mobName] = os.clock() + 20
                    end
                else
                    Farm.AreaTry[mobName] = os.clock() + 10
                end
                return
            end
            State.Status = "Spawn not found: " .. mobName
            task.wait(2)
            return
        end
        if os.clock() - Farm.SpawnWaitSince > 8 then
            Farm.SpawnIdx = Farm.SpawnIdx % #Farm.SpawnOrder + 1
            Farm.SpawnWaitSince = os.clock()
        end
        local sp = Farm.SpawnOrder[Farm.SpawnIdx]
        local H = sp + Vector3.new(0, Farm.Hover(), 0)
        if Utils.Distance(Utils.GetPos(), H) > 40 then
            State.HoldCF = nil
            State.Status = "Flying to spawn: " .. mobName
            if not Flight.To(H, 3, function() return not State.AutoFarm end) then task.wait(1); return end
            Farm.SpawnWaitSince = os.clock()
        end
        State.HoldCF = lookCF(H, sp)
        local c, m = Quest.Progress()
        State.Status = "Waiting for respawn: " .. mobName .. ((c and m) and ("  (" .. c .. "/" .. m .. ")") or "")
        task.wait(1)
        return
    end

    Farm.SpawnWaitSince = nil
    Farm.Engage(mobName, false)
end

function Farm.Loop()
    task.spawn(function()
        while State.Running do
            if State.AutoFarm and not Paused() and not State.RateLimit and not Raid.Active and not Utils.EventBusy() then
                if State.LevelGoal > 0 and Farm.Level() >= State.LevelGoal then
                    State.AutoFarm = false
                    State.HoldCF, State.GatherPoint, State.InCombat = nil, nil, false
                    Utils.Notify("Level goal reached (" .. State.LevelGoal .. "): farm stopped", 8, "success")
                    if UI.RefreshAll then pcall(UI.RefreshAll) end
                else
                    local ok, err = pcall(Farm.Step)
                    if not ok then
                        Log("Farm: " .. tostring(err), "WARN")
                        State.HoldCF, State.GatherPoint, State.Traveling, State.InCombat = nil, nil, false, false
                        task.wait(1)
                    end
                    task.wait(0.05)
                end
            else
                if not State.AutoBoss and not State.AutoChest and not State.AutoFruit and not Raid.Active and not Utils.EventBusy() then
                    State.HoldCF, State.GatherPoint = nil, nil
                    State.InCombat = false
                end
                if not State.AutoFarm then Farm.SpawnWaitSince = nil end
                if not State.AutoFarm and not State.AutoBoss and not State.AutoChest and not State.AutoFruit and not Raid.Active and not Utils.EventBusy() then
                    State.Status = "Idle"
                end
                task.wait(0.4)
            end
        end
    end)
end

-- Full automation: quest / weapon / haki turn on, manual target mob is cleared
function Farm.SetAuto(on)
    on = on and true or false
    State.AutoFarm = on
    if on then
        State.AutoBoss = false
        State.AutoQuest = true
        State.AutoEquip = true
        State.AutoHaki = true
        State.FarmTargetMob = ""
        Quest.FailUntil, Quest.FailCount = 0, 0
        Utils.Notify("Full automation ON: quest -> finish -> retake -> next quest", 5, "success")
    end
    if UI.RefreshAll then pcall(UI.RefreshAll) end
end

-- ============================================================
-- BOSS
-- ============================================================
function Farm.BossLoop()
    task.spawn(function()
        local fighting
        while State.Running do
            if State.AutoBoss and State.SelectedBoss ~= "" and not State.AutoFarm and not Paused() and not Raid.Active and not Utils.EventBusy() then
                local ok, err = pcall(function()
                    if #Farm.Alive(State.SelectedBoss, math.huge, true) > 0 then
                        fighting = State.SelectedBoss
                        State.TargetMob = fighting
                        Farm.BossBusy = true
                        Farm.Engage(fighting, true)
                        Farm.BossBusy = false
                        task.wait(0.1)
                    else
                        if fighting then
                            Log("Boss defeated: " .. fighting)
                            fighting = nil
                            if State.AutoServerHopOnBossKill then task.wait(2); ServerHop.Hop() end
                        end
                        State.Status = "Waiting for boss: " .. State.SelectedBoss
                        task.wait(Utils.RandomDelay(5, 1))
                    end
                end)
                if not ok then
                    Log("Boss: " .. tostring(err), "WARN")
                    Farm.BossBusy = false
                    State.HoldCF, State.Traveling, State.InCombat = nil, false, false
                    task.wait(1)
                end
            else
                fighting = nil
                Farm.BossBusy = false
                task.wait(0.5)
            end
        end
    end)
end

-- ============================================================
-- FRUIT: pick up + store
-- ============================================================
local FruitSniper = {Known = setmetatable({}, {__mode = "k"}), Fail = setmetatable({}, {__mode = "k"})}
local FRUIT_NAMES = {
    "bomb","spike","chop","spring","kilo","smoke","twist","float","flame","ice","sand","dark",
    "revive","diamond","light","rubber","barrier","magma","quake","human","bird","phoenix","paw",
    "gravity","dough","shadow","venom","control","spirit","dragon","leopard","kitsune","gas",
    "blizzard","rumble","mammoth","t-rex",
}
FruitSniper.StoreVariant = nil
FruitSniper.Busy = false

function FruitSniper.IsFruit(obj)
    if not obj:IsA("Tool") then return false end
    local n = obj.Name:lower()
    if n:find("fruit", 1, true) then return true end
    for _, fn in ipairs(FRUIT_NAMES) do
        if n == fn or n:sub(1, #fn + 1) == fn .. "-" then return true end
    end
    return false
end

function FruitSniper.Scan()
    local fruits = {}
    local my = Utils.GetPos()
    for _, obj in ipairs(Workspace:GetChildren()) do
        if FruitSniper.IsFruit(obj) then
            local part = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart", true)
            if part then table.insert(fruits, {obj = obj, part = part, name = obj.Name, dist = Utils.Distance(my, part.Position)}) end
        end
    end
    table.sort(fruits, function(a, b) return a.dist < b.dist end)
    return fruits
end

-- Tool is on the player? (Backpack or held in Character)
local function inBag(tool)
    if tool == nil or tool.Parent == nil then return false end
    if tool:IsDescendantOf(LocalPlayer) then return true end
    local ch = LocalPlayer.Character
    return ch ~= nil and tool:IsDescendantOf(ch)
end

-- Stores a fruit. Several argument formats are tried; the working one is remembered.
function FruitSniper.StoreOne(tool)
    local name = tool.Name
    local base = name:match("^(.-)%-") or name
    local tries = {
        function() Utils.Invoke("StoreFruit", name, "Storage") end,
        function() Utils.Invoke("StoreFruit", name) end,
        function() Utils.Invoke("StoreFruit", base, "Storage") end,
        function() Utils.Invoke("StoreFruit", base) end,
        function() Utils.Invoke("StoreFruit", name, "Inventory") end,
    }
    local order = {}
    if FruitSniper.StoreVariant then table.insert(order, FruitSniper.StoreVariant) end
    for i = 1, #tries do
        if i ~= FruitSniper.StoreVariant then table.insert(order, i) end
    end
    for _, i in ipairs(order) do
        if not inBag(tool) then return true end
        tries[i]()
        task.wait(0.6)
        if not inBag(tool) then
            if FruitSniper.StoreVariant ~= i then
                FruitSniper.StoreVariant = i
                Log("Storage call format found (#" .. i .. ")")
            end
            Utils.Notify("Stored: " .. name, 3, "success")
            return true
        end
    end
    Log("Could not store: " .. name .. " (StoreFruit format did not match)", "WARN")
    return false
end

function FruitSniper.StoreAll()
    local list = {}
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if FruitSniper.IsFruit(t) then table.insert(list, t) end
        end
    end
    local ch = LocalPlayer.Character
    if ch then
        for _, t in ipairs(ch:GetChildren()) do
            if FruitSniper.IsFruit(t) then table.insert(list, t) end
        end
    end
    for _, t in ipairs(list) do
        if not State.AutoFruit then break end
        local f = FruitSniper.Fail[t]
        if not (f and os.clock() < f) then
            if not FruitSniper.StoreOne(t) then
                FruitSniper.Fail[t] = os.clock() + 30
            end
        end
    end
end

function FruitSniper.Pick(f)
    local root = Utils.GetRootPart()
    if not root or not f.part.Parent then return false end
    Utils.FireTouch(root, f.part)
    local pp = f.obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if pp then Utils.FireProximity(pp) end
    local t0 = os.clock()
    while os.clock() - t0 < 2.5 and not inBag(f.obj) do task.wait(0.2) end
    return inBag(f.obj)
end

function FruitSniper.Loop()
    task.spawn(function()
        local active = false
        local function off() return not State.AutoFruit or State.AutoFarm or Farm.BossBusy or Raid.Active or Utils.EventBusy() end
        while State.Running do
            if not off() and not Paused() then
                active = true
                local ok, err = pcall(function()
                    for _, f in ipairs(FruitSniper.Scan()) do
                        if off() then break end
                        local seen = FruitSniper.Known[f.obj]
                        if not seen or os.clock() - seen > 20 then
                            FruitSniper.Known[f.obj] = os.clock()
                            State.Status = "Flying to fruit: " .. f.name
                            FruitSniper.Busy = true
                            if Flight.To(f.part.Position + Vector3.new(0, 2, 0), 3, off) and not off() then
                                if FruitSniper.Pick(f) then
                                    Utils.Notify("Fruit picked up: " .. f.name, 4, "success")
                                end
                            end
                            FruitSniper.Busy = false
                            break
                        end
                    end
                    if not off() then FruitSniper.StoreAll() end
                end)
                FruitSniper.Busy = false
                if not ok then Log("Fruit: " .. tostring(err), "WARN"); State.Traveling = false end
            elseif active then
                active = false
                FruitSniper.Busy = false
                State.Traveling = false
                if not State.AutoFarm and not State.AutoBoss and not State.AutoChest then State.Status = "Idle" end
            end
            task.wait(Utils.RandomDelay(1.5, 0.3))
        end
    end)
end

-- ============================================================
-- CHEST: visit islands, collect loaded chests
-- ============================================================
local ChestFarm = {
    Done = setmetatable({}, {__mode = "k"}),
    Tries = setmetatable({}, {__mode = "k"}),
    Banned = setmetatable({}, {__mode = "k"}),
    LastScan = 0, Idx = 0,
}

function ChestFarm.Scan()
    ChestFarm.LastScan = os.clock()
    local n = 0
    for _, d in ipairs(Workspace:GetDescendants()) do
        n = n + 1
        if n % 2000 == 0 then task.wait() end
        if Utils.IsChest(d) then
            local p = d.Parent
            local inside = d:IsA("BasePart") and p and p:IsA("Model") and Utils.IsChest(p)
            if not inside then Registry.Chests[d] = true end
        end
    end
    for model in pairs(Registry.Chests) do
        if not model.Parent or not Utils.IsChest(model) then Registry.Chests[model] = nil end
    end
end

function ChestFarm.Points()
    local wo = Workspace:FindFirstChild("_WorldOrigin")
    local locs = wo and wo:FindFirstChild("Locations")
    local pts = {}
    if locs then
        for _, c in ipairs(locs:GetChildren()) do
            local pos
            if c:IsA("BasePart") then
                pos = c.Position
            elseif c:IsA("Model") then
                local r = Utils.ModelRoot(c)
                if r then pos = r.Position end
            end
            if pos then table.insert(pts, pos) end
        end
    end
    return pts
end

function ChestFarm.Nearest()
    local my = Utils.GetPos()
    local best, bestD, bestModel
    for model in pairs(Registry.Chests) do
        if not model.Parent then
            Registry.Chests[model] = nil
        else
            local doneAt = ChestFarm.Done[model]
            local ban = ChestFarm.Banned[model]
            if not (doneAt and os.clock() - doneAt < 30) and not (ban and os.clock() < ban) then
                local part = model:IsA("BasePart") and model
                    or model.PrimaryPart
                    or model:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    local d = Utils.Distance(my, part.Position)
                    if not bestD or d < bestD then best, bestD, bestModel = part, d, model end
                end
            end
        end
    end
    return best, bestModel
end

function ChestFarm.NextIsland(off)
    local pts = ChestFarm.Points()
    if #pts == 0 then
        State.Status = "Chest: island points not found"
        ChestFarm.Scan()
        task.wait(3)
        return
    end
    ChestFarm.Idx = ChestFarm.Idx % #pts + 1
    local p = pts[ChestFarm.Idx]
    State.Status = "Chest scan: point " .. ChestFarm.Idx .. "/" .. #pts
    local hover = p + Vector3.new(0, 40, 0)
    if not Flight.To(hover, 8, off) then return end
    State.HoldCF = CFrame.new(hover)
    pcall(function() LocalPlayer:RequestStreamAroundAsync(p, 300) end)
    task.wait(1.5)
    State.HoldCF = nil
    ChestFarm.Scan()
end

function ChestFarm.Loop()
    task.spawn(function()
        local active = false
        local function off()
            return not State.AutoChest or State.AutoFarm or Farm.BossBusy or FruitSniper.Busy or Raid.Active or Utils.EventBusy()
        end
        while State.Running do
            if not off() and not Paused() then
                active = true
                local ok, err = pcall(function()
                    if os.clock() - ChestFarm.LastScan > 12 then ChestFarm.Scan() end
                    local part, model = ChestFarm.Nearest()
                    if part then
                        State.Status = "Flying to chest"
                        if Flight.To(part.Position + Vector3.new(0, 2, 0), 3, off) and not off() then
                            ChestFarm.Done[model] = os.clock()
                            ChestFarm.Tries[model] = (ChestFarm.Tries[model] or 0) + 1
                            if ChestFarm.Tries[model] >= 3 then
                                ChestFarm.Banned[model] = os.clock() + 300
                                ChestFarm.Tries[model] = nil
                                Log("Chest tried 3 times, not collected -> skipped for 5 min: " .. model.Name, "WARN")
                            end
                            local root = Utils.GetRootPart()
                            if root then Utils.FireTouch(root, part) end
                            local pp = model:FindFirstChildWhichIsA("ProximityPrompt", true)
                            if pp then Utils.FireProximity(pp) end
                            task.wait(Utils.RandomDelay(1.2, 0.3))
                        end
                    else
                        ChestFarm.NextIsland(off)
                    end
                end)
                if not ok then
                    Log("Chest: " .. tostring(err), "WARN")
                    State.Traveling, State.HoldCF = false, nil
                end
            else
                if active then
                    active = false
                    State.Traveling, State.HoldCF = false, nil
                    if not State.AutoFarm and not State.AutoBoss and not State.AutoFruit then State.Status = "Idle" end
                end
                task.wait(1)
            end
            task.wait(0.2)
        end
    end)
end


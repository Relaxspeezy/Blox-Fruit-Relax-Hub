-- Counts how many island names of each sea exist in the loaded world
local function seaFromWorld()
    local scores = {0, 0, 0}
    local function scan(folder)
        if not folder then return end
        for _, c in ipairs(folder:GetChildren()) do
            local n = c.Name:lower()
            for sea = 1, 3 do
                for _, m in ipairs(SEA_MARKERS[sea]) do
                    if n:find(m, 1, true) then
                        scores[sea] = scores[sea] + 1
                        break
                    end
                end
            end
        end
    end
    local wo = Workspace:FindFirstChild("_WorldOrigin")
    scan(wo and wo:FindFirstChild("Locations"))
    scan(Workspace:FindFirstChild("Map"))
    local best, bestN = nil, 0
    for sea = 1, 3 do
        if scores[sea] > bestN then best, bestN = sea, scores[sea] end
    end
    return best
end


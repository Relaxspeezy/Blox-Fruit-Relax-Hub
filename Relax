function Flight.Init()
    table.insert(State.Connections, RunService.Heartbeat:Connect(function()
        local root = Utils.GetRootPart()
        if not root then return end
        local need = State.Traveling or State.HoldCF ~= nil or os.clock() < State.LockUntil
        Flight.Lock(root, need)
        if need and not State.Traveling then
            local cf = State.HoldCF
            if cf then
                local d = cf.Position - root.Position
                local m = d.Magnitude
                if m > 90 then
                    State.HoldCF = nil
                    Log("Hold point too far, cancelled", "WARN")
                else
                    local pos = m > 5 and (root.Position + d.Unit * 5) or cf.Position
                    root.CFrame = CFrame.new(pos) * (cf - cf.Position)
                end
            end
            root.AssemblyLinearVelocity = ZERO
            root.AssemblyAngularVelocity = ZERO
        end
    end))
    table.insert(State.Connections, RunService.Stepped:Connect(function()
        if State.Traveling or State.HoldCF or os.clock() < State.LockUntil then
            local char = LocalPlayer.Character
            if char then
                for _, p in ipairs(char:GetChildren()) do
                    if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
                end
            end
        end
    end))
    table.insert(State.Connections, RunService.Heartbeat:Connect(function()
        local root = Utils.GetRootPart()
        if root and root.Position.Y < -80 and not State.Traveling then
            pcall(function() root.CFrame = CFrame.new(root.Position.X, 60, root.Position.Z) end)
            Log("Fell into the void: moved back up", "WARN")
        end
    end))
end

-- Flies to target. cancel() returning true stops the flight immediately.
function Flight.To(target, tol, cancel)
    tol = tol or 3
    State.HoldCF = nil
    local baseSpeed = math.max(60, State.FlySpeed)
    local speed = baseSpeed

    local function stop()
        if not State.Running then return true end
        if (Factory.Active and not Factory.Mine) or (CakeP.Active and not CakeP.Mine) then return true end
        return cancel ~= nil and cancel() == true
    end
    local function finish(ok)
        State.Traveling = false
        State.LockUntil = os.clock() + 0.35
        return ok
    end

    for attempt = 1, 5 do
        if stop() then return finish(false) end
        local root = Utils.GetRootPart()
        if not root then
            task.wait(0.5)
        else
            State.Traveling = true
            if State.InstantTP then
                pcall(function() root.CFrame = CFrame.new(target) * (root.CFrame - root.CFrame.Position) end)
                task.wait(0.15)
            else
                local startDist = (target - root.Position).Magnitude
                local deadline = os.clock() + startDist / (baseSpeed * 0.5) + 10
                local lastSet = root.Position
                local snaps, lastSnap = 0, 0
                while true do
                    if stop() then return finish(false) end
                    local dt = math.min(RunService.Heartbeat:Wait(), 0.25)
                    root = Utils.GetRootPart()
                    if not root then break end
                    local cur = root.Position
                    if (cur - lastSet).Magnitude > 25 then
                        snaps = snaps + 1
                        lastSnap = os.clock()
                        speed = math.max(baseSpeed * 0.5, speed * 0.88)
                        if snaps % 8 == 0 then
                            Log("Server is pushing back: speed " .. math.floor(speed), "WARN")
                        end
                        if snaps > 30 then break end
                    elseif speed < baseSpeed and os.clock() - lastSnap > 1.2 then
                        speed = math.min(baseSpeed, speed + baseSpeed * 0.25 * dt)
                    end
                    local delta = target - cur
                    local dist = delta.Magnitude
                    if dist <= tol then break end
                    if os.clock() > deadline then break end
                    local newPos = cur + delta.Unit * math.min(dist, speed * dt)
                    root.CFrame = CFrame.new(newPos) * (root.CFrame - root.CFrame.Position)
                    root.AssemblyLinearVelocity = ZERO
                    lastSet = newPos
                end
            end

            for _ = 1, 8 do
                if stop() then return finish(false) end
                root = Utils.GetRootPart()
                if not root then break end
                local d = (root.Position - target).Magnitude
                if d > 1.5 and (State.InstantTP or d < 60) then
                    root.CFrame = CFrame.new(target) * (root.CFrame - root.CFrame.Position)
                end
                root.AssemblyLinearVelocity = ZERO
                RunService.Heartbeat:Wait()
            end
            root = Utils.GetRootPart()
            if root and (root.Position - target).Magnitude <= tol + 3 then
                return finish(true)
            end
            Log("Could not reach target, retrying (" .. attempt .. "/5)", "WARN")
            task.wait(0.4)
        end
    end
    return finish(false)
end

-- Finds the ground under X,Z (skips invisible / non-collidable parts)
function Flight.GroundAt(pos)
    local ex = {}
    if LocalPlayer.Character then table.insert(ex, LocalPlayer.Character) end
    local en = Workspace:FindFirstChild("Enemies")
    if en then table.insert(ex, en) end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local origin = Vector3.new(pos.X, math.max(pos.Y, 0) + 600, pos.Z)
    for _ = 1, 8 do
        params.FilterDescendantsInstances = ex
        local ok, res = pcall(function() return Workspace:Raycast(origin, Vector3.new(0, -2000, 0), params) end)
        if not ok or not res then break end
        local inst = res.Instance
        if inst:IsA("Terrain") or (inst.CanCollide and inst.Transparency < 0.95) then
            return res.Position + Vector3.new(0, 5, 0)
        end
        table.insert(ex, inst)
    end
    return nil
end

-- Manual teleport
function Flight.Go(target, ground)
    if ground then
        target = Flight.GroundAt(target) or (target + Vector3.new(0, 30, 0))
    end
    State.Status = "Teleporting"
    local ok = Flight.To(target, 3)
    if ok then
        local cf = CFrame.new(target)
        State.HoldCF = cf
        task.wait(0.7)
        if State.HoldCF == cf then State.HoldCF = nil end
        Utils.Notify("Teleport complete ✔", 3, "success")
    else
        Utils.Notify("Teleport failed (try a lower fly speed)", 4, "warn")
    end
    if not State.AutoFarm and not State.AutoBoss then State.Status = "Idle" end
    return ok
end


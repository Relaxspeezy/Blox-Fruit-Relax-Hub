        end
        if not parent then
            local okP = pcall(function()
                local f = Instance.new("Folder")
                f.Parent = game:GetService("CoreGui")
                f:Destroy()
            end)
            parent = okP and game:GetService("CoreGui") or LP:WaitForChild("PlayerGui")
        end
        local old = parent:FindFirstChild("RelaxHubKeyGui")
        if old then old:Destroy() end

        local gui = new("ScreenGui", {
            Name = "RelaxHubKeyGui", ResetOnSpawn = false, IgnoreGuiInset = true,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 999,
        })
        pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)
        gui.Parent = parent

        -- background blur
        local blur
        pcall(function()
            blur = nil
        end)

        local backdrop = new("Frame", {
            Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
            BackgroundTransparency = 1, BorderSizePixel = 0, Parent = gui,
        })

        ----------------------------------------------------------------
        -- card
        ----------------------------------------------------------------
        local cam = workspace.CurrentCamera
        local vs = cam and cam.ViewportSize or Vector2.new(1280, 720)
        local devScale = math.clamp(math.min(vs.Y / 600, vs.X / 420), 0.6, 1.1)

        local holder = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(380, 316), BackgroundTransparency = 1, Parent = gui,
        }, { new("UIScale", { Scale = devScale }) })

        local shadow = new("ImageLabel", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 6),
            Size = UDim2.new(1, 56, 1, 56), BackgroundTransparency = 1,
            Image = "rbxassetid://6014261993", ImageColor3 = Color3.new(0, 0, 0), ImageTransparency = 1,
            ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(49, 49, 450, 450), Parent = holder,
        })

        local entry = new("UIScale", { Scale = 0.9 })
        local main = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
            Active = true, Parent = holder,
        }, { corner(16), grad(C.Card, C.CardLo, 90), entry })

        -- animated border
        local borderStroke = stroke(C.Accent, 1.5, 0.15)
        borderStroke.Parent = main
        local borderGrad = new("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, C.Accent),
                ColorSequenceKeypoint.new(0.5, C.Cyan),
                ColorSequenceKeypoint.new(1, C.Accent),
            }),
            Parent = borderStroke,
        })
        local spin = RunService.Heartbeat:Connect(function(dt)
            borderGrad.Rotation = (borderGrad.Rotation + dt * 70) % 360
        end)

        -- header
        new("Frame", {
            Size = UDim2.fromOffset(46, 46), Position = UDim2.fromOffset(20, 18),
            BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = main,
        }, {
            corner(13), grad(C.Accent, C.Cyan, 45),
            new("TextLabel", {
                Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "R",
                TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBlack, TextSize = 26,
            }),
        })
        new("TextLabel", {
            Size = UDim2.new(1, -150, 0, 24), Position = UDim2.fromOffset(76, 20), BackgroundTransparency = 1,
            Text = "Relax Hub", TextColor3 = C.Text, Font = Enum.Font.GothamBlack, TextSize = 20,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = main,
        })
        new("TextLabel", {
            Size = UDim2.new(1, -150, 0, 16), Position = UDim2.fromOffset(76, 45), BackgroundTransparency = 1,
            Text = "Blox Fruits  •  Key System", TextColor3 = C.Dim, Font = Enum.Font.Gotham, TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = main,
        })
        local closeBtn = new("TextButton", {
            Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, -48, 0, 27), BackgroundColor3 = C.Panel,
            Text = "✕", TextColor3 = C.Dim, Font = Enum.Font.GothamBold, TextSize = 13,
            AutoButtonColor = false, Parent = main,
        }, { corner(8) })

        new("Frame", {
            Size = UDim2.new(1, -40, 0, 1), Position = UDim2.fromOffset(20, 78),
            BackgroundColor3 = C.Border, BackgroundTransparency = 0.35, BorderSizePixel = 0, Parent = main,
        })

        -- key field
        new("TextLabel", {
            Size = UDim2.new(1, -40, 0, 14), Position = UDim2.fromOffset(22, 92), BackgroundTransparency = 1,
            Text = "LICENSE KEY", TextColor3 = C.Dim, Font = Enum.Font.GothamBold, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = main,
        })
        local field = new("Frame", {
            Size = UDim2.new(1, -40, 0, 46), Position = UDim2.fromOffset(20, 112),
            BackgroundColor3 = C.Field, BorderSizePixel = 0, Parent = main,
        }, { corner(11) })
        local fieldStroke = stroke(C.Border, 1)
        fieldStroke.Parent = field
        new("TextLabel", {
            Size = UDim2.fromOffset(40, 46), BackgroundTransparency = 1, Text = "🔑", TextSize = 16,
            Font = Enum.Font.Gotham, TextColor3 = C.Dim, Parent = field,
        })
        local box = new("TextBox", {
            Size = UDim2.new(1, -52, 1, 0), Position = UDim2.fromOffset(40, 0), BackgroundTransparency = 1,
            Text = savedKey, PlaceholderText = "Paste your key here", PlaceholderColor3 = C.Off, TextColor3 = C.Text,

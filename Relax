-- Slider: drag it or fine-tune with -/+
function UI.Slider(parent, title, minV, maxV, get, set, suffix, step)
    suffix = suffix or ""
    step = step or math.max(1, math.floor((maxV - minV) / 40))
    local f = newRow(parent, 50)
    mk("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 4), Size = UDim2.new(1, -116, 0, 20),
        Text = title, TextColor3 = T.Text, Font = Enum.Font.GothamMedium, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd}, f)
    local minus = mk("TextButton", {BackgroundColor3 = T.CardHi, Position = UDim2.new(1, -108, 0, 5), Size = UDim2.new(0, 22, 0, 18),
        Text = "−", TextColor3 = T.Text, Font = Enum.Font.GothamBold, TextSize = 13, BorderSizePixel = 0}, f)
    corner(minus, 6)
    local badge = mk("TextLabel", {BackgroundColor3 = T.Panel, Position = UDim2.new(1, -82, 0, 5), Size = UDim2.new(0, 58, 0, 18),
        Text = "", TextColor3 = T.Cyan, Font = Enum.Font.GothamBold, TextSize = 11, BorderSizePixel = 0}, f)
    corner(badge, 6)
    local plus = mk("TextButton", {BackgroundColor3 = T.CardHi, Position = UDim2.new(1, -22, 0, 5), Size = UDim2.new(0, 22, 0, 18),
        Text = "+", TextColor3 = T.Text, Font = Enum.Font.GothamBold, TextSize = 13, BorderSizePixel = 0}, f)
    corner(plus, 6)
    local hit = mk("Frame", {BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 27), Size = UDim2.new(1, 0, 0, 20)}, f)
    local track = mk("Frame", {Size = UDim2.new(1, -8, 0, 5), Position = UDim2.new(0, 4, 0.5, -2),
        BackgroundColor3 = T.Off, BorderSizePixel = 0}, hit)
    corner(track, 3)
    local fill = mk("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0}, track)
    corner(fill, 3)
    gradient(fill, T.Accent, T.Cyan, 0)
    local handle = mk("Frame", {Size = UDim2.new(0, 14, 0, 14), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0}, track)
    corner(handle, 7)

    local function refresh()
        local v = get()
        local t = math.clamp((v - minV) / (maxV - minV), 0, 1)
        fill.Size = UDim2.new(t, 0, 1, 0)
        handle.Position = UDim2.new(t, 0, 0.5, 0)
        badge.Text = tostring(math.floor(v + 0.5)) .. suffix
    end
    refresh()

    local function setFromX(x)
        local ta, ts = track.AbsolutePosition, track.AbsoluteSize
        if ts.X <= 0 then return end
        local t = math.clamp((x - ta.X) / ts.X, 0, 1)
        set(math.floor(minV + t * (maxV - minV) + 0.5))
        refresh()
    end

    minus.MouseButton1Click:Connect(function() set(math.clamp(get() - step, minV, maxV)); refresh() end)
    plus.MouseButton1Click:Connect(function() set(math.clamp(get() + step, minV, maxV)); refresh() end)

    local dragging, trackInput, scroller = false, nil, nil
    local function stop()
        dragging = false
        trackInput = nil
        if scroller then scroller.ScrollingEnabled = true; scroller = nil end
    end
    hit.InputBegan:Connect(function(i)
        if isPointer(i) then
            dragging, trackInput = true, i
            scroller = f:FindFirstAncestorOfClass("ScrollingFrame")
            if scroller then scroller.ScrollingEnabled = false end
            setFromX(i.Position.X)
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then stop() end
            end)
        end
    end)
    table.insert(State.Connections, UserInputService.InputChanged:Connect(function(i)
        if dragging and (i == trackInput or i.UserInputType == Enum.UserInputType.MouseMovement) then
            setFromX(i.Position.X)
        end
    end))
    table.insert(State.Connections, UserInputService.InputEnded:Connect(function(i)
        if dragging and (i == trackInput or isPointer(i)) then stop() end
    end))
    table.insert(UI.Refreshers, refresh)
    return f
end

-- Segmented selector (wraps into a grid when there are many options)
function UI.Selector(parent, title, options, get, set)
    local n = #options
    local cols = n <= 4 and n or 3
    local rows = math.ceil(n / cols)
    local f = newRow(parent, 24 + rows * 28 + 4)
    mk("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 4), Size = UDim2.new(1, 0, 0, 16),
        Text = title, TextColor3 = T.TextDim, Font = Enum.Font.GothamMedium, TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left}, f)
    local grid = mk("Frame", {BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, 0, 0, rows * 28)}, f)
    mk("UIGridLayout", {CellSize = UDim2.new(1 / cols, -4, 0, 24), CellPadding = UDim2.new(0, 4, 0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder}, grid)
    local btns = {}
    for idx, opt in ipairs(options) do
        local b = mk("TextButton", {BackgroundColor3 = T.Panel, Text = opt, TextColor3 = T.TextDim, Font = Enum.Font.GothamBold,
            TextScaled = true, BorderSizePixel = 0, LayoutOrder = idx}, grid)
        corner(b, 6)
        mk("UITextSizeConstraint", {MaxTextSize = 11, MinTextSize = 8}, b)
        btns[idx] = b
        b.MouseButton1Click:Connect(function()
            set(opt)
            for _, r in ipairs(UI.Refreshers) do pcall(r) end
        end)
    end
    local function refresh()
        for idx, b in ipairs(btns) do
            local sel = get() == options[idx]
            b.BackgroundColor3 = sel and T.Accent or T.Panel
            b.TextColor3 = sel and WHITE or T.TextDim
        end
    end
    refresh()
    table.insert(UI.Refreshers, refresh)
    return f
end


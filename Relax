            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = field,
        })
        box.Focused:Connect(function() tw(fieldStroke, 0.15, { Color = C.Accent }) end)
        box.FocusLost:Connect(function() tw(fieldStroke, 0.15, { Color = C.Border }) end)

        -- status
        local dot = new("Frame", {
            Size = UDim2.fromOffset(8, 8), Position = UDim2.fromOffset(24, 175), BackgroundColor3 = C.Off,
            BorderSizePixel = 0, Parent = main,
        }, { corner(4) })
        local status = new("TextLabel", {
            Size = UDim2.new(1, -52, 0, 18), Position = UDim2.fromOffset(38, 170), BackgroundTransparency = 1,
            Text = "Waiting for your key", TextColor3 = C.Dim, Font = Enum.Font.Gotham, TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = main,
        })
        local function setStatus(msg, kind)
            local col = kind == "ok" and C.Ok or kind == "bad" and C.Bad or kind == "busy" and C.Warn or C.Dim
            status.Text = msg
            tw(status, 0.15, { TextColor3 = (kind == "idle" or kind == nil) and C.Dim or col })
            tw(dot, 0.15, { BackgroundColor3 = (kind == "idle" or kind == nil) and C.Off or col })
        end

        -- remember toggle
        local remember = rememberPref
        local sw = new("TextButton", {
            Size = UDim2.fromOffset(36, 20), Position = UDim2.fromOffset(20, 198), BackgroundColor3 = remember and C.Accent or C.Off,
            Text = "", AutoButtonColor = false, Parent = main,
        }, { corner(10) })
        local knob = new("Frame", {
            Size = UDim2.fromOffset(14, 14), Position = remember and UDim2.fromOffset(19, 3) or UDim2.fromOffset(3, 3), BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0, Parent = sw,
        }, { corner(7) })
        local rememberLbl = new("TextButton", {
            Size = UDim2.new(1, -80, 0, 20), Position = UDim2.fromOffset(64, 198), BackgroundTransparency = 1,
            Text = "Remember my key", TextColor3 = C.Dim, Font = Enum.Font.Gotham, TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, Parent = main,
        })
        local function toggleRemember()
            remember = not remember
            tw(sw, 0.15, { BackgroundColor3 = remember and C.Accent or C.Off })
            tw(knob, 0.15, { Position = remember and UDim2.fromOffset(19, 3) or UDim2.fromOffset(3, 3) })
            if writefile then pcall(writefile, REMEMBER_FILE, remember and "1" or "0") end
            if not remember then deleteSavedKey() end
        end
        sw.MouseButton1Click:Connect(toggleRemember)
        rememberLbl.MouseButton1Click:Connect(toggleRemember)

        -- buttons
        local verifyBtn = new("TextButton", {
            Size = UDim2.fromOffset(130, 46), Position = UDim2.fromOffset(20, 232), BackgroundColor3 = Color3.new(1, 1, 1),
            Text = "", AutoButtonColor = false, BorderSizePixel = 0, Parent = main,
        }, { corner(11), grad(C.Accent, C.Cyan, 20), new("UIScale", { Scale = 1 }) })
        -- text lives in a child label so the button gradient does not tint it
        local verifyLbl = new("TextLabel", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "Verify",
            TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold, TextSize = 15, ZIndex = 2, Parent = verifyBtn,
        })
        local getBtn = new("TextButton", {
            Size = UDim2.fromOffset(98, 46), Position = UDim2.fromOffset(158, 232), BackgroundColor3 = C.Panel,
            Text = "Get Key", TextColor3 = C.Text, Font = Enum.Font.GothamBold, TextSize = 14,
            AutoButtonColor = false, BorderSizePixel = 0, Parent = main,
        }, { corner(11), stroke(C.Border, 1), new("UIScale", { Scale = 1 }) })
        local discordBtn = new("TextButton", {
            Size = UDim2.fromOffset(96, 46), Position = UDim2.fromOffset(264, 232), BackgroundColor3 = C.Panel,
            Text = "Discord", TextColor3 = Color3.fromRGB(129, 140, 248), Font = Enum.Font.GothamBold, TextSize = 14,
            AutoButtonColor = false, BorderSizePixel = 0, Parent = main,
        }, { corner(11), stroke(Color3.fromRGB(88, 101, 242), 1), new("UIScale", { Scale = 1 }) })

        local function hoverable(btn, baseCol)
            local sc = btn:FindFirstChildOfClass("UIScale")
            btn.MouseEnter:Connect(function()
                tw(sc, 0.12, { Scale = 1.03 })
                if baseCol then tw(btn, 0.12, { BackgroundColor3 = Color3.fromRGB(38, 40, 64) }) end
            end)
            btn.MouseLeave:Connect(function()
                tw(sc, 0.12, { Scale = 1 })
                if baseCol then tw(btn, 0.12, { BackgroundColor3 = baseCol }) end
            end)
            btn.MouseButton1Down:Connect(function() tw(sc, 0.07, { Scale = 0.96 }) end)
            btn.MouseButton1Up:Connect(function() tw(sc, 0.1, { Scale = 1.03 }) end)
        end
        hoverable(verifyBtn)
        hoverable(getBtn, C.Panel)
        hoverable(discordBtn, C.Panel)
        closeBtn.MouseEnter:Connect(function() tw(closeBtn, 0.12, { BackgroundColor3 = C.Bad, TextColor3 = Color3.new(1, 1, 1) }) end)
        closeBtn.MouseLeave:Connect(function() tw(closeBtn, 0.12, { BackgroundColor3 = C.Panel, TextColor3 = C.Dim }) end)

        new("TextLabel", {
            Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 292), BackgroundTransparency = 1,
            Text = "Powered by Panda Auth", TextColor3 = C.Off, Font = Enum.Font.Gotham, TextSize = 11, Parent = main,
        })

        ----------------------------------------------------------------
        -- drag (by the card)
        ----------------------------------------------------------------
        do
            local dragging, startPos, startInput
            main.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                    dragging, startPos, startInput = true, holder.Position, i.Position
                    i.Changed:Connect(function()
                        if i.UserInputState == Enum.UserInputState.End then dragging = false end
                    end)
                end
            end)
            UIS.InputChanged:Connect(function(i)
                if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                    local d = i.Position - startInput
                    holder.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
                end
            end)
        end

        ----------------------------------------------------------------
        -- animations
        ----------------------------------------------------------------
        local function fadeIn()
            tw(backdrop, 0.35, { BackgroundTransparency = 1 })
            if blur then tw(blur, 0.35, { Size = 14 }) end
            tw(shadow, 0.35, { ImageTransparency = 0.7 })
            tw(entry, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
        end
        local function fadeOut()
            tw(backdrop, 0.28, { BackgroundTransparency = 1 })
            if blur then tw(blur, 0.28, { Size = 0 }) end
            tw(shadow, 0.28, { ImageTransparency = 1 })
            main.Visible = false
            tw(entry, 0.28, { Scale = 0.92 })
            task.wait(0.3)
        end
        local function shake()
            local base = holder.Position
            for i = 1, 4 do
                tw(holder, 0.04, { Position = base + UDim2.fromOffset(i % 2 == 0 and 9 or -9, 0) })
                task.wait(0.045)
            end
            tw(holder, 0.06, { Position = base })
        end
        fadeIn()

        ----------------------------------------------------------------
        -- logic
        ----------------------------------------------------------------
        local closed, busy = false, false

        local function verify()
            if busy then return end
            local k = box.Text:gsub("%s+", "")
            if k == "" then
                setStatus("Please enter your key first", "bad")
                task.spawn(shake)
                return
            end
            busy = true
            setStatus("Checking your key...", "busy")
            task.spawn(function()
                local n = 0
                while busy do
                    n = n % 3 + 1
                    verifyLbl.Text = "Verifying" .. string.rep(".", n)
                    task.wait(0.3)
                end
                verifyLbl.Text = "Verify"
            end)
            local ok, res = check(k)
            if ok then
                local prem = type(res) == "table" and res.isPremium
                setStatus(prem and "Key accepted  •  Premium" or "Key accepted  •  Welcome!", "ok")
                if remember then
                    if writefile then pcall(writefile, KEY_FILE, k) end
                else
                    deleteSavedKey()
                end
                busy = false
                task.wait(0.9)
                authed = true
            else
                busy = false
                setStatus("Invalid or expired key", "bad")
                task.spawn(shake)
            end
        end

        verifyBtn.MouseButton1Click:Connect(verify)
        box.FocusLost:Connect(function(enter) if enter then verify() end end)
        local function copyText(txt)
            local copied = false
            if setclipboard then copied = pcall(setclipboard, txt) end
            if not copied and toclipboard then copied = pcall(toclipboard, txt) end
            return copied
        end
        getBtn.MouseButton1Click:Connect(function()
            local url = getKeyUrl()
            if copyText(url) then
                setStatus("Key link copied  •  open it in your browser", "ok")
            else
                box.Text = url
                setStatus("Clipboard not supported  •  copy the link above", "busy")
            end
        end)
        discordBtn.MouseButton1Click:Connect(function()
            if copyText(DISCORD_URL) then
                setStatus("Discord link copied  •  open it in your browser", "ok")
            else
                box.Text = DISCORD_URL
                setStatus("Clipboard not supported  •  copy the link above", "busy")
            end
        end)
        closeBtn.MouseButton1Click:Connect(function()
            closed = true
            if not remember then deleteSavedKey() end
        end)

        while not authed and not closed do task.wait(0.1) end

        fadeOut()
        spin:Disconnect()
        if blur then blur:Destroy() end
        gui:Destroy()
    end

    if not authed then return end
    print("[Panda] Authenticated.")
end

if not game:IsLoaded() then game.Loaded:Wait() end


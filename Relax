function UI.ShowNotification(msg, duration, kind)
    local box = UI.NotifBox
    if not box then return end
    local colors = {info = T.Accent, success = T.Success, warn = T.Warn, danger = T.Danger}
    local col = colors[kind or "info"] or T.Accent
    local frames = {}
    for _, c in ipairs(box:GetChildren()) do
        if c:IsA("Frame") then table.insert(frames, c) end
    end
    while #frames >= 4 do
        frames[1]:Destroy()
        table.remove(frames, 1)
    end
    local nf = mk("Frame", {Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = T.Panel, BackgroundTransparency = 1,
        BorderSizePixel = 0, ZIndex = 200}, box)
    corner(nf, 8)
    local st = stroke(nf, col, 1, 1)
    local bar = mk("Frame", {Size = UDim2.new(0, 3, 1, -14), Position = UDim2.new(0, 7, 0, 7), BackgroundColor3 = col,
        BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 201}, nf)
    corner(bar, 2)
    local nl = mk("TextLabel", {Size = UDim2.new(1, -26, 1, 0), Position = UDim2.new(0, 20, 0, 0), BackgroundTransparency = 1,
        Text = msg, TextColor3 = T.Text, TextTransparency = 1, TextWrapped = true, Font = Enum.Font.Gotham, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 201}, nf)
    tween(nf, 0.2, {BackgroundTransparency = 0.05})
    tween(bar, 0.2, {BackgroundTransparency = 0})
    tween(nl, 0.2, {TextTransparency = 0})
    tween(st, 0.2, {Transparency = 0.3})
    task.delay(duration or 4, function()
        pcall(function()
            tween(nf, 0.3, {BackgroundTransparency = 1})
            tween(bar, 0.3, {BackgroundTransparency = 1})
            tween(nl, 0.3, {TextTransparency = 1})
            tween(st, 0.3, {Transparency = 1})
            task.wait(0.32)
            nf:Destroy()
        end)
    end)
end


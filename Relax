local Utils = {}

function Utils.Has(s, sub)
    return string.find(string.lower(s), string.lower(sub), 1, true) ~= nil
end

function Utils.RandomDelay(base, variance)
    base = base or 0.3
    variance = variance or 0.15
    return math.max(0.01, base + (math.random() * 2 - 1) * variance)
end

function Utils.GetCharacter() return LocalPlayer.Character end
function Utils.GetHumanoid()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end
function Utils.GetRootPart()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end
function Utils.GetPos()
    local r = Utils.GetRootPart()
    return r and r.Position or ZERO
end
function Utils.Distance(a, b) return (a - b).Magnitude end

function Utils.ModelRoot(model)
    return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
end

-- Real chest = name exactly "Chest" / "Chest1" / "Chest2"... (not NPCs, enemies, markers, giant parts)
function Utils.IsChest(inst)
    local c = inst.Name:byte(1)
    if c ~= 67 and c ~= 99 then return false end
    if not (inst:IsA("Model") or inst:IsA("BasePart")) then return false end
    if not inst.Name:lower():match("^chest%d*$") then return false end
    local p = inst.Parent
    while p and p ~= Workspace do
        local pn = p.Name
        if pn == "NPCs" or pn == "Enemies" or pn == "_WorldOrigin" or pn == "Locations" then return false end
        if p:FindFirstChildOfClass("Humanoid") then return false end
        p = p.Parent
    end
    local part = inst:IsA("BasePart") and inst or (inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true))
    if part and part.Size.Magnitude > 40 then return false end
    return true
end

function Utils.FormatTime(sec)

-- The mob that has gone longest without taking damage comes first
function Combat.NeedOrder(a, b)
    local ra, rb = Combat.HP[a.model], Combat.HP[b.model]
    return (ra and ra.dmgAt or 0) < (rb and rb.dmgAt or 0)
end

-- Hit part: normally Head, switches to HumanoidRootPart on mobs that take no damage
function Combat.HitPart(t)
    local head = t.model:FindFirstChild("Head")
    local hrp = t.model:FindFirstChild("HumanoidRootPart")
    if Combat.AltPart[t.model] then return hrp or head or t.root end
    return head or hrp or t.root
end

-- Bulk hit (everything in one packet) + (if singles ~= false) one extra hit per target.
function Combat.NetAttack(targets, singles)
    local net = Combat.FindNet()
    if not net then return false end
    local sorted = {}
    for _, t in ipairs(targets) do table.insert(sorted, t) end
    table.sort(sorted, Combat.NeedOrder)

    local now = os.clock()
    for _, t in ipairs(sorted) do
        local rec = Combat.HP[t.model]
        if rec then
            local ref = rec.dmgAt > 0 and rec.dmgAt or rec.since
            if now - ref > 2.5 and now - (rec.flipAt or 0) > 2.5 and now - Combat.LastDamage < 2 then
                rec.flipAt = now
                Combat.AltPart[t.model] = not Combat.AltPart[t.model]
            end
        end
    end

    local list, first = {}, nil
    for i, t in ipairs(sorted) do
        if i > 25 then break end
        local part = Combat.HitPart(t)
        if part then
            table.insert(list, {t.model, part})
            first = first or part
        end
    end
    if not first then return false end
    pcall(function() net.attack:FireServer(0) end)
    pcall(function() net.hit:FireServer(first, list, {}, hitId()) end)

    if singles ~= false and #sorted > 1 then
        local n = math.min(speedCfg().single, #sorted)
        for i = 1, n do
            local t = sorted[i]
            local part = Combat.HitPart(t)
            if part then
                pcall(function() net.hit:FireServer(part, {{t.model, part}}, {}, hitId()) end)
            end
        end
    end
    return true
end


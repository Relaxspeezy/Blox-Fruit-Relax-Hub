local SAVE_KEYS = {
    "AutoFarm","AutoQuest","QuestWatch","BringMobs","FastAttack","AutoClose","AutoEquip","AutoHaki","AutoRace","AutoStats","AutoBoss","AutoChest","AutoFruit",
    "AutoSea2","AutoSea3","AutoFactory","AutoCakePrince","RaidChip","RaidLimit",
    "InstantTP","HitAll","SignalMonitor","FPSBoost","AutoSave","AutoRejoin","Toasts","HumanizeLevel","FlySpeed","HoverHeight","GatherRadius",
    "AttackSpeed","AttackRange","SafeHP","LevelGoal",
    "WinScale","AttackMode","WeaponType","StatType","FarmTargetMob","SelectedBoss",
    "ESPEnabled","ESPMobs","ESPBoss","ESPFruit","ESPChest","ESPPlayer","ESPUpdateRate","CustomTPs","QuestNPCs",
}

local function isVec(e)
    return type(e) == "table" and type(e.x) == "number" and type(e.y) == "number" and type(e.z) == "number"
end

local OLD_SPEED = {["Hızlı"] = "Fast", ["Ekstra Hızlı"] = "Extra Fast", ["Süper Hızlı"] = "Super Fast"}
local OLD_MODE = {["Hepsi"] = "All", ["Tık"] = "Click"}

function ConfigManager.Apply(data)
    if type(data) ~= "table" then return end
    for _, k in ipairs(SAVE_KEYS) do
        local v = data[k]
        if v ~= nil and type(v) == type(State[k]) then
            if k == "CustomTPs" then
                local clean = {}
                for _, e in ipairs(v) do
                    if isVec(e) and type(e.name) == "string" then
                        table.insert(clean, {name = e.name, x = e.x, y = e.y, z = e.z})
                    end
                end
                State.CustomTPs = clean
            elseif k == "QuestNPCs" then
                local clean = {}
                for name, e in pairs(v) do
                    if type(name) == "string" and isVec(e) then
                        clean[name] = {x = e.x, y = e.y, z = e.z, manual = e.manual == true}
                    end
                end
                State.QuestNPCs = clean
            else
                State[k] = v
            end
        end
    end
    State.AttackSpeed = OLD_SPEED[State.AttackSpeed] or State.AttackSpeed
    State.AttackMode = OLD_MODE[State.AttackMode] or State.AttackMode
    if not table.find(ATTACK_MODES, State.AttackMode) then State.AttackMode = "Net" end
    if not SPEED_CFG[State.AttackSpeed] then State.AttackSpeed = "Fast" end
    State.WinScale = math.clamp(State.WinScale, 60, 100)
    State.LevelGoal = math.clamp(math.floor(State.LevelGoal), 0, 2800)
    State.RaidLimit = math.clamp(math.floor(State.RaidLimit), 0, 50)
    if not table.find(RAID_CHIPS, State.RaidChip) then State.RaidChip = "Flame" end
    if State.AutoFarm then
        State.FarmTargetMob = ""
        State.AutoQuest = true
    end
end

function ConfigManager.Save(quiet)
    if not (writefile and HttpService) then
        if quiet ~= true then Utils.Notify("writefile is not supported", 4, "warn") end
        return
    end
    local t = {}
    for _, k in ipairs(SAVE_KEYS) do t[k] = State[k] end
    local ok, err = pcall(function() writefile(ConfigManager.FileName, HttpService:JSONEncode(t)) end)
    if quiet == true then return end
    if ok then Utils.Notify("Settings saved 💾", 3, "success") else Log("Save error: " .. tostring(err), "WARN") end
end

function ConfigManager.Load()
    if not (readfile and isfile and HttpService) then return end
    local file = ConfigManager.FileName
    if not isfile(file) then
        local found
        for _, old in ipairs({"BloxFruits_Config_v8.json", "BloxFruits_Config_v7.json", "BloxFruits_Config_v6.json", "BloxFruits_Config_v5.json"}) do
            if isfile(old) then found = old; break end
        end
        if not found then return end
        file = found
    end
    local ok, err = pcall(function() ConfigManager.Apply(HttpService:JSONDecode(readfile(file))) end)
    if ok then Utils.Notify("Settings loaded 📂", 3, "success") else Log("Load error: " .. tostring(err), "WARN") end
end

function ConfigManager.Reset()
    for _, k in ipairs({"AutoFarm","AutoHaki","AutoRace","AutoStats","AutoBoss","AutoChest","AutoFruit","AutoSea2","AutoSea3","AutoRaid","AutoFactory","AutoCakePrince","ESPEnabled","InstantTP","FPSBoost"}) do State[k] = false end
    State.AutoQuest, State.BringMobs, State.FastAttack, State.AutoEquip, State.SignalMonitor = true, true, true, true, true
    State.AutoClose, State.AutoSave, State.AutoRejoin, State.Toasts = true, true, true, true
    State.QuestWatch = true
    State.HitAll = true
    State.FlySpeed, State.HoverHeight, State.GatherRadius, State.AttackSpeed = 250, 20, 300, "Fast"
    State.AttackRange, State.SafeHP, State.WinScale, State.LevelGoal = 60, 25, 85, 0
    State.HumanizeLevel, State.ESPUpdateRate, State.WeaponType, State.StatType = 2, 0.5, "Melee", "Melee"
    State.AttackMode = "Net"
    State.FarmTargetMob, State.SelectedBoss = "", ""
    State.RaidChip, State.RaidLimit = "Flame", 0
    FPS.Set(false)
    Utils.Notify("Settings reset 🗑", 3, "warn")
end


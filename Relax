function Quest.HintFor(want)
    local p = Quest.Hints[want.name .. "|" .. want.idx] or Quest.Hints[want.name]
    if not p then return nil end
    local sp = Farm.NearestSpawn(want.mob)
    if sp and Utils.Distance(p, sp) > 1500 then return nil end
    return p
end

function Quest.HasHint(c)
    return Quest.Hints[c.name .. "|" .. c.idx] ~= nil or Quest.Hints[c.name] ~= nil
end

function Quest.SaveKey(c) return c.name .. "|" .. c.idx end
function Quest.SavedKey(c)
    local k = Quest.SaveKey(c)
    if State.QuestNPCs[k] then return k end
    if State.QuestNPCs[c.name] then return c.name end
    return nil
end
function Quest.Saved(c)
    local k = Quest.SavedKey(c)
    return k and State.QuestNPCs[k] or nil
end

-- For regions whose spawns are not loaded yet: guess the mob area from its quest NPC position
Farm.AreaTry = {}
function Farm.AreaHint(mob)
    local cands = Quest.Candidates()
    for _, c in ipairs(cands) do
        if c.mob:lower() == mob:lower() then
            local p = Quest.Hints[c.name .. "|" .. c.idx] or Quest.Hints[c.name]
            if p then return p end
        end
    end
    for _, c in ipairs(cands) do
        if Utils.Has(c.mob, mob) then
            local p = Quest.Hints[c.name .. "|" .. c.idx] or Quest.Hints[c.name]
            if p then return p end
        end
    end
    return nil
end

function Quest.Module()
    if Quest._mod then return Quest._mod end
    if Quest._modFailAt and os.clock() - Quest._modFailAt < 10 then return nil end
    local ok, m = pcall(function() return require(ReplicatedStorage:WaitForChild("Quests", 3)) end)
    if ok and type(m) == "table" then
        Quest._mod = m
        return m
    end
    Quest._modFailAt = os.clock()
    return nil
end

function Quest.PanelTrusted() return os.clock() >= Quest.UnreliableUntil end

-- REAL kills of this quest's mob since the quest started (+ last known panel counter in blind mode)
function Quest.MobKills()
    if not Quest.Current then return 0 end
    return math.max(0, Farm.KillsFor(Quest.Current.mob) - Quest.MobBase)
end

function Quest.Baseline(q)
    Quest.MobBase = Farm.KillsFor(q.mob)
    Quest.KillBase = State.Kills
    Quest.LastCur = 0
    Quest._finSince = nil
    Quest.ProgVal, Quest.ProgAt, Quest.ProgKills = nil, os.clock(), Quest.MobBase
end

-- The panel disappeared in the middle of a quest: keep the last known counter and continue by kill count
function Quest.GoBlind()
    local cur = Quest.Current
    if not cur or Quest.Blind then return end
    Quest.Blind = true
    Quest.MobBase = Farm.KillsFor(cur.mob) - (Quest.LastCur or 0)
    Quest._finSince = nil
    Log("Quest panel hidden at " .. tostring(Quest.LastCur) .. "/" .. cur.count .. ": continuing by kill count (quest NOT retaken)", "WARN")
end

-- Is this GUI object really on screen? (itself and all parents visible)
local function guiShown(g)
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local cur = g
    while cur and cur ~= pg and cur ~= game do
        if cur:IsA("GuiObject") and cur.Visible == false then return false end
        if cur:IsA("LayerCollector") and cur.Enabled == false then return false end
        cur = cur.Parent
    end
    return true
end


Combat.RaceStatus = "Off"
function Combat.AutoRaceLoop()
    task.spawn(function()
        local lastT, lastY = 0, 0
        while State.Running do
            task.wait(1)
            pcall(function()
                if not State.AutoRace then Combat.RaceStatus = "Off"; return end
                if Paused() then return end
                local char = Utils.GetCharacter()
                local hum = Utils.GetHumanoid()
                if not char or not hum or hum.Health <= 0 then return end
                -- always on while the toggle is on (not only in fights)
                local now = os.clock()
                local energy = char:FindFirstChild("RaceEnergy")
                local tr = char:FindFirstChild("RaceTransformed")
                local transformed = tr ~= nil and tr.Value == true

                -- V4: transform when the energy bar is full
                if energy and not transformed and energy.Value >= 0.99 and now - lastY > 6 then
                    lastY = now
                    Combat.RaceStatus = "V4: transforming (Y)"
                    Log("Auto Race: V4 energy full -> Y")
                    pressKey(Enum.KeyCode.Y)
                    return
                end

                -- V3: race ability (T), comes back every 30 s
                if now - lastT >= 30 then
                    lastT = now
                    local ce = Combat.CommE()
                    local sent = false
                    if ce then
                        sent = pcall(function() ce:FireServer("ActivateAbility") end)
                    end
                    if not sent then pressKey(Enum.KeyCode.T) end
                    Combat.RaceStatus = transformed and "V4 active" or "V3 ability (T) sent"
                end
            end)
        end
    end)
end


    refresh(false)
    local hit = mk("TextButton", {BackgroundTransparency = 1, Text = "", Size = UDim2.new(1, 0, 1, 0)}, f)
    hit.MouseButton1Click:Connect(function() set(not get()); refresh(true) end)
    table.insert(UI.Refreshers, function() refresh(false) end)

function UI.Update()
    if not UI.Main then return end
    if UI.TopStatus then UI.TopStatus.Text = State.Status end

    local runCol
    if Paused() or State.RateLimit then runCol = T.Warn
    elseif State.AutoFarm or State.AutoBoss or State.AutoChest or State.AutoFruit or State.AutoRaid or State.AutoFactory then runCol = T.Success
    else runCol = T.TextDim end
    if UI.Dot then UI.Dot.BackgroundColor3 = runCol end
    if UI.FabStroke then UI.FabStroke.Color = runCol end
    if UI.SubLbl then UI.SubLbl.Text = "v" .. VERSION .. " · Sea " .. State.Sea end

    UI.ClampMain()
    if not UI.Main.Visible or UI.Minimized then return end

    if UI.StatusLbl then
        UI.StatusLbl.Text = string.format("FPS %d   |   Ping %dms   |   Sea %d   |   %s%s",
            State.FPS, State.Ping, State.Sea, Utils.FormatTime(os.clock() - State.StartTime),
            State.RateLimit and "   ⚠ RATE" or "")
    end

    local tab = UI.CurrentTab
    if tab == "Home" then
        local el = os.clock() - State.StartTime
        if UI.HeroBtn then
            UI.HeroBtn.Text = State.AutoFarm and "■  STOP AUTO FARM" or "▶  START AUTO FARM"
            UI.HeroBtn.BackgroundColor3 = State.AutoFarm and T.Danger or T.Success
        end
        local lvl = Farm.Level()
        if UI.Tiles.Level then UI.Tiles.Level.Text = tostring(lvl) end
        if UI.Tiles.LvGain then UI.Tiles.LvGain.Text = "+" .. tostring(math.max(0, lvl - (State.StartLevel or lvl))) end
        if UI.Tiles.Kills then UI.Tiles.Kills.Text = tostring(State.Kills) end
        if UI.Tiles.Rate then UI.Tiles.Rate.Text = tostring(el > 30 and math.floor(State.Kills / el * 3600) or 0) end
        if UI.Tiles.Quests then UI.Tiles.Quests.Text = tostring(State.QuestsDone) end
        if UI.Tiles.Time then UI.Tiles.Time.Text = Utils.FormatTime(el) end
        local ok, b = pcall(function() return LocalPlayer.Data.Beli.Value end)
        local gain = (ok and type(b) == "number" and State.StartBeli) and (b - State.StartBeli) or 0
        if UI.Tiles.Beli then UI.Tiles.Beli.Text = (gain < 0 and "-" or "+") .. Utils.Num(gain) end
        if UI.Tiles.BeliHr then
            local hr = el > 30 and (gain / el * 3600) or 0
            UI.Tiles.BeliHr.Text = (hr < 0 and "-" or "+") .. Utils.Num(hr)
        end

        local function kv(k, v, color)
            return string.format('<font color="#8b8fa8">%s</font>  <font color="%s">%s</font>', k, color or "#e6e8f5", esc(v))
        end
        if UI.StatusRich then
            UI.StatusRich.Text = table.concat({
                kv("Status    ", State.Status, "#f59e0b"),
                kv("Target    ", State.TargetMob),
                kv("Attack    ", Combat.Mode(), Combat.IsClose() and "#f59e0b" or "#22c55e"),
                kv("Quest     ", State.QuestText),
                kv("Weapon   ", State.WeaponType .. (State.LevelGoal > 0 and ("   ·   Goal level " .. State.LevelGoal) or "")),
            }, "\n")
        end
        if UI.QuestBarFill and UI.QuestBarLbl then
            local cur, max = Quest.Progress()
            if cur and max and max > 0 then
                UI.QuestBarFill.Size = UDim2.new(math.clamp(cur / max, 0, 1), 0, 1, 0)
                UI.QuestProg.Text = cur .. "/" .. max
            else
                UI.QuestBarFill.Size = UDim2.new(0, 0, 1, 0)
                UI.QuestProg.Text = "-"
            end
            UI.QuestBarLbl.Text = State.QuestText
            if UI.QuestSub then
                local sub = "Quests completed: " .. State.QuestsDone
                if Quest.Blind then sub = sub .. "   ·   kill-count mode" end
                if not Quest.PanelTrusted() then sub = sub .. "   ·   panel unreliable" end
                if Quest.FailUntil > os.clock() then sub = sub .. "   ·   retry in " .. math.ceil(Quest.FailUntil - os.clock()) .. " s" end
                UI.QuestSub.Text = sub
            end
        end
    elseif tab == "Farm" then
        pcall(CakeP.UpdateUI)
        if UI.FactoryStatus then
            UI.FactoryStatus.Text = "Race: " .. tostring(Combat.RaceStatus) .. "\nFactory: " .. Factory.Describe() .. (Factory.Done > 0 and ("  ·  Core kills: " .. Factory.Done) or "")
        end
    elseif tab == "Combat" then
        if UI.CombatInfo then
            UI.CombatInfo.Text = string.format("Active: %s  |  Net: %s  |  CF: %s%s",
                Combat.Mode(), Combat.FindNet() and "yes" or "no", Combat.Framework() and "yes" or "no",
                Combat.Testing and "  |  TEST RUNNING..." or "")
        end
    elseif tab == "World" then
        if UI.SeaInfo then
            UI.SeaInfo.Text = "Current: Sea " .. State.Sea .. "  ·  Level " .. Farm.Level()
        end
    elseif tab == "Sea" then
        if UI.SeaTabInfo then
            UI.SeaTabInfo.Text = "You are in Sea " .. State.Sea .. "  ·  Level " .. Farm.Level()
                .. "\nDetected via: " .. tostring(State.SeaSource)
        end
        if UI.SeaTabStatus then UI.SeaTabStatus.Text = "Status: " .. tostring(State.SeaStatus) end
    elseif tab == "Raid" then
        if UI.RaidSeaInfo then
            if State.Sea == 1 then
                UI.RaidSeaInfo.Text = "⚠ No raids in Sea 1 yet! Raids exist only in Sea 2 (Hot and Cold) and Sea 3 (Castle on the Sea). Travel there first (Sea tab)."
                UI.RaidSeaInfo.TextColor3 = T.Warn
            else
                UI.RaidSeaInfo.Text = "Sea " .. State.Sea .. ": raid lab = " .. RAID_SPOTS[State.Sea].name .. "  ·  Level " .. Farm.Level()
                    .. (Farm.Level() < RAID_MIN_LEVEL and ("  (chips need " .. RAID_MIN_LEVEL .. "+)") or "")
                UI.RaidSeaInfo.TextColor3 = T.TextDim
            end
        end
        if UI.RaidStatus then
            UI.RaidStatus.Text = "Status: " .. Raid.Describe() .. "\nRaids done: " .. Raid.Run .. " this run  ·  " .. Raid.Done
                .. " total  ·  chip in bag: " .. (Raid.ChipTool() and "yes" or "no")
        end
    elseif tab == "Shop" then
        if UI.ShopSea ~= State.Sea and UI.BuildShop then pcall(UI.BuildShop) end
        local beli = Utils.Beli()
        local frag, bones = Shop.Funds("Fragments"), Shop.Funds("Bones")
        if UI.ShopBeli then
            UI.ShopBeli.Text = "Beli: $" .. Utils.Num(beli) .. (frag and ("  ·  Fragments: " .. Utils.Num(frag)) or "")
                .. (bones and ("  ·  Bones: " .. Utils.Num(bones)) or "") .. "   ·   Sea " .. State.Sea
        end
        for _, r in ipairs(UI.ShopRows or {}) do
            local have = Shop.Funds(r.item.cur)
            r.price.TextColor3 = (have == nil or have >= r.item.price) and T.Success or T.Danger
        end
    elseif tab == "System" then
        if UI.LogScroll and lastLogCount ~= #State.Logs then
            lastLogCount = #State.Logs
            for _, c in ipairs(UI.LogScroll:GetChildren()) do
                if c:IsA("TextLabel") then c:Destroy() end
            end
            for i = 1, math.min(#State.Logs, 40) do
                local e = State.Logs[i]
                mk("TextLabel", {Size = UDim2.new(1, -8, 0, 15), BackgroundTransparency = 1, Text = e.msg,
                    TextColor3 = e.level == "WARN" and T.Warn or T.TextDim, Font = Enum.Font.Gotham, TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = i}, UI.LogScroll)
            end
        end
    end
end

function UI.UpdateLoop()
    task.spawn(function()
        local tick = 0
        while State.Running do
            pcall(UI.Update)
            tick = tick + 1
            if tick % 40 == 0 and UI.CurrentTab == "Boss" and UI.RefreshBossList then pcall(UI.RefreshBossList) end
            task.wait(0.25)
        end
    end)
end

-- ============================================================
-- SEA DETECTION (live): re-checks the sea and updates everything that depends on it
-- ============================================================
function UI.RefreshSea(manual)
    local ok, s, src = pcall(detectSea)
    if not ok or not s then return end
    State.SeaSource = src or State.SeaSource
    if s ~= State.Sea then
        local old = State.Sea
        State.Sea = s
        Quest._cands = nil
        Quest.Reset()
        Farm.InvalidateSpawns()
        Log("Sea changed: " .. old .. " -> " .. s .. " (via " .. tostring(src) .. ")")
        Utils.Notify("Sea detected: Sea " .. s, 4, "success")
        if UI.RefreshAll then pcall(UI.RefreshAll) end
    elseif manual then
        Utils.Notify("Sea " .. s .. " (via " .. tostring(src) .. ")", 3, "info")
    end
end

-- ============================================================
-- TRACKERS / CHARACTER / CLEANUP
-- ============================================================
local function startTrackers()
    local frames, lastT = 0, os.clock()
    table.insert(State.Connections, RunService.RenderStepped:Connect(function()
        frames = frames + 1
        local now = os.clock()
        if now - lastT >= 1 then State.FPS = frames; frames = 0; lastT = now end
    end))
    task.spawn(function()
        while State.Running do
            pcall(function() State.Ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
            task.wait(2)
        end
    end)
    -- Sea watcher: first checks come early (the world is still loading), then every 5 s
    task.spawn(function()
        task.wait(2)
        pcall(UI.RefreshSea)
        task.wait(4)
        while State.Running do
            pcall(UI.RefreshSea)
            task.wait(5)
        end
    end)
    task.spawn(function()
        while State.Running do
            task.wait(45)
            if State.AutoSave then pcall(ConfigManager.Save, true) end
        end
    end)
    -- Stall guard: farm is on but there have been no kills for a long time.
    -- 150 s: reset movement / combat state only (the quest is NOT touched).
    -- 450 s: also reset the quest state.
    task.spawn(function()
        local lastKills, lastT = State.Kills, os.clock()
        local softDone = false
        while State.Running do
            task.wait(10)
            if State.Kills ~= lastKills or not State.AutoFarm or Paused() then
                lastKills, lastT = State.Kills, os.clock()
                softDone = false
            else
                local idle = os.clock() - lastT
                if idle > 150 and not softDone then
                    softDone = true
                    Log("No kills for 150 s: resetting movement state (quest kept)", "WARN")
                    Farm.SpawnWaitSince = nil
                    Farm.GatherBrokenUntil = os.clock() + 90
                    Combat.CloseUntil = os.clock() + 120
                    State.HoldCF, State.GatherPoint, State.Traveling, State.InCombat = nil, nil, false, false
                elseif idle > 450 then
                    lastT = os.clock()
                    softDone = false
                    Log("No kills for 450 s: resetting quest state (stall guard)", "WARN")
                    Quest.Reset()
                end
            end
        end
    end)
end

local function onCharAdded(char)
    Quest.CharAt = os.clock()
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then
        table.insert(State.Connections, hum.Died:Connect(function()
            Log("Character died - short pause")
            State.HoldCF, State.GatherPoint, State.Traveling, State.InCombat = nil, nil, false, false
            Pause(Utils.RandomDelay(5, 1))
        end))
    end
end

local function Cleanup()
    State.Running = false
    Raid.Active = false
    Factory.Active = false
    CakeP.Active = false
    State.HoldCF, State.GatherPoint, State.Traveling, State.InCombat = nil, nil, false, false
    for _, c in ipairs(State.Connections) do pcall(function() c:Disconnect() end) end
    State.Connections = {}
    pcall(function()
        local root = Utils.GetRootPart()
        if root then Flight.Lock(root, false) end
    end)
    ESP.ClearAll()
    pcall(FPS.Set, false)
    Utils._NotifyFn = nil
    for _, p in ipairs({CoreGui, LocalPlayer:FindFirstChild("PlayerGui")}) do
        for _, n in ipairs({"RelaxHub_GUI", "BFPRO_GUI"}) do
            local g = p and p:FindFirstChild(n)
            if g then pcall(function() g:Destroy() end) end
        end
    end
    if getgenv then getgenv().RelaxHubCleanup = nil end
end
if getgenv then getgenv().RelaxHubCleanup = Cleanup end

-- ============================================================
-- INIT
-- ============================================================
local function Init()
    local s0, src0 = detectSea()
    State.Sea, State.SeaSource = s0, src0
    State.StartTime = os.clock()
    State.StartLevel = Farm.Level()
    pcall(function() State.StartBeli = LocalPlayer.Data.Beli.Value end)
    Log(HUB .. " v" .. VERSION .. " — Sea " .. State.Sea .. " (via " .. tostring(State.SeaSource) .. ")")

    Registry.Init()
    Flight.Init()
    Farm.GatherInit()
    pcall(ConfigManager.Load)
    if State.FPSBoost then FPS.Set(true) end

    UI.Build()
    UI.UpdateLoop()
    AntiCheat.Init()

    if LocalPlayer.Character then task.spawn(onCharAdded, LocalPlayer.Character) end
    table.insert(State.Connections, LocalPlayer.CharacterAdded:Connect(onCharAdded))

    Farm.Loop()
    Farm.BossLoop()
    Combat.Loop()
    Combat.AutoHakiLoop()
    Combat.AutoRaceLoop()
    AutoStat.Loop()
    FruitSniper.Loop()
    ChestFarm.Loop()
    ServerHop.AutoHopLoop()
    ESP.Loop()
    Quest.WatchLoop()
    AutoSea.Loop()
    Raid.Loop()
    Factory.Loop()
    CakeP.Loop()
    startTrackers()

    if UI.RefreshAll then pcall(UI.RefreshAll) end
    Utils.Notify(HUB .. " v" .. VERSION .. " loaded · Sea " .. State.Sea, 5, "success")
    Log("Run System > Diagnostics first, then Combat > Attack Test")
end

local okInit, errInit = pcall(Init)
if not okInit then warn("[RelaxHub] Init error: " .. tostring(errInit)) end

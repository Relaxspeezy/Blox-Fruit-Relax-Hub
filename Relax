local ESP = {Objects = {}}

local function createBillboard(adornee, text, color)
    local bb = Instance.new("BillboardGui")
    bb.AlwaysOnTop = true
    bb.Size = UDim2.new(0, 140, 0, 24)
    bb.StudsOffset = Vector3.new(0, 2.5, 0)
    bb.Adornee = adornee
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.Text = text
    lbl.TextColor3 = color
    lbl.TextStrokeTransparency = 0
    lbl.TextSize = 13
    lbl.Font = Enum.Font.GothamBold
    lbl.Parent = bb
    bb.Parent = Utils.GuiParent()
    return bb, lbl
end

local function espSet(key, adornee, text, color)
    local d = ESP.Objects[key]
    if d and d.gui.Parent then d.lbl.Text = text
    else
        local bb, lbl = createBillboard(adornee, text, color)
        ESP.Objects[key] = {gui = bb, lbl = lbl}
    end
end

function ESP.ClearAll()
    for _, d in pairs(ESP.Objects) do pcall(function() d.gui:Destroy() end) end
    ESP.Objects = {}
end

function ESP.Update()
    if not State.ESPEnabled then
        if next(ESP.Objects) then ESP.ClearAll() end
        return
    end
    local seen = {}
    local myChar = LocalPlayer.Character
    local my = Utils.GetPos()
    local bosses = seaBosses()
    for model, hum in pairs(Registry.Mobs) do
        if model.Parent and hum.Parent and hum.Health > 0 and model ~= myChar then
            local plr = Players:GetPlayerFromCharacter(model)
            local isBoss = false
            if not plr then
                for _, bn in ipairs(bosses) do
                    if Utils.Has(model.Name, bn) then isBoss = true; break end
                end
            end
            local show, color
            if plr then show, color = State.ESPPlayer, Color3.fromRGB(50, 100, 255)
            elseif isBoss then show, color = State.ESPBoss, Color3.fromRGB(255, 50, 50)
            else show, color = State.ESPMobs, Color3.fromRGB(255, 255, 80) end
            if show and (plr or Farm.IsFarmable(model)) then
                local root = Utils.ModelRoot(model)
                if root then
                    seen[model] = true
                    espSet(model, root, string.format("%s [%d] %dm", model.Name, math.floor(hum.Health),
                        math.floor(Utils.Distance(my, root.Position))), color)
                end
            end
        end
    end
    if State.ESPFruit then
        for _, f in ipairs(FruitSniper.Scan()) do
            seen[f.obj] = true
            espSet(f.obj, f.part, "🍎 " .. f.name .. " " .. math.floor(f.dist) .. "m", Color3.fromRGB(255, 165, 0))
        end
    end
    if State.ESPChest then
        for model in pairs(Registry.Chests) do
            if model.Parent then
                local part = model:IsA("BasePart") and model
                    or model.PrimaryPart
                    or model:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    seen[model] = true
                    espSet(model, part, "📦 " .. model.Name .. " " .. math.floor(Utils.Distance(my, part.Position)) .. "m",
                        Color3.fromRGB(80, 220, 80))
                end
            end
        end
    end
    for key, d in pairs(ESP.Objects) do
        if not seen[key] then
            pcall(function() d.gui:Destroy() end)
            ESP.Objects[key] = nil
        end
    end
end

function ESP.Loop()
    task.spawn(function()
        while State.Running do
            pcall(ESP.Update)
            task.wait(State.ESPUpdateRate)
        end
    end)
end


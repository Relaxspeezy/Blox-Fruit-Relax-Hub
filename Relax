local function Paused() return os.clock() < State.PausedUntil end
local function Pause(sec) State.PausedUntil = math.max(State.PausedUntil, os.clock() + sec) end

local function Log(msg, level)
    level = level or "INFO"
    table.insert(State.Logs, 1, {msg = string.format("[%s] %s", level, msg), level = level})
    if #State.Logs > 80 then table.remove(State.Logs, 81) end
end

